      "Linguistic": 4.5,
      "Logical": 3.0,
      "Visual": 2.0,
      "Interpersonal": 1.0,
    },
    recommendedCareers: [],
  },
  {
    id: "2",
    userId: "user1",
    completedAt: new Date("2023-01-02"),
    responses: [],
    scores: {
      "Linguistic": 3.5,
      "Logical": 4.0,
      "Visual": 4.5,
      "Interpersonal": 2.0,
    },
    recommendedCareers: [],
  },
  {
    id: "3",
    userId: "user1",
    completedAt: new Date("2023-01-03"),
    responses: [],
    scores: {
      "Linguistic": 5.0,
      "Logical": 2.0,
      "Visual": 3.0,
      "Interpersonal": 4.5,
    },
    recommendedCareers: [],
  }
];

describe("calculateTopStrengths", () => {
  test("returns empty array for empty input", () => {
    expect(calculateTopStrengths([], "latest")).toEqual([]);
  });

  test("calculates strengths for 'latest' mode", () => {
    const result = calculateTopStrengths(mockAssessments, "latest");
    expect(result).toHaveLength(3);
    expect(result[0]).toEqual({ category: "Linguistic", score: 5.0 });
    expect(result[1]).toEqual({ category: "Interpersonal", score: 4.5 });
    expect(result[2]).toEqual({ category: "Visual", score: 3.0 });
  });

  test("calculates strengths for 'trend' mode (last 5)", () => {
    const result = calculateTopStrengths(mockAssessments, "trend");
    expect(result).toHaveLength(3);
    expect(result[0].category).toBe("Linguistic");
    expect(result[0].score).toBeCloseTo(4.3333, 3);
    expect(result[1].category).toBe("Visual");
    expect(result[1].score).toBeCloseTo(3.1667, 3);
    expect(result[2].category).toBe("Logical");
    expect(result[2].score).toBe(3.0);
  });

  test("calculates strengths for 'overall' mode", () => {
    const result = calculateTopStrengths(mockAssessments, "overall");
    expect(result).toHaveLength(3);
    expect(result[0].category).toBe("Linguistic");
  });

  test("sorts assessments chronologically before processing", () => {
    const outOfOrder = [mockAssessments[1], mockAssessments[2], mockAssessments[0]];
    const result = calculateTopStrengths(outOfOrder, "latest");
    expect(result[0]).toEqual({ category: "Linguistic", score: 5.0 });
  });

  test("handles non-numeric score values", () => {
    const assessmentsWithStrings: Assessment[] = [
      {
        ...mockAssessments[0],
        scores: {
          "Linguistic": "4.0",
          "Logical": "invalid",
          "Visual": 3.0
        } as any
      }
    ];
    const result = calculateTopStrengths(assessmentsWithStrings, "latest");
    expect(result).toHaveLength(2);
    expect(result[0]).toEqual({ category: "Linguistic", score: 4.0 });
    expect(result[1]).toEqual({ category: "Visual", score: 3.0 });
  });

  test("returns only top 3 strengths even if more categories exist", () => {
    const manyCategories: Assessment[] = [
      {
        ...mockAssessments[0],
        scores: {
          "A": 5, "B": 4, "C": 3, "D": 2, "E": 1
        }
      }
    ];
    const result = calculateTopStrengths(manyCategories, "latest");
    expect(result).toHaveLength(3);
    expect(result.map(r => r.category)).toEqual(["A", "B", "C"]);
  });

  test("trend mode uses only the last 5 assessments", () => {
    const manyAssessments: Assessment[] = Array.from({ length: 10 }, (_, i) => ({
      id: `${i}`,
      userId: "user1",
      completedAt: new Date(`2023-01-${i + 1 < 10 ? '0' + (i + 1) : i + 1}`),
      responses: [],
      scores: {
        "Category": i < 5 ? 1 : 5 // First 5 have score 1, last 5 have score 5
      },
      recommendedCareers: [],
    }));

    const result = calculateTopStrengths(manyAssessments, "trend");
    expect(result[0].score).toBe(5);

    const overallResult = calculateTopStrengths(manyAssessments, "overall");
    expect(overallResult[0].score).toBe(3);
  });
});
