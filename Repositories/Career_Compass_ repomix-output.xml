import { expect, test, describe } from "bun:test";
import { calculateTopStrengths } from "./analytics";
import { Assessment } from "../types";

const mockAssessments: Assessment[] = [
  {
    id: "1",
    userId: "user1",
    completedAt: new Date("2023-01-01"),
    responses: [],
