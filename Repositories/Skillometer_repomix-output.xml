<file path="src/pages/Dashboard.tsx">
import { useState, useEffect, useMemo } from 'react';
import { useNavigate } from 'react-router-dom';
import { AppLayout } from '@/components/AppLayout';
import { Badge } from '@/components/ui/badge';
import { Progress } from '@/components/ui/progress';
import { Button } from '@/components/ui/button';
import { fetchAssessmentHistory } from '@/lib/supabase-stubs';
import type { MockAssessmentResult } from '@/lib/supabase-stubs';
import { useAuth } from '@/contexts/AuthContext';
import { ArrowRight, BarChart3, Clock, Trophy } from 'lucide-react';
import {
  RadarChart, Radar, PolarGrid, PolarAngleAxis, PolarRadiusAxis, ResponsiveContainer, Tooltip,
  LineChart, Line, XAxis, YAxis, CartesianGrid, Legend,
} from 'recharts';

const DOMAIN_LABELS: Record<string, string> = {
  decision_making: 'Decision Making',
  behavioral_style: 'Behavioral Style',
  communication: 'Communication',
  emotional_intelligence: 'Emotional Intelligence',
  professional_readiness: 'Professional Readiness',
  learning_agility: 'Learning Agility',
};

const DOMAIN_COLORS: Record<string, string> = {
  decision_making: 'hsl(var(--primary))',
  behavioral_style: '#10b981',
  communication: '#f59e0b',
  emotional_intelligence: '#ef4444',
  professional_readiness: '#8b5cf6',
  learning_agility: '#06b6d4',
};

function formatDomainLabel(key: string) {
  return DOMAIN_LABELS[key] || key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

const Dashboard = () => {
  const [history, setHistory] = useState<MockAssessmentResult[]>([]);
  const { user } = useAuth();
  const navigate = useNavigate();

  useEffect(() => {
    if (user) fetchAssessmentHistory(user.id).then(setHistory);
  }, [user]);

  const latest = history[0] || null;

  // Timeline data for line chart
  const timelineData = useMemo(() => {
    if (history.length < 2) return [];
    return [...history].reverse().map((h, i) => {
      const point: Record<string, string | number> = {
        name: new Date(h.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
      };
      for (const [domain, score] of Object.entries(h.domain_scores)) {
        point[domain] = Math.round((score as number) * 100);
      }
      return point;
    });
  }, [history]);

  if (!latest) {
    return (
      <AppLayout>
        <div className="max-w-3xl mx-auto text-center py-20 space-y-6">
          <h1 className="text-3xl font-semibold tracking-tight">Welcome to Skillometer</h1>
          <p className="text-lg text-muted-foreground max-w-xl mx-auto">
            You haven't completed any assessments yet. Discover your professional DNA by taking your first assessment.
          </p>
          <Button size="lg" onClick={() => navigate('/assessment')} className="mt-4">
            Take Assessment
          </Button>
        </div>
      </AppLayout>
    );
  }

  const topRole = Object.entries(latest.role_scores).sort(([, a], [, b]) => (b as number) - (a as number))[0];
  const avgDomain = Object.values(latest.domain_scores).reduce((s, v) => s + (v as number), 0) / Object.keys(latest.domain_scores).length;
  const topTraits = Object.entries(latest.trait_scores).sort(([, a], [, b]) => (b as number) - (a as number)).slice(0, 3);

  const radarData = Object.entries(latest.domain_scores).map(([key, val]) => ({
    domain: formatDomainLabel(key),
    score: Math.round((val as number) * 100),
  }));

  return (
    <AppLayout>
      <div className="max-w-5xl mx-auto space-y-8 pb-12">
        {/* Header */}
        <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div>
            <h1 className="text-2xl font-bold tracking-tight">Welcome back, {user?.name || 'User'}!</h1>
            <p className="text-sm text-muted-foreground mt-1">Here's a snapshot of your latest assessment.</p>
          </div>
          <Button onClick={() => navigate('/assessment')}>Take Assessment Again</Button>
        </div>

        {/* Summary Cards */}
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div className="rounded-none terminal-border border bg-card p-5 space-y-2">
            <div className="flex items-center gap-2 text-muted-foreground">
              <Trophy className="h-4 w-4" />
              <span className="text-xs font-medium uppercase tracking-wider">Top Role Match</span>
            </div>
            <p className="text-xl font-bold">{topRole?.[0]}</p>
            <p className="text-sm text-primary font-semibold">{Math.round((topRole?.[1] as number) * 100)}% fit</p>
          </div>

          <div className="rounded-none terminal-border border bg-card p-5 space-y-2">
            <div className="flex items-center gap-2 text-muted-foreground">
              <BarChart3 className="h-4 w-4" />
              <span className="text-xs font-medium uppercase tracking-wider">Avg Domain Score</span>
            </div>
            <p className="text-xl font-bold">{Math.round(avgDomain * 100)}%</p>
            <Progress value={avgDomain * 100} className="h-2" />
          </div>

          <div className="rounded-none terminal-border border bg-card p-5 space-y-2">
            <div className="flex items-center gap-2 text-muted-foreground">
              <Clock className="h-4 w-4" />
              <span className="text-xs font-medium uppercase tracking-wider">Assessments Taken</span>
            </div>
            <p className="text-xl font-bold">{history.length}</p>
            <p className="text-xs text-muted-foreground">
              Latest: {new Date(latest.date).toLocaleDateString()}
            </p>
          </div>
        </div>

        {/* Radar + Top Traits side by side */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div className="border border-white/20 bg-[#050505] p-6 text-white shadow-[0_0_15px_rgba(255,166,0,0.1)]">
            <div className="flex justify-between items-end border-b border-[#FFA600]/30 pb-4 mb-6">
              <div>
                <div className="text-[#FFA600] text-xs mb-1 tracking-widest">SYSTEM.METRICS</div>
                <h2 className="text-2xl font-black tracking-tighter uppercase">Domain Profile</h2>
              </div>
              <Badge className="bg-white text-black hover:bg-white rounded-none uppercase text-xs">Data Center</Badge>
            </div>

            <div className="h-[300px]">
              <ResponsiveContainer width="100%" height="100%">
                <RadarChart data={radarData}>
                  <PolarGrid stroke="rgba(255,255,255,0.1)" />
                  <PolarAngleAxis dataKey="domain" tick={{ fill: 'rgba(255,255,255,0.7)', fontSize: 10 }} />
                  <PolarRadiusAxis domain={[0, 100]} tick={false} axisLine={false} />
                  <Radar name="Score" dataKey="score" stroke="#FFA600" strokeWidth={2} fill="#FFA600" fillOpacity={0.05} />
                  <Tooltip contentStyle={{ backgroundColor: '#000', borderColor: '#FFA600', color: '#fff', borderRadius: 0 }} />
                </RadarChart>
              </ResponsiveContainer>
            </div>
          </div>

          <div className="space-y-6">
            <div className="rounded-none terminal-border border bg-card p-6">
              <h2 className="text-lg font-semibold mb-4">Core Strengths</h2>
              <div className="flex flex-wrap gap-2">
                {topTraits.map(([trait, score]) => (
                  <Badge key={trait} variant="secondary" className="px-3 py-1.5 text-sm font-medium">
                    {trait.replace(/_/g, ' ')} — {Math.round((score as number) * 100)}%
                  </Badge>
                ))}
              </div>
            </div>

            <div className="rounded-none terminal-border border bg-card p-6">
              <div className="flex justify-between items-center mb-4">
                <h2 className="text-lg font-semibold">Top Career Matches</h2>
              </div>
              <div className="space-y-4">
                {Object.entries(latest.role_scores)
                  .sort(([, a], [, b]) => (b as number) - (a as number))
                  .slice(0, 3)
                  .map(([role, score]) => (
                    <div key={role} className="space-y-1.5">
                      <div className="flex justify-between items-center text-sm">
                        <span className="font-medium">{role}</span>
                        <span className="text-primary font-semibold">{Math.round((score as number) * 100)}%</span>
                      </div>
                      <Progress value={(score as number) * 100} className="h-2" />
                    </div>
                  ))}
              </div>
            </div>
          </div>
        </div>

        {/* Assessment Timeline */}
        {timelineData.length > 0 && (
          <div className="rounded-none terminal-border border bg-card p-6">
            <h2 className="text-lg font-semibold mb-4">Score Trends Over Time</h2>
            <ResponsiveContainer width="100%" height={300}>
              <LineChart data={timelineData}>
                <CartesianGrid strokeDasharray="3 3" stroke="hsl(var(--border))" />
                <XAxis dataKey="name" tick={{ fontSize: 11 }} />
                <YAxis domain={[0, 100]} tick={{ fontSize: 11 }} />
                <Tooltip />
                <Legend />
                {Object.keys(DOMAIN_LABELS).map(domain => (
                  <Line
                    key={domain}
                    type="monotone"
                    dataKey={domain}
                    name={DOMAIN_LABELS[domain]}
                    stroke={DOMAIN_COLORS[domain]}
                    strokeWidth={2}
                    dot={{ r: 4 }}
                  />
                ))}
              </LineChart>
            </ResponsiveContainer>
          </div>
        )}

        {/* View Full Results + History */}
        <div className="flex flex-col sm:flex-row gap-4">
          <Button variant="outline" className="flex-1" onClick={() => navigate(`/results?session=${latest.session_id}`)}>
            View Full Results <ArrowRight className="h-4 w-4 ml-2" />
          </Button>
        </div>

        {/* Assessment History */}
        {history.length > 1 && (
          <div className="rounded-none terminal-border border bg-card p-6">
            <h2 className="text-lg font-semibold mb-4">Assessment History</h2>
            <div className="space-y-3">
              {history.map((h, index) => {
                const hTopRole = Object.entries(h.role_scores).sort(([, a], [, b]) => (b as number) - (a as number))[0];
                return (
                  <div
                    key={h.session_id}
                    className="flex items-center justify-between py-3 px-4 rounded-none terminal-border border bg-background hover:bg-muted/50 transition-colors"
                  >
                    <div>
                      <p className="font-medium text-sm">Assessment #{history.length - index}</p>
                      <p className="text-xs text-muted-foreground mt-1">
                        {new Date(h.date).toLocaleDateString()} · Top: {hTopRole?.[0]} ({Math.round((hTopRole?.[1] as number) * 100)}%)
                      </p>
                    </div>
                    <Button variant="ghost" size="sm" onClick={() => navigate(`/results?session=${h.session_id}`)}>
                      View <ArrowRight className="h-3 w-3 ml-1" />
                    </Button>
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </AppLayout>
  );
};

export default Dashboard;
