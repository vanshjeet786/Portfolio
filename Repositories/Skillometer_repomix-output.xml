import { supabase } from '@/integrations/supabase/client';

export interface DirectMessage {
  id: string;
  org_id: string;
  sender_id: string;
  receiver_id: string;
  content: string;
  read_at: string | null;
  created_at: string;
  sender_profile?: { full_name: string | null; email: string };
  receiver_profile?: { full_name: string | null; email: string };
}

export interface Announcement {
  id: string;
  org_id: string;
  team_id: string | null;
  author_id: string;
  title: string;
  content: string;
  scope: 'org' | 'team';
  created_at: string;
  author_profile?: { full_name: string | null; email: string };
}

export async function sendMessage(orgId: string, receiverId: string, content: string): Promise<boolean> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return false;

  const { error } = await supabase
    .from('direct_messages')
    .insert({ org_id: orgId, sender_id: user.id, receiver_id: receiverId, content });

  if (error) { console.error('[sendMessage]', error); return false; }

  // Notify receiver
  await supabase.from('notifications').insert({
    user_id: receiverId,
    type: 'direct_message',
    title: 'New Message',
    body: content.substring(0, 100),
    actor_id: user.id,
    metadata: { org_id: orgId },
  });

  return true;
}

export async function fetchConversation(orgId: string, otherUserId: string): Promise<DirectMessage[]> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return [];

  const { data, error } = await supabase
    .from('direct_messages')
    .select('*')
    .eq('org_id', orgId)
    .or(`and(sender_id.eq.${user.id},receiver_id.eq.${otherUserId}),and(sender_id.eq.${otherUserId},receiver_id.eq.${user.id})`)
    .order('created_at', { ascending: true });

  if (error) { console.error('[fetchConversation]', error); return []; }
  return data as DirectMessage[];
}

export async function fetchConversationList(orgId: string): Promise<{ userId: string; lastMessage: string; lastAt: string; unread: number; profile?: { full_name: string | null; email: string } }[]> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return [];

  const { data, error } = await supabase
    .from('direct_messages')
    .select('*')
    .eq('org_id', orgId)
    .or(`sender_id.eq.${user.id},receiver_id.eq.${user.id}`)
    .order('created_at', { ascending: false });

  if (error) return [];

  const conversations = new Map<string, { userId: string; lastMessage: string; lastAt: string; unread: number }>();
  for (const msg of data || []) {
    const otherId = msg.sender_id === user.id ? msg.receiver_id : msg.sender_id;
    if (!conversations.has(otherId)) {
      conversations.set(otherId, {
        userId: otherId,
        lastMessage: msg.content,
        lastAt: msg.created_at,
        unread: msg.receiver_id === user.id && !msg.read_at ? 1 : 0,
      });
    } else if (msg.receiver_id === user.id && !msg.read_at) {
      const c = conversations.get(otherId)!;
      c.unread++;
    }
  }

  return Array.from(conversations.values());
}

export async function markMessagesRead(orgId: string, senderId: string): Promise<void> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return;

  await supabase
    .from('direct_messages')
    .update({ read_at: new Date().toISOString() })
    .eq('org_id', orgId)
    .eq('sender_id', senderId)
    .eq('receiver_id', user.id)
    .is('read_at', null);
}

export async function createAnnouncement(orgId: string, title: string, content: string, scope: 'org' | 'team' = 'org', teamId?: string): Promise<boolean> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return false;

  const { error } = await supabase
    .from('announcements')
    .insert({ org_id: orgId, title, content, scope, team_id: teamId || null, author_id: user.id });

  if (error) { console.error('[createAnnouncement]', error); return false; }
  return true;
}

export async function fetchAnnouncements(orgId: string): Promise<Announcement[]> {
  const { data, error } = await supabase
    .from('announcements')
    .select('*')
    .eq('org_id', orgId)
    .order('created_at', { ascending: false });

  if (error) return [];
  return data as Announcement[];
}
