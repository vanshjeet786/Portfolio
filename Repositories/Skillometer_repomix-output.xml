<file path="src/lib/visibility-service.ts">
import { supabase } from '@/integrations/supabase/client';

export type VisibilityMode = 'hide_all' | 'show_selected' | 'show_all';

export interface VisibilitySettings {
  id: string;
  user_id: string;
  org_id: string;
  visibility_mode: VisibilityMode;
}

export async function getVisibilitySettings(orgId: string): Promise<VisibilitySettings | null> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return null;

  const { data } = await supabase
    .from('assessment_visibility_settings')
    .select('*')
    .eq('user_id', user.id)
    .eq('org_id', orgId)
    .maybeSingle();

  return data as VisibilitySettings | null;
}

export async function setVisibilityMode(orgId: string, mode: VisibilityMode): Promise<boolean> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return false;

  const { error } = await supabase
    .from('assessment_visibility_settings')
    .upsert({ user_id: user.id, org_id: orgId, visibility_mode: mode }, { onConflict: 'user_id,org_id' });

  if (error) { console.error('[setVisibilityMode]', error); return false; }
  return true;
}

export async function getVisibleSessions(orgId: string, targetUserId: string): Promise<string[]> {
  const { data } = await supabase
    .from('assessment_visibility_settings')
    .select('visibility_mode')
    .eq('user_id', targetUserId)
    .eq('org_id', orgId)
    .maybeSingle();

  if (!data || data.visibility_mode === 'hide_all') return [];
  if (data.visibility_mode === 'show_all') {
    const { data: sessions } = await supabase
      .from('sessions')
      .select('id')
      .eq('user_id', targetUserId)
      .eq('status', 'completed');
    return (sessions || []).map(s => s.id);
  }

  // show_selected
  const { data: exceptions } = await supabase
    .from('assessment_visibility_exceptions')
    .select('session_id')
    .eq('user_id', targetUserId)
    .eq('org_id', orgId);

  return (exceptions || []).map(e => e.session_id);
}

export async function toggleSessionVisibility(orgId: string, sessionId: string, visible: boolean): Promise<boolean> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return false;

  if (visible) {
    const { error } = await supabase
      .from('assessment_visibility_exceptions')
      .upsert({ user_id: user.id, org_id: orgId, session_id: sessionId }, { onConflict: 'user_id,org_id,session_id' });
    return !error;
  } else {
    const { error } = await supabase
      .from('assessment_visibility_exceptions')
      .delete()
      .eq('user_id', user.id)
      .eq('org_id', orgId)
      .eq('session_id', sessionId);
    return !error;
  }
}
