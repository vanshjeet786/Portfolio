<file path="src/components/NaturalLanguagePhase.tsx">
import { supabase } from '@/integrations/supabase/client';
import { TerminalLoader } from "@/components/TerminalLoader";
import { useState, useEffect } from 'react';
import { Button } from '@/components/ui/button';
import { Textarea } from '@/components/ui/textarea';
import { Progress } from '@/components/ui/progress';
import { toast } from '@/hooks/use-toast';
import { Loader2 } from 'lucide-react';
import type { TraitSignal } from '@/lib/scoring';

const EXTRACT_TRAITS_URL = `${import.meta.env.VITE_SUPABASE_URL}/functions/v1/extract-traits`;
const GENERATE_SCENARIOS_URL = `${import.meta.env.VITE_SUPABASE_URL}/functions/v1/generate-scenarios`;

const STATIC_SCENARIOS = [
  "You are leading a project that is already two weeks behind schedule. Your main supplier just informed you that critical components will be delayed by another week. The client is expecting a progress report tomorrow. How do you handle this situation step-by-step?",
  "A key team member has been consistently underperforming and missing deadlines, affecting the whole team's morale. They recently mentioned dealing with personal issues outside of work. How do you approach them and resolve the performance issue?",
  "You are a college student juggling three major assignments due in the same week, while also preparing for an important internship interview. Unexpectedly, you fall sick and lose two days of work time. How do you prioritize and communicate your situation?",
  "During a group project, two team members have fundamentally different approaches to solving the core problem, leading to frequent arguments and a stalled project. As the unofficial team leader, how do you mediate this conflict and get the team back on track?",
  "You have discovered that a close colleague has been taking credit for your ideas during management meetings. Confronting them directly might harm your working relationship, but staying silent is affecting your career progression. How do you navigate this ethical and professional dilemma?",
  "You are a manager who just received notice that your department's budget is being cut by 20%. You must decide whether to lay off one junior employee or significantly reduce the resources available to everyone, which will delay project timelines. Explain your decision-making process."
];

interface NaturalLanguagePhaseProps {
  sessionId: string;
  onComplete: (extractedSignals: TraitSignal[]) => void;
}

export function NaturalLanguagePhase({ onComplete, sessionId }: NaturalLanguagePhaseProps) {
  const [currentIndex, setCurrentIndex] = useState(0);
  const [answer, setAnswer] = useState('');
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [allSignals, setAllSignals] = useState<TraitSignal[]>([]);

  const [scenarios, setScenarios] = useState<string[]>(() => {
    const array = new Uint32Array(1);
    window.crypto.getRandomValues(array);
    const staticIndex = array[0] % STATIC_SCENARIOS.length;
    return [STATIC_SCENARIOS[staticIndex]];
  });
  const [isLoadingDynamic, setIsLoadingDynamic] = useState(true);

  useEffect(() => {
    // Fetch the 2 dynamic scenarios in the background

    const fetchDynamicScenarios = async () => {
      try {
        const session = (await supabase.auth.getSession()).data.session;
        if (!session?.access_token) {
          toast({ title: "Authentication required", description: "Please log in to continue the assessment.", variant: "destructive" });
          return;
        }

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 30000);

        const resp = await fetch(GENERATE_SCENARIOS_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${session.access_token}`,
          },
          signal: controller.signal,
        });

        if (!resp.ok) throw new Error("Failed to generate dynamic scenarios");
        const data = await resp.json();

        if (data.scenarios && data.scenarios.length === 2) {
          setScenarios(prev => [...prev, ...data.scenarios]);
        } else {
          // Fallback if AI fails to return exactly 2
          setScenarios(prev => {
            const staticIndex = STATIC_SCENARIOS.indexOf(prev[0]) || 0;
            const fallbackIndex1 = (staticIndex + 1) % STATIC_SCENARIOS.length;
            const fallbackIndex2 = (staticIndex + 2) % STATIC_SCENARIOS.length;
            return [...prev, STATIC_SCENARIOS[fallbackIndex1], STATIC_SCENARIOS[fallbackIndex2]];
          });
        }
      } catch (err) {
        console.error("Error fetching dynamic scenarios:", err);
        const description = err instanceof Error && err.name === 'AbortError'
          ? "The request timed out. Using fallback scenarios."
          : "An error occurred while generating scenarios. Using fallbacks.";

        toast({ title: "Scenario generation", description, variant: "destructive" });

        // Fallback to static
        setScenarios(prev => {
          const staticIndex = STATIC_SCENARIOS.indexOf(prev[0]) || 0;
          const fallbackIndex1 = (staticIndex + 1) % STATIC_SCENARIOS.length;
          const fallbackIndex2 = (staticIndex + 2) % STATIC_SCENARIOS.length;
          return [...prev, STATIC_SCENARIOS[fallbackIndex1], STATIC_SCENARIOS[fallbackIndex2]];
        });
      } finally {
        clearTimeout(timeoutId);
        setIsLoadingDynamic(false);
      }
    };


    fetchDynamicScenarios();
  }, []);

  const totalScenarios = 3; // Always 1 static + 2 dynamic (or fallback)
  const currentScenario = scenarios[currentIndex];
  const progressPercent = ((currentIndex) / totalScenarios) * 100;


  const handleSubmit = async () => {
    if (answer.trim().length < 50) {
      toast({ title: "Answer too short", description: "Please provide a more detailed answer (at least 50 characters).", variant: "destructive" });
      return;
    }

    setIsSubmitting(true);
    try {
      const session = (await supabase.auth.getSession()).data.session;
      if (!session?.access_token) {
        toast({ title: "Authentication required", description: "Please log in to continue.", variant: "destructive" });
        setIsSubmitting(false);
        return;
      }

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 30000);

      const resp = await fetch(EXTRACT_TRAITS_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({ scenario: currentScenario, answer, sessionId }),
        signal: controller.signal,
      });

      if (!resp.ok) {
        const errorData = await resp.json().catch(() => ({}));
        throw new Error(errorData.error || "Failed to extract traits");
      }

      const data = await resp.json();

      const newSignals = [...allSignals, ...(data.traits || [])];
      setAllSignals(newSignals);

      if (currentIndex < totalScenarios - 1) {
        setCurrentIndex(prev => prev + 1);
        setAnswer('');
      } else {
        onComplete(newSignals);
      }
    } catch (e) {
      console.error(e);
      const description = e instanceof Error && e.name === 'AbortError'
        ? "The analysis timed out. Please try again."
        : "An error occurred while analyzing your response. Please try again.";

      toast({ title: "Error", description, variant: "destructive" });
    }
    setIsSubmitting(false);
  };


  // If user reaches a question that hasn't loaded yet
  if (!currentScenario && isLoadingDynamic) {
    return (
      <div className="max-w-2xl mx-auto space-y-8 flex flex-col items-center justify-center min-h-[400px]">
        <TerminalLoader />
        <p className="text-muted-foreground animate-pulse">Generating your next customized scenario...</p>
      </div>
    );
  }

  return (
    <div className="max-w-2xl mx-auto space-y-8 animate-in fade-in zoom-in duration-300">
      <div className="space-y-2">
        <div className="flex justify-between text-sm text-muted-foreground">
          <span>Natural Language Scenario - Question {currentIndex + 1} of {totalScenarios}</span>
          <span className="capitalize">Behavioral layer</span>
        </div>
        <Progress value={progressPercent} className="h-1.5" />
      </div>

      <div className="space-y-6">
        <h2 className="text-xl font-medium leading-relaxed">{currentScenario}</h2>
        <p className="text-sm text-muted-foreground">Please write a detailed response (at least 3-4 sentences) explaining your thought process and actions.</p>

        <Textarea
          value={answer}
          onChange={(e) => setAnswer(e.target.value)}
          placeholder="Type your answer here..."
          className="min-h-[200px] resize-y text-base p-4"
          disabled={isSubmitting}
        />
      </div>

      <div className="flex justify-end">
        <Button
          onClick={handleSubmit}
          disabled={isSubmitting || answer.trim().length < 10}
          size="lg"
        >
          {isSubmitting ? 'Analyzing...' : (currentIndex === totalScenarios - 1 ? 'Finish Scenario' : 'Next Scenario')}
        </Button>
      </div>
    </div>
  );
}
