import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';
import { useAuth } from './AuthContext';
import { getUserOrgs, type OrgRole } from '@/lib/authorization';

export interface OrgInfo {
  orgId: string;
  role: OrgRole;
  org: { id: string; name: string; slug: string; logo_url: string | null };
}

interface OrgContextType {
  orgs: OrgInfo[];
  currentOrg: OrgInfo | null;
  setCurrentOrg: (org: OrgInfo | null) => void;
  isLoading: boolean;
  refresh: () => Promise<void>;
}

const OrgContext = createContext<OrgContextType | undefined>(undefined);

export function OrgProvider({ children }: { children: React.ReactNode }) {
  const { user } = useAuth();
  const [orgs, setOrgs] = useState<OrgInfo[]>([]);
  const [currentOrg, setCurrentOrg] = useState<OrgInfo | null>(null);
  const [isLoading, setIsLoading] = useState(false);

  const refresh = useCallback(async () => {
    if (!user || user.id.startsWith('00000000')) {
      setOrgs([]);
      setCurrentOrg(null);
      return;
    }
    setIsLoading(true);
    const result = await getUserOrgs(user.id);
    setOrgs(result);
    // Auto-select first org if none selected
    if (result.length > 0 && !currentOrg) {
      setCurrentOrg(result[0]);
    }
    setIsLoading(false);
  }, [user, currentOrg]);

  useEffect(() => {
    refresh();
  }, [refresh]);

  return (
    <OrgContext.Provider value={{ orgs, currentOrg, setCurrentOrg, isLoading, refresh }}>
      {children}
    </OrgContext.Provider>
  );
}

export function useOrg() {
  const ctx = useContext(OrgContext);
  if (!ctx) throw new Error('useOrg must be used within OrgProvider');
  return ctx;
}
