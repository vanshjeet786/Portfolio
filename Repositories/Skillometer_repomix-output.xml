import JSZip from 'jszip';
import { generateCandidatePdf } from './generatePdf';
import type { MockAssessmentResult, MockCandidate } from '@/lib/supabase-stubs';
import { fetchCandidateResults } from '@/lib/supabase-stubs';

export const generateBatchZip = async (
  candidates: MockCandidate[],
  options: {
    summary: boolean;
    radar: boolean;
    roles: boolean;
    traits: boolean;
  }
) => {
  const zip = new JSZip();

  for (const candidate of candidates) {
    try {
      const result = await fetchCandidateResults(candidate.user_id);
      const pdfBlob = await generateCandidatePdf(candidate, result, options);
      const safeName = candidate.name.replace(/[^a-z0-9]/gi, '_').toLowerCase();
      zip.file(`candidate_${safeName}_${candidate.id}.pdf`, pdfBlob);
    } catch (e) {
      console.error(`Failed to generate PDF for ${candidate.name}`, e);
    }
  }

  const zipBlob = await zip.generateAsync({ type: 'blob' });
  const url = URL.createObjectURL(zipBlob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `candidates_batch_export_${new Date().toISOString().split('T')[0]}.zip`;
  a.click();
  URL.revokeObjectURL(url);
};
</file>

<file path="src/lib/pdf/generatePdf.ts">
import { jsPDF } from 'jspdf';
import type { MockAssessmentResult, MockCandidate } from '@/lib/supabase-stubs';

const DOMAIN_LABELS: Record<string, string> = {
  decision_making: 'Decision Making',
  behavioral_style: 'Behavioral Style',
  communication: 'Communication',
  emotional_intelligence: 'Emotional Intelligence',
  professional_readiness: 'Professional Readiness',
  learning_agility: 'Learning Agility',
};

export const generateCandidatePdf = async (
  candidate: MockCandidate,
  result: MockAssessmentResult,
  options: {
    summary: boolean;
    radar: boolean;
    roles: boolean;
    traits: boolean;
  }
): Promise<Blob> => {

  const doc = new jsPDF();
  doc.setFillColor(0, 0, 0);
  doc.rect(0, 0, 210, 297, 'F'); // A4 size
  doc.setTextColor(255, 255, 255); // White text

  let y = 20;

  doc.setFontSize(20);
  doc.text(`Candidate Report: ${candidate.name}`, 20, y);
  y += 10;

  doc.setFontSize(12);
  doc.text(`Email: ${candidate.email}`, 20, y);
  y += 8;
  doc.text(`Date Taken: ${candidate.date_taken}`, 20, y);
  y += 8;
  doc.text(`Status: ${candidate.status}`, 20, y);
  y += 15;

  if (options.summary) {
    doc.setFontSize(16);
    doc.text('Summary', 20, y);
    y += 10;

    doc.setFontSize(12);
    doc.text(`Top Role Fit: ${candidate.top_role}`, 20, y);
    y += 8;
    doc.text(`Top Role Score: ${Math.round(candidate.top_role_score * 100)}%`, 20, y);
    y += 8;
    doc.text(`Average Domain Score: ${Math.round(candidate.average_score * 100)}%`, 20, y);
    y += 15;
  }

  if (options.roles) {
    if (y > 250) { doc.addPage();
    doc.setFillColor(0, 0, 0);
    doc.rect(0, 0, 210, 297, 'F');
    doc.setTextColor(255, 255, 255); y = 20; }
    doc.setFontSize(16);
    doc.text('Role Matches', 20, y);
    y += 10;

    doc.setFontSize(12);
    const sortedRoles = Object.entries(result.role_scores).sort(([, a], [, b]) => b - a).slice(0, 5);
    for (const [role, score] of sortedRoles) {
      if (y > 280) { doc.addPage();
    doc.setFillColor(0, 0, 0);
    doc.rect(0, 0, 210, 297, 'F');
    doc.setTextColor(255, 255, 255); y = 20; }
      doc.text(`${role}: ${Math.round(score * 100)}%`, 20, y);
      y += 8;
    }
    y += 7;
  }

  if (options.traits) {
    if (y > 250) { doc.addPage();
    doc.setFillColor(0, 0, 0);
    doc.rect(0, 0, 210, 297, 'F');
    doc.setTextColor(255, 255, 255); y = 20; }
    doc.setFontSize(16);
    doc.text('Trait Scores', 20, y);
    y += 10;

    doc.setFontSize(12);
    const sortedTraits = Object.entries(result.trait_scores).sort(([, a], [, b]) => b - a);
    for (const [trait, score] of sortedTraits) {
       if (y > 280) { doc.addPage();
    doc.setFillColor(0, 0, 0);
    doc.rect(0, 0, 210, 297, 'F');
    doc.setTextColor(255, 255, 255); y = 20; }
       doc.text(`${trait.replace(/_/g, ' ')}: ${Math.round(score * 100)}%`, 20, y);
       y += 8;
    }
  }

  // Adding radar chart to PDF requires converting chart to image using html2canvas
  // which might be tricky in pure utility. We can leave a placeholder or just
  // list domain scores textually.
  if (options.radar) {
    if (y > 250) { doc.addPage();
    doc.setFillColor(0, 0, 0);
    doc.rect(0, 0, 210, 297, 'F');
    doc.setTextColor(255, 255, 255); y = 20; }
    doc.setFontSize(16);
    doc.text('Domain Scores', 20, y);
    y += 10;
    doc.setFontSize(12);
    for (const [key, val] of Object.entries(result.domain_scores)) {
        if (y > 280) { doc.addPage();
    doc.setFillColor(0, 0, 0);
    doc.rect(0, 0, 210, 297, 'F');
    doc.setTextColor(255, 255, 255); y = 20; }
        doc.text(`${DOMAIN_LABELS[key] || key}: ${Math.round(val * 100)}%`, 20, y);
        y += 8;
    }
  }

  return doc.output('blob');
};
</file>

