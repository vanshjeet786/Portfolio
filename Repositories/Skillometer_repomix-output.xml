  if (!user) return false;

  const { error } = await supabase
    .from('endorsements')
    .insert({ endorser_id: user.id, endorsee_id: endorseeId, org_id: orgId, trait, comment: comment || null });

  if (error) { console.error('[createEndorsement]', error); return false; }

  // Notify endorsee
  await supabase.from('notifications').insert({
    user_id: endorseeId,
    type: 'endorsement',
    title: 'New Endorsement',
    body: `Someone endorsed your "${trait}" trait`,
    actor_id: user.id,
    metadata: { trait, org_id: orgId },
  });

  return true;
}

export async function fetchEndorsements(endorseeId: string, orgId: string): Promise<Endorsement[]> {
  const { data, error } = await supabase
    .from('endorsements')
    .select('*, profiles!endorsements_endorser_id_fkey(full_name, email)')
    .eq('endorsee_id', endorseeId)
    .eq('org_id', orgId)
    .order('created_at', { ascending: false });

  if (error) {
    // Fallback without join if FK name doesn't match
    const { data: fallback } = await supabase
      .from('endorsements')
      .select('*')
      .eq('endorsee_id', endorseeId)
      .eq('org_id', orgId)
      .order('created_at', { ascending: false });
    return (fallback || []) as Endorsement[];
  }

  return (data || []).map((e: unknown) => ({
    ...e,
    endorser_profile: e.profiles,
  }));
}

export async function deleteEndorsement(endorsementId: string): Promise<boolean> {
  const { error } = await supabase
    .from('endorsements')
    .delete()
    .eq('id', endorsementId);
  return !error;
}
