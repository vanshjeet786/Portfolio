import { withCache, invalidateCache } from './cache';
// Assessment data layer — uses Supabase sessions & responses tables
import { supabase } from '@/integrations/supabase/client';

export interface MockCandidate {
  id: string;
  user_id: string;
  name: string;
  email: string;
  date_taken: string;
  status: 'in_progress' | 'completed';
  top_role: string;
  top_role_score: number;
  average_score: number;
}

export interface MockAssessmentResult {
  session_id: string;
  date: string;
  trait_scores: Record<string, number>;
  domain_scores: Record<string, number>;
  role_scores: Record<string, number>;
  time_per_question: Record<string, number>;
}

export interface PlatformUser {
  id: string;
  email: string;
  full_name: string | null;
  role: 'candidate' | 'hr_admin' | 'super_admin' | 'dev_admin';
}

export async function saveResponseToSupabase(
  session_id: string, question_id: string, option_id: string, time_taken: number
): Promise<void> {
  if (!session_id || session_id.startsWith('local-') || session_id.startsWith('00000000')) {
    return;
  }

  const { error } = await (supabase as unknown as Record<string, unknown>).from('responses').insert({
    session_id,
    question_id,
    option_id,
    time_taken,
  });
  if (error) console.error('[saveResponse] Error:', error);
}

export async function createSession(userId: string): Promise<string> {
  if (!userId || userId.startsWith('00000000')) {
    return 'local-session-' + crypto.randomUUID();
  }

  // Validate UUID format before sending to Supabase
  const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  if (!uuidRegex.test(userId)) {
    return 'local-session-' + crypto.randomUUID();
  }

  const { data, error } = await supabase.from('sessions').insert({
    user_id: userId,
    status: 'in_progress',
  }).select('id').single();

  if (error || !data) {
    console.error('[createSession] Error:', error);
    return 'local-session-' + crypto.randomUUID();
  }
  return data.id;
}

export async function resumeSession(userId: string): Promise<{ session_id: string; responses: Array<{ question_id: string; option_id: string }> } | null> {
  const { data: session } = await supabase
    .from('sessions')
    .select('id')
    .eq('user_id', userId)
    .eq('status', 'in_progress')
    .order('started_at', { ascending: false })
    .limit(1)
    .single();

  if (!session) return null;

  const { data: responses } = await (supabase as unknown as Record<string, unknown>)
    .from('responses')
    .select('question_id, option_id')
    .eq('session_id', session.id);

  return {
    session_id: session.id,
    responses: responses || [],
  };
}

export async function fetchCandidates(): Promise<MockCandidate[]> {
  return withCache('fetchCandidates', async () => {
  const { data: sessions, error } = await supabase
    .from('sessions')
    .select('*')
    .eq('status', 'completed')
    .order('started_at', { ascending: false });

  if (error || !sessions) return [];

  // Fetch profile info for each unique user
  const userIds = [...new Set(sessions.map(s => s.user_id))];
  const { data: profiles } = await supabase
    .from('profiles')
    .select('id, email, full_name')
    .in('id', userIds);

  const profileMap = new Map((profiles || []).map(p => [p.id, p]));

  const latestByUser = new Map<string, unknown>();
  for (const s of sessions) {
    if (!latestByUser.has(s.user_id)) {
      latestByUser.set(s.user_id, s);
    }
  }

  return Array.from(latestByUser.values()).map(s => {
    const profile = profileMap.get(s.user_id);
    const roleScores = (s.role_scores as Record<string, number>) || {};
    const topEntry = Object.entries(roleScores).sort(([, a], [, b]) => b - a)[0] || ['Unknown', 0];
    const domainScores = (s.domain_scores as Record<string, number>) || {};
    const avg = Object.values(domainScores).length > 0
      ? Object.values(domainScores).reduce((a, b) => a + b, 0) / Object.values(domainScores).length
      : 0;

    return {
      id: s.id,
      user_id: s.user_id,
      name: (profile as Record<string, unknown>)?.full_name || (profile as Record<string, unknown>)?.email?.split('@')[0] || 'Unknown',
      email: profile?.email || '',
      date_taken: s.completed_at || s.started_at || '',
      status: s.status as 'completed',
      top_role: topEntry[0],
      top_role_score: topEntry[1],
      average_score: avg,
    };
  });
  });
}

export async function fetchCandidateAssessments(userId: string): Promise<Array<{ session_id: string; completed_at: string; status: string }>> {
  return withCache(`fetchCandidateAssessments_${userId}`, async () => {
  const { data, error } = await supabase
    .from('sessions')
    .select('id, completed_at, started_at, status')
    .eq('user_id', userId)
    .eq('status', 'completed')
    .order('started_at', { ascending: false });

  if (error || !data) return [];

  return data.map(s => ({
    session_id: s.id,
    completed_at: s.completed_at || s.started_at || '',
    status: s.status,
  }));
  });
}

export async function fetchCandidateResultsBySession(sessionId: string): Promise<MockAssessmentResult> {
  return withCache(`fetchCandidateResultsBySession_${sessionId}`, async () => {
  if (sessionId.startsWith('local-') || sessionId.startsWith('00000000')) {
    const localData = localStorage.getItem(`mock_results_${sessionId}`);
    if (localData) {
      return JSON.parse(localData);
    }
    throw new Error("No results found");
  }

  const { data, error } = await supabase
    .from('sessions')
    .select('*')
    .eq('id', sessionId)
    .eq('status', 'completed')
    .single();

  if (error || !data) throw new Error("No results found");

  return {
    session_id: data.id,
    date: data.completed_at || data.started_at || new Date().toISOString(),
    trait_scores: (data.trait_scores as Record<string, number>) || {},
    domain_scores: (data.domain_scores as Record<string, number>) || {},
    role_scores: (data.role_scores as Record<string, number>) || {},
    time_per_question: {},
  };
  });
}

export async function fetchCandidateResults(userId: string): Promise<MockAssessmentResult> {
  const sessions = await fetchCandidateAssessments(userId);
  if (!sessions.length) throw new Error("No results found");
  return fetchCandidateResultsBySession(sessions[0].session_id);
}

export async function saveAssessmentResult(
  userId: string,
  result: Omit<MockAssessmentResult, 'session_id' | 'date'>,
  sessionId?: string
): Promise<MockAssessmentResult> {
  const isMockSession = sessionId?.startsWith('local-') || userId.startsWith('00000000');

  if (isMockSession) {
    const finalResult = {
      ...result,
      session_id: sessionId || 'local-' + crypto.randomUUID(),
      date: new Date().toISOString(),
    };
    localStorage.setItem(`mock_results_${userId}`, JSON.stringify(finalResult));

    // Also update history
    const history = JSON.parse(localStorage.getItem(`mock_history_${userId}`) || '[]');
    history.unshift(finalResult);
    localStorage.setItem(`mock_history_${userId}`, JSON.stringify(history));

    return finalResult;
  }

  // If we have a session ID, update it. Otherwise create a new completed session.
  if (sessionId) {
    const { error } = await supabase
      .from('sessions')
      .update({
        status: 'completed',
        completed_at: new Date().toISOString(),
        trait_scores: result.trait_scores as unknown,
        domain_scores: result.domain_scores as unknown,
        role_scores: result.role_scores as unknown,
      })
      .eq('id', sessionId);

    if (error) console.error('[saveAssessmentResult] Update error:', error);

    return {
      ...result,
      session_id: sessionId,
      date: new Date().toISOString(),
    };
  }

  // Fallback: create a new completed session
  const { data, error } = await supabase
    .from('sessions')
    .insert({
      user_id: userId,
      status: 'completed',
      completed_at: new Date().toISOString(),
      trait_scores: result.trait_scores as unknown,
      domain_scores: result.domain_scores as unknown,
      role_scores: result.role_scores as unknown,
    })
    .select('id')
    .single();

  if (error) console.error('[saveAssessmentResult] Insert error:', error);

  return {
    ...result,
    session_id: data?.id || 'local-' + crypto.randomUUID(),
    date: new Date().toISOString(),
  };
}

export async function fetchAssessmentHistory(userId: string): Promise<MockAssessmentResult[]> {
  if (!userId) return [];

  if (userId.startsWith('00000000')) {
    const localData = localStorage.getItem(`mock_history_${userId}`);
    if (localData) {
      return JSON.parse(localData);
    }
    return [];
  }

  const { data, error } = await supabase
    .from('sessions')
    .select('*')
    .eq('user_id', userId)
    .eq('status', 'completed')
    .order('started_at', { ascending: false });

  if (error || !data) return [];

  return data.map(s => ({
    session_id: s.id,
    date: s.completed_at || s.started_at || new Date().toISOString(),
    trait_scores: (s.trait_scores as Record<string, number>) || {},
    domain_scores: (s.domain_scores as Record<string, number>) || {},
    role_scores: (s.role_scores as Record<string, number>) || {},
    time_per_question: {},
  }));
}

export async function fetchUsers(): Promise<PlatformUser[]> {
  return withCache('fetchUsers', async () => {
  const { data, error } = await supabase
    .from('profiles')
    .select('id, email, full_name, role')
    .order('created_at', { ascending: false });

  if (error || !data) return [];

  return data.map((u: Record<string, unknown>) => ({
    id: u.id,
    email: u.email,
    full_name: u.full_name,
    role: (u.role || 'candidate') as PlatformUser['role'],
  }));
  });
}

export async function updateUserRole(userId: string, role: PlatformUser['role']): Promise<void> {
  const { data, error } = await supabase
    .from('profiles')
    .update({ role })
    .eq('id', userId)
    .select('id, role');

  if (error) {
    const details = [error.message, error.details, error.hint].filter(Boolean).join(' | ');
    throw new Error(details || 'Failed to update role');
  }

  if (!data || data.length === 0) {
    throw new Error('No profile row was updated. This is usually caused by RLS policy restrictions or an invalid user id.');
  }
}
