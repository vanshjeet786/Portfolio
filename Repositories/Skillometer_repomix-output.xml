-- Create a helper function with SECURITY DEFINER to check if a user is invited
CREATE OR REPLACE FUNCTION is_user_invited(_user_id uuid, _user_email text, _org_id uuid)
RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  RETURN EXISTS (
    SELECT 1 FROM invitations
    WHERE org_id = _org_id
      AND email = _user_email
      AND status IN ('pending', 'accepted')
  );
END;
$$;

-- Create a new, cleaner policy that uses the JWT email claim instead of querying auth.users
CREATE POLICY "Users can insert memberships via invite or admin"
  ON org_memberships FOR INSERT
  TO authenticated
