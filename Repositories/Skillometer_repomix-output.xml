import { describe, it, expect } from "vitest";
import { TraitProfile, TraitSignal } from "../lib/scoring";

describe("TraitProfile", () => {
  describe("applySignal", () => {
    it("should initialize and apply a signal for a new trait with default speed multiplier", () => {
      const profile = new TraitProfile();
      const signal: TraitSignal = { trait: "leadership", weight: 0.5 };

      profile.applySignal(signal);

      expect(profile.trait_totals["leadership"]).toBe(0.5);
      expect(profile.trait_counts["leadership"]).toBe(1);
    });

    it("should accumulate values for an existing trait", () => {
      const profile = new TraitProfile();
      const signal1: TraitSignal = { trait: "communication", weight: 0.3 };
      const signal2: TraitSignal = { trait: "communication", weight: 0.4 };

      profile.applySignal(signal1);
      profile.applySignal(signal2);

      expect(profile.trait_totals["communication"]).toBe(0.7);
      expect(profile.trait_counts["communication"]).toBe(2);
    });

    it("should apply a custom speed multiplier correctly", () => {
      const profile = new TraitProfile();
      const signal: TraitSignal = { trait: "problem_solving", weight: 0.5 };

      profile.applySignal(signal, 2.0); // 0.5 * 2.0 = 1.0

      expect(profile.trait_totals["problem_solving"]).toBe(1.0);
      expect(profile.trait_counts["problem_solving"]).toBe(1);
    });
  });
});

import { TraitScoringEngine } from "../lib/scoring";

describe("TraitScoringEngine", () => {
  it("should clamp values between 0.0 and 1.0", () => {
    // Artificial case to force a very high hit rate before saturation
    const totals = { "extreme": 10.0 };
    const counts = { "extreme": 1 };
    const opps = { "extreme": 1 };

    const engine = new TraitScoringEngine(totals, counts, opps);
    const scores = engine.score();

    // tanh(10.0 * 1.0 * 1.5) = tanh(15) which is practically 1.0
    // But mathematically we just want to ensure it's not > 1.0
    expect(scores["extreme"]).toBeLessThanOrEqual(1.0);
    expect(scores["extreme"]).toBeGreaterThanOrEqual(0.0);
  });
});
