import React, { useEffect, useState } from 'react';
import { motion } from 'framer-motion';

// Tech debris symbols: brackets, binary, hex, generic glyphs
const DEBRIS_SYMBOLS = ['{', '}', '[', ']', '<', '>', '/', '\\', '0', '1', 'A', 'F', 'C', '8', 'X', 'Y', 'Z', '+', '-', '*', '&', '|', '^', '~'];

interface Debris {
  id: number;
  x: number;
  y: number;
  symbol: string;
  size: number;
  opacity: number;
  speedY: number;
  speedX: number;
  rotation: number;
  rotationSpeed: number;
}

export const TechSingularityBackground_Alternate: React.FC = () => {
  const [debris, setDebris] = useState<Debris[]>([]);

  useEffect(() => {
    // Generate initial debris
    const particleCount = 50;
    const initialDebris: Debris[] = Array.from({ length: particleCount }).map((_, i) => ({
      id: i,
      x: Math.random() * 100, // percentage
      y: Math.random() * 100, // percentage
      symbol: DEBRIS_SYMBOLS[Math.floor(Math.random() * DEBRIS_SYMBOLS.length)],
      size: Math.random() * 14 + 8, // px
      opacity: Math.random() * 0.3 + 0.05,
      speedY: (Math.random() - 0.5) * 0.5, // % per tick
      speedX: (Math.random() - 0.5) * 0.2, // % per tick
      rotation: Math.random() * 360,
      rotationSpeed: (Math.random() - 0.5) * 2,
    }));

    setDebris(initialDebris);

    // Animation loop
    let animationFrameId: number;
    let lastTime = performance.now();

    const animate = (time: number) => {
      const deltaTime = (time - lastTime) / 16.66; // Normalize to roughly 60fps
      lastTime = time;

      setDebris((prevDebris) => prevDebris.map((p) => {
        let newY = p.y + p.speedY * deltaTime;
        let newX = p.x + p.speedX * deltaTime;
        const newRotation = p.rotation + p.rotationSpeed * deltaTime;

        // Wrap around screen
        if (newY > 110) newY = -10;
        if (newY < -10) newY = 110;
        if (newX > 110) newX = -10;
        if (newX < -10) newX = 110;

        return { ...p, y: newY, x: newX, rotation: newRotation };
      }));

      animationFrameId = requestAnimationFrame(animate);
    };

    animationFrameId = requestAnimationFrame(animate);

    return () => cancelAnimationFrame(animationFrameId);
  }, []);

  return (
    <div className="fixed inset-0 z-[-1] overflow-hidden bg-black pointer-events-none">
      {/* Central subtle gradient simulating a 'core' or singularity */}
      <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary/10 via-black to-black opacity-60"></div>

      {/* Grid lines for terminal feel */}
