import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';

export function TypewriterLogo() {
  const [phase, setPhase] = useState<'typing' | 'backspacing' | 'retyping' | 'done'>('typing');
  const [text, setText] = useState('');
  const fullText = "Skillometer";
  const typoText = "Skillomtr"; // Deliberate typo

  useEffect(() => {
    let timeout: NodeJS.Timeout;

    if (phase === 'typing') {
      if (text.length < typoText.length) {
        timeout = setTimeout(() => {
          setText(typoText.slice(0, text.length + 1));
        }, 100);
      } else {
        timeout = setTimeout(() => setPhase('backspacing'), 500);
      }
    } else if (phase === 'backspacing') {
      if (text.length > "Skillom".length) {
        timeout = setTimeout(() => {
          setText(text.slice(0, -1));
        }, 80);
      } else {
        timeout = setTimeout(() => setPhase('retyping'), 200);
      }
    } else if (phase === 'retyping') {
      if (text.length < fullText.length) {
        timeout = setTimeout(() => {
          setText(fullText.slice(0, text.length + 1));
        }, 100);
      } else {
        setPhase('done');
      }
    } else if (phase === 'done') {
      // Loop back after a long pause
      timeout = setTimeout(() => {
        setPhase('typing');
        setText('');
      }, 10000); // Repeat every 10s
    }

    return () => clearTimeout(timeout);
  }, [text, phase]);

  return (
    <div className="font-mono flex items-center">
      <span className="font-bold tracking-tight text-primary">{text}</span>
      <motion.span
        animate={{ opacity: [1, 0] }}
        transition={{ repeat: Infinity, duration: 0.8, ease: "linear" }}
        className="w-2 h-4 bg-primary ml-1 inline-block"
      />
    </div>
  );
}
