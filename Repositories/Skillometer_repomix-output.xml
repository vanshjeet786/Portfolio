import { useState, useEffect } from 'react';
import { useAuth } from '@/contexts/AuthContext';
import { useOrg } from '@/contexts/OrgContext';
import { AppLayout } from '@/components/AppLayout';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import { Label } from '@/components/ui/label';
import { RadioGroup, RadioGroupItem } from '@/components/ui/radio-group';
import { Switch } from '@/components/ui/switch';
import { Eye, EyeOff, Shield } from 'lucide-react';
import { getVisibilitySettings, setVisibilityMode, toggleSessionVisibility, type VisibilityMode } from '@/lib/visibility-service';
import { fetchAssessmentHistory, type MockAssessmentResult } from '@/lib/supabase-stubs';
import { toast } from 'sonner';
import { format } from 'date-fns';

export default function VisibilitySettings() {
  const { user } = useAuth();
  const { currentOrg } = useOrg();
  const [mode, setMode] = useState<VisibilityMode>('hide_all');
  const [sessions, setSessions] = useState<MockAssessmentResult[]>([]);
  const [visibleSessions, setVisibleSessions] = useState<Set<string>>(new Set());

  useEffect(() => {
    if (!currentOrg || !user) return;
    getVisibilitySettings(currentOrg.orgId).then(s => {
      if (s) setMode(s.visibility_mode);
    });
    fetchAssessmentHistory(user.id).then(setSessions);
  }, [currentOrg, user]);

  const handleModeChange = async (newMode: VisibilityMode) => {
    if (!currentOrg) return;
    setMode(newMode);
    const ok = await setVisibilityMode(currentOrg.orgId, newMode);
    if (ok) toast.success('Visibility updated');
  };

  const handleToggleSession = async (sessionId: string, visible: boolean) => {
    if (!currentOrg) return;
    const ok = await toggleSessionVisibility(currentOrg.orgId, sessionId, visible);
    if (ok) {
      const newSet = new Set(visibleSessions);
      if (visible) newSet.add(sessionId); else newSet.delete(sessionId);
      setVisibleSessions(newSet);
    }
  };

  return (
    <AppLayout>
      <div className="max-w-3xl mx-auto space-y-6">
        <h1 className="text-3xl font-bold tracking-tight flex items-center gap-2">
          <Shield className="h-8 w-8" /> Assessment Visibility
        </h1>

        {!currentOrg ? (
          <Card>
            <CardContent className="py-12 text-center text-muted-foreground">
              Join an organization to manage visibility settings.
            </CardContent>
          </Card>
        ) : (
          <>
            <Card>
              <CardHeader>
                <CardTitle>Who can see your assessments?</CardTitle>
                <CardDescription>Control how your assessment results are shared with peers in {currentOrg.org.name}</CardDescription>
              </CardHeader>
              <CardContent>
                <RadioGroup value={mode} onValueChange={v => handleModeChange(v as VisibilityMode)} className="space-y-4">
                  <div className="flex items-start gap-3 p-4 border rounded-lg">
                    <RadioGroupItem value="hide_all" id="hide_all" className="mt-1" />
                    <div>
                      <Label htmlFor="hide_all" className="flex items-center gap-2 font-medium"><EyeOff className="h-4 w-4" /> Hide All</Label>
                      <p className="text-sm text-muted-foreground mt-1">No peers can see your assessment results. Leaders with appropriate roles can still view.</p>
                    </div>
                  </div>
                  <div className="flex items-start gap-3 p-4 border rounded-lg">
                    <RadioGroupItem value="show_selected" id="show_selected" className="mt-1" />
                    <div>
                      <Label htmlFor="show_selected" className="flex items-center gap-2 font-medium"><Eye className="h-4 w-4" /> Show Selected</Label>
                      <p className="text-sm text-muted-foreground mt-1">Choose which specific assessments to share with peers.</p>
                    </div>
                  </div>
                  <div className="flex items-start gap-3 p-4 border rounded-lg">
                    <RadioGroupItem value="show_all" id="show_all" className="mt-1" />
                    <div>
                      <Label htmlFor="show_all" className="flex items-center gap-2 font-medium"><Eye className="h-4 w-4" /> Show All</Label>
                      <p className="text-sm text-muted-foreground mt-1">All your assessments are visible to peers in the organization.</p>
                    </div>
                  </div>
                </RadioGroup>
              </CardContent>
            </Card>

            {mode === 'show_selected' && (
              <Card>
                <CardHeader>
                  <CardTitle>Select Visible Assessments</CardTitle>
                </CardHeader>
                <CardContent>
                  {sessions.length === 0 ? (
                    <p className="text-muted-foreground text-center py-4">No completed assessments</p>
                  ) : (
                    <div className="space-y-3">
                      {sessions.map(s => (
                        <div key={s.session_id} className="flex items-center justify-between p-3 border rounded-lg">
                          <div>
                            <p className="font-medium text-sm">{format(new Date(s.date), 'PPP')}</p>
                            <p className="text-xs text-muted-foreground">
                              Top: {Object.entries(s.role_scores).sort((a, b) => b[1] - a[1])[0]?.[0] || 'N/A'}
                            </p>
                          </div>
                          <Switch
                            checked={visibleSessions.has(s.session_id)}
                            onCheckedChange={v => handleToggleSession(s.session_id, v)}
                          />
                        </div>
                      ))}
                    </div>
                  )}
                </CardContent>
              </Card>
            )}
          </>
        )}
      </div>
    </AppLayout>
  );
}
</file>

