import jsPDF from 'jspdf';
import html2canvas from 'html2canvas';

const PAGE_WIDTH_MM = 210;
const PAGE_HEIGHT_MM = 297;

const fillPageWhite = (pdf: jsPDF) => {
  pdf.setFillColor(255, 255, 255);
  pdf.rect(0, 0, PAGE_WIDTH_MM, PAGE_HEIGHT_MM, 'F');
};

const canvasToHeightMm = (canvas: HTMLCanvasElement, widthMm = PAGE_WIDTH_MM) =>
  (canvas.height * widthMm) / canvas.width;

const prepareCloneForCapture = (clonedEl: HTMLElement) => {
  clonedEl.style.overflow = 'visible';
  clonedEl.querySelectorAll('*').forEach((node) => {
    const el = node as HTMLElement;
    if (el.style) {
      el.style.overflow = 'visible';
      el.style.textOverflow = 'clip';
    }
  });
};

const captureElement = async (el: HTMLElement) => {
  const width = el.offsetWidth;
  const height = el.offsetHeight;

  return html2canvas(el, {
    scale: 2,
    useCORS: true,
    backgroundColor: '#ffffff',
    logging: false,
    width,
    height,
    windowWidth: width,
    windowHeight: height,
    onclone: (_doc, clonedEl) => {
      clonedEl.style.width = `${width}px`;
      clonedEl.style.boxSizing = 'border-box';
      prepareCloneForCapture(clonedEl);
    },
  });
};

/** Slice a tall image across multiple PDF pages (only when a single section exceeds page height). */
const addTallImage = (pdf: jsPDF, canvas: HTMLCanvasElement) => {
  const imgData = canvas.toDataURL('image/png');
  const imgHeightMm = canvasToHeightMm(canvas);
  let heightLeft = imgHeightMm;
  let position = 0;

  pdf.addImage(imgData, 'PNG', 0, position, PAGE_WIDTH_MM, imgHeightMm);
  heightLeft -= PAGE_HEIGHT_MM;

  while (heightLeft > 0) {
    position = heightLeft - imgHeightMm;
    pdf.addPage();
    fillPageWhite(pdf);
    pdf.addImage(imgData, 'PNG', 0, position, PAGE_WIDTH_MM, imgHeightMm);
    heightLeft -= PAGE_HEIGHT_MM;
  }
};

export async function generatePDFReport(
  containerEl: HTMLElement,
  filename = 'Skillometer-Report.pdf'
) {
  const originalDisplay = containerEl.style.display;
  const originalPosition = containerEl.style.position;
  const originalLeft = containerEl.style.left;
  const originalTop = containerEl.style.top;
  const originalZIndex = containerEl.style.zIndex;
  const originalOverflow = containerEl.style.overflow;

  containerEl.style.display = 'block';
  containerEl.style.position = 'fixed';
  containerEl.style.left = '0';
  containerEl.style.top = '0';
  containerEl.style.zIndex = '-9999';
  containerEl.style.overflow = 'visible';

  const sections = Array.from(
    containerEl.querySelectorAll<HTMLElement>('[data-pdf-section]')
  );

  const pdf = new jsPDF('p', 'mm', 'a4');
  fillPageWhite(pdf);
  let currentY = 0;

  for (const section of sections) {
    const canvas = await captureElement(section);
    const sectionHeightMm = canvasToHeightMm(canvas);

    if (sectionHeightMm > PAGE_HEIGHT_MM) {
      if (currentY > 0) {
        pdf.addPage();
        fillPageWhite(pdf);
      }
      addTallImage(pdf, canvas);
      currentY = 0;
      continue;
    }

    if (currentY > 0 && currentY + sectionHeightMm > PAGE_HEIGHT_MM) {
      pdf.addPage();
      fillPageWhite(pdf);
      currentY = 0;
    }

    pdf.addImage(
      canvas.toDataURL('image/png'),
      'PNG',
      0,
      currentY,
      PAGE_WIDTH_MM,
      sectionHeightMm
    );
    currentY += sectionHeightMm;
  }

  containerEl.style.display = originalDisplay;
  containerEl.style.position = originalPosition;
  containerEl.style.left = originalLeft;
  containerEl.style.top = originalTop;
  containerEl.style.zIndex = originalZIndex;
  containerEl.style.overflow = originalOverflow;

  pdf.save(filename);
}
