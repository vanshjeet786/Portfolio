<file path="src/pages/OrgDashboard.tsx">
import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '@/contexts/AuthContext';
import { useOrg } from '@/contexts/OrgContext';
import { AppLayout } from '@/components/AppLayout';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { Badge } from '@/components/ui/badge';
import { Building2, Plus, Users, Shield } from 'lucide-react';
import { createOrganization, fetchOrgMembers, type OrgMember } from '@/lib/org-service';
import { formatOrgRole } from '@/lib/authorization';
import { toast } from 'sonner';

export default function OrgDashboard() {
  const { user } = useAuth();
  const { orgs, currentOrg, refresh } = useOrg();
  const navigate = useNavigate();
  const [showCreate, setShowCreate] = useState(false);
  const [name, setName] = useState('');
  const [slug, setSlug] = useState('');
  const [description, setDescription] = useState('');
  const [members, setMembers] = useState<OrgMember[]>([]);
  const [creating, setCreating] = useState(false);

  useEffect(() => {
    if (currentOrg) {
      fetchOrgMembers(currentOrg.orgId).then(setMembers);
    }
  }, [currentOrg]);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!name || !slug) return;
    setCreating(true);
    const org = await createOrganization(name, slug, description);
    setCreating(false);
    if (org) {
      toast.success('Organization created!');
      setShowCreate(false);
      setName(''); setSlug(''); setDescription('');
      await refresh();
    } else {
      toast.error('Failed to create organization');
    }
  };

  const roleColor: Record<string, string> = {
    dev_admin: 'bg-red-100 text-red-800',
    super_admin: 'bg-purple-100 text-purple-800',
    hr_admin: 'bg-blue-100 text-blue-800',
    team_lead: 'bg-green-100 text-green-800',
    member: 'bg-muted text-muted-foreground',
  };

  return (
    <AppLayout>
      <div className="max-w-6xl mx-auto space-y-6">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-3xl font-bold tracking-tight flex items-center gap-2">
              <Building2 className="h-8 w-8" /> Organizations
            </h1>
            <p className="text-muted-foreground mt-1">Manage your organizations and teams</p>
          </div>
          <Button onClick={() => setShowCreate(!showCreate)}>
            <Plus className="h-4 w-4 mr-2" /> Create Organization
          </Button>
        </div>

        {showCreate && (
          <Card>
            <CardHeader>
              <CardTitle>Create New Organization</CardTitle>
            </CardHeader>
            <CardContent>
              <form onSubmit={handleCreate} className="space-y-4">
                <div className="grid grid-cols-2 gap-4">
                  <div className="space-y-2">
                    <Label>Organization Name</Label>
                    <Input value={name} onChange={e => { setName(e.target.value); setSlug(e.target.value.toLowerCase().replace(/[^a-z0-9]+/g, '-')); }} required />
                  </div>
                  <div className="space-y-2">
                    <Label>Slug (URL-friendly)</Label>
                    <Input value={slug} onChange={e => setSlug(e.target.value)} required />
                  </div>
                </div>
                <div className="space-y-2">
                  <Label>Description</Label>
                  <Textarea value={description} onChange={e => setDescription(e.target.value)} rows={2} />
                </div>
                <Button type="submit" disabled={creating}>{creating ? 'Creating...' : 'Create'}</Button>
              </form>
            </CardContent>
          </Card>
        )}

        {orgs.length === 0 ? (
          <Card>
            <CardContent className="py-12 text-center text-muted-foreground">
              <Building2 className="h-12 w-12 mx-auto mb-4 opacity-50" />
              <p>You're not part of any organization yet.</p>
              <p className="text-sm mt-2">Create one or accept an invitation to get started.</p>
            </CardContent>
          </Card>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {orgs.map(o => (
              <Card key={o.orgId} className={`cursor-pointer hover:border-primary transition-colors ${currentOrg?.orgId === o.orgId ? 'border-primary' : ''}`}
                onClick={() => navigate(`/org/${o.orgId}`)}>
                <CardHeader>
                  <div className="flex items-center justify-between">
                    <CardTitle className="text-lg">{o.org.name}</CardTitle>
                    <Badge className={roleColor[o.role] || ''}>{formatOrgRole(o.role)}</Badge>
                  </div>
                  <CardDescription>/{o.org.slug}</CardDescription>
                </CardHeader>
                <CardContent>
                  <div className="flex gap-4 text-sm text-muted-foreground">
                    <span className="flex items-center gap-1"><Users className="h-4 w-4" /> Members</span>
                    <span className="flex items-center gap-1"><Shield className="h-4 w-4" /> {formatOrgRole(o.role)}</span>
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        )}

        {currentOrg && members.length > 0 && (
          <Card>
            <CardHeader>
              <CardTitle>Members — {currentOrg.org.name}</CardTitle>
              <CardDescription>{members.length} members</CardDescription>
            </CardHeader>
            <CardContent>
              <div className="space-y-2">
                {members.map(m => (
                  <div key={m.id} className="flex items-center justify-between p-3 rounded-none terminal-border border">
                    <div>
                      <p className="font-medium">{m.profile?.full_name || m.profile?.email || m.user_id}</p>
                      <p className="text-sm text-muted-foreground">{m.profile?.email}</p>
                    </div>
                    <Badge className={roleColor[m.role] || ''}>{formatOrgRole(m.role)}</Badge>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
        )}
      </div>
    </AppLayout>
  );
}
