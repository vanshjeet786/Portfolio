import { toast } from '@/hooks/use-toast';
import { supabase } from '@/integrations/supabase/client';
import { TerminalLoader } from "@/components/TerminalLoader";
import { useState, useRef, useEffect, useCallback, useMemo } from 'react';
import { useNavigate } from 'react-router-dom';
import { Button } from '@/components/ui/button';
import { Progress } from '@/components/ui/progress';
import { cn } from '@/lib/utils';
import { getRandomizedQuestions, getVerificationQuestions } from '@/lib/questions';
import { calculateFinalScores } from '@/lib/scoring';
import type { Question, UserResponse, TraitSignal } from '@/lib/scoring';
import { ALL_ROLES } from '@/data/roles';
import { ALL_QUESTIONS } from '@/data/questions';
import { saveResponseToSupabase, createSession, saveAssessmentResult } from '@/lib/supabase-stubs';
import { NaturalLanguagePhase } from './NaturalLanguagePhase';
import { useAuth } from '@/contexts/AuthContext';
import { Maximize, Minimize } from 'lucide-react';

export function AssessmentScreen() {
  const { user } = useAuth();
  const navigate = useNavigate();
  const [questions, setQuestions] = useState<Question[]>(() => getRandomizedQuestions());
  const [currentIndex, setCurrentIndex] = useState(0);
  const [selectedOption, setSelectedOption] = useState<string | null>(null);
  const [responses, setResponses] = useState<UserResponse[]>([]);
  const [sessionId, setSessionId] = useState<string>('');
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [phase, setPhase] = useState<'main' | 'natural_language' | 'verification_loading' | 'verification' | 'complete'>('main');
  const [nlSignals, setNlSignals] = useState<TraitSignal[]>([]);

  const [isFullscreen, setIsFullscreen] = useState(false);

  useEffect(() => {
    const handleFullscreenChange = () => {
      setIsFullscreen(!!document.fullscreenElement);
    };
    document.addEventListener('fullscreenchange', handleFullscreenChange);
    return () => document.removeEventListener('fullscreenchange', handleFullscreenChange);
  }, []);

  const toggleFullscreen = () => {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(err => {
        console.error(`Error attempting to enable fullscreen mode: ${err.message}`);
      });
    } else {
      if (document.exitFullscreen) {
        document.exitFullscreen();
      }
    }
  };

  // Invisible timer
  const timerRef = useRef(0);
  const intervalRef = useRef<ReturnType<typeof setInterval> | null>(null);

  useEffect(() => {
    if (user?.id) {
      createSession(user.id).then(setSessionId);
    }
  }, [user?.id]);

  // Start timer for each question
  useEffect(() => {
    timerRef.current = 0;
    intervalRef.current = setInterval(() => {
      timerRef.current += 1;
    }, 1000);
    return () => {
      if (intervalRef.current) clearInterval(intervalRef.current);
    };
  }, [currentIndex]);

  const currentQuestion = questions[currentIndex];
  const totalQuestions = questions.length;
  const progressPercent = ((currentIndex) / totalQuestions) * 100;

  const handleNext = useCallback(async (forcedOption?: string) => {
    const finalOption = forcedOption || selectedOption;
    if (!finalOption || !currentQuestion) return;

    setIsSubmitting(true);
    const timeTaken = timerRef.current;

    const response: UserResponse = {
      question_id: currentQuestion.question_id,
      option_id: finalOption,
      time_taken: timeTaken,
    };

    // Filter out the old response if the user is changing their answer
    const newResponses = responses.filter(r => r.question_id !== currentQuestion.question_id);
    newResponses.push(response);
    setResponses(newResponses);

    await saveResponseToSupabase(sessionId, currentQuestion.question_id, finalOption, timeTaken);

    if (currentIndex < questions.length - 1) {
      setCurrentIndex(prev => prev + 1);
      // Pre-fill the option if the user has already answered the next question (e.g. they went back, then forward)
      const nextQuestion = questions[currentIndex + 1];
      const existingResponse = newResponses.find(r => r.question_id === nextQuestion.question_id);
      setSelectedOption(existingResponse ? existingResponse.option_id : null);
    } else if (phase === 'main') {
      // Phase 1 complete. Move to Natural Language phase
      setPhase('natural_language');
    } else if (phase === 'verification') {
      // Phase 2 complete. Calculate final scores including all responses

      // Combine ALL_QUESTIONS with the dynamically generated ones so the scoring engine can find them
      const allPossibleQuestions = [...ALL_QUESTIONS, ...questions];
      const results = calculateFinalScores(allPossibleQuestions, newResponses, ALL_ROLES);

      // Inject the natural language traits into the final trait scores
      nlSignals.forEach(sig => {
        results.trait_scores[sig.trait] = (results.trait_scores[sig.trait] || 0) + (sig.weight * 0.5); // Give it some weight but don't overwhelm multiple choice
      });

      saveAssessmentResult(user?.id || 'anonymous', {
        ...results,
        time_per_question: {},
      }, sessionId).then(() => {
        navigate('/results');
      });
    }
    setIsSubmitting(false);
  }, [selectedOption, currentQuestion, responses, sessionId, currentIndex, questions, navigate, phase, nlSignals, user?.id]);

  const handlePrevious = useCallback(() => {
    if (currentIndex > 0) {
      setCurrentIndex(prev => prev - 1);
      const prevQuestion = questions[currentIndex - 1];
      const existingResponse = responses.find(r => r.question_id === prevQuestion.question_id);
      setSelectedOption(existingResponse ? existingResponse.option_id : null);
    }
  }, [currentIndex, questions, responses]);

  const handleOptionSelect = (optionId: string) => {
    setSelectedOption(optionId);
    setTimeout(() => {
      handleNext(optionId);
    }, 200);
  };

  const handleNaturalLanguageComplete = async (signals: TraitSignal[]) => {
    setNlSignals(signals);

    // Calculate interim traits to fetch verification questions
    const interimResults = calculateFinalScores(questions, responses, ALL_ROLES);

    // Apply NL signals manually to get a better interim profile
    const enhancedTraitScores = { ...interimResults.trait_scores };
    signals.forEach(sig => {
      enhancedTraitScores[sig.trait] = (enhancedTraitScores[sig.trait] || 0) + sig.weight;
    });

    const sortedTraits = Object.entries(enhancedTraitScores)
      .sort((a, b) => b[1] - a[1]);

    const topTraits = sortedTraits.slice(0, 5).map(t => t[0]);
    const weakTraits = sortedTraits.slice(-5).map(t => t[0]);

    const usedIds = questions.map(q => q.question_id);

    // We will generate the 10 verification questions using AI in a loading state
    setPhase('verification_loading');


    const session = (await supabase.auth.getSession()).data.session;
    if (!session?.access_token) {
      toast({ title: "Authentication required", description: "Please log in to continue.", variant: "destructive" });
      return;
    }

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 30000);


    fetch(`${import.meta.env.VITE_SUPABASE_URL}/functions/v1/generate-verification`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${session.access_token}`,
      },
      body: JSON.stringify({ traits: [...topTraits, ...weakTraits] }),
      signal: controller.signal,
    })
      .then(res => {
        if (!res.ok) throw new Error("Failed to generate verification questions");
        return res.json();
      })
      .then(data => {
        if (data.questions && data.questions.length > 0) {
          setQuestions(data.questions);
        } else {
          setQuestions(getVerificationQuestions(topTraits, usedIds));
        }
      })
      .catch((e) => {
        console.error("Failed to generate AI verification questions, using static fallback", e);
        const description = e.name === 'AbortError' ? "The request timed out. Using fallbacks." : "Using static fallback questions.";
        toast({ title: "AI Generation", description, variant: "destructive" });
        setQuestions(getVerificationQuestions(topTraits, usedIds));
      })
      .finally(() => {
        clearTimeout(timeoutId);
        setCurrentIndex(0);
        setSelectedOption(null);
        setPhase('verification');
      });
  };

  if (phase === 'natural_language') {
    return <NaturalLanguagePhase onComplete={handleNaturalLanguageComplete} sessionId={sessionId} />;
  }

  if (phase === 'verification_loading') {
    return (
      <div className="max-w-2xl mx-auto space-y-8 flex flex-col items-center justify-center min-h-[40vh] animate-in fade-in zoom-in relative">
         <div className="absolute top-0 right-0 flex gap-2 -mt-10">
          <Button variant="outline" size="icon" onClick={toggleFullscreen} className="h-8 w-8" title={isFullscreen ? "Exit fullscreen" : "Enter fullscreen"}>
            {isFullscreen ? <Minimize className="h-4 w-4" /> : <Maximize className="h-4 w-4" />}
          </Button>
         </div>
         <TerminalLoader className="text-lg" />
         <h2 className="text-xl font-medium mt-4">Generating personalized verification questions...</h2>
         <p className="text-muted-foreground">Our AI is analyzing your responses to create custom scenarios.</p>
      </div>
    );
  }

  if (!currentQuestion) return null;

  return (
    <div className="max-w-2xl mx-auto space-y-8 relative">
      <div className="absolute top-0 right-0 flex gap-2 -mt-10">
        <Button variant="outline" size="icon" onClick={toggleFullscreen} className="h-8 w-8" title={isFullscreen ? "Exit fullscreen" : "Enter fullscreen"}>
          {isFullscreen ? <Minimize className="h-4 w-4" /> : <Maximize className="h-4 w-4" />}
        </Button>
      </div>
      {/* Progress */}
      <div className="space-y-2">
        <div className="flex justify-between text-sm text-muted-foreground">
          <span>{phase === 'verification' ? 'Verification Phase - ' : ''}Question {currentIndex + 1} of {questions.length}</span>
          <span className="capitalize">{currentQuestion.layer} layer</span>
        </div>
        <Progress value={progressPercent} className="h-1.5" />
      </div>

      {/* Question */}
      <div className="space-y-6">
        <h2 className="text-xl font-medium leading-relaxed" style={{ whiteSpace: "pre-wrap" }}>{currentQuestion.text.replace(/Scenario \d+ — /, "Scenario: ")}</h2>

        {/* Options */}
        <div className="space-y-3">
          {currentQuestion.options.map((option) => (
            <button
              key={option.option_id}
              onClick={() => handleOptionSelect(option.option_id)}
              className={cn(
                'w-full text-left px-5 py-4 rounded-lg border transition-all',
                'hover:bg-muted/50',
                selectedOption === option.option_id
                  ? 'border-primary bg-primary/5 ring-1 ring-primary'
                  : 'border-border'
              )}
            >
              <span className="text-sm leading-relaxed">{option.text}</span>
            </button>
          ))}
        </div>
      </div>

      {/* Next Button */}
      <div className="flex justify-between items-center mt-8">
        <Button
          onClick={handlePrevious}
          disabled={currentIndex === 0 || isSubmitting}
          variant="outline"
          size="lg"
          className="min-w-[140px]"
        >
          Previous
        </Button>
        <Button
          onClick={() => handleNext()}
          disabled={!selectedOption || isSubmitting}
          size="lg"
          className="min-w-[140px]"
        >
          {currentIndex === totalQuestions - 1 ? 'Finish Assessment' : 'Next Question'}
        </Button>
      </div>
    </div>
  );
}
</file>

