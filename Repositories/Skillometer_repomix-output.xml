    -- Admins can insert
    (EXISTS (
      SELECT 1 FROM org_memberships om
      WHERE om.user_id = auth.uid()
        AND om.org_id = org_memberships.org_id
        AND om.role IN ('super_admin', 'dev_admin', 'hr_admin')
    ))
    OR
    -- Invited users can insert themselves
    (
      auth.uid() = user_id AND
      is_user_invited(auth.uid(), auth.jwt() ->> 'email', org_id)
    )
  );
