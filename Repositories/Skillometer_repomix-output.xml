<file path="src/pages/Results.tsx">
import { useState, useEffect, useMemo, useRef } from 'react';
import { flushSync } from 'react-dom';
import { useNavigate, useSearchParams } from 'react-router-dom';
import { AppLayout } from '@/components/AppLayout';
import { Badge } from '@/components/ui/badge';
import { Progress } from '@/components/ui/progress';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { fetchAssessmentHistory } from '@/lib/supabase-stubs';
import type { MockAssessmentResult } from '@/lib/supabase-stubs';
import { useAuth } from '@/contexts/AuthContext';
import { Search, TrendingUp, TrendingDown, Minus, ArrowLeft, Download, ArrowUpRight, ArrowDownRight, GitCompareArrows } from 'lucide-react';
import {
  RadarChart, Radar, PolarGrid, PolarAngleAxis, PolarRadiusAxis, ResponsiveContainer,
  BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Cell, Legend,
} from 'recharts';
import { RoleDeepDive } from '@/components/RoleDeepDive';
import { CareerCoach } from '@/components/CareerCoach';
import { generatePDFReport } from '@/lib/pdf-report';
import { AIEnhancedResults } from '@/components/AIEnhancedResults';
import { PrintableReport, type IPrintableCustomRole, type IPrintableDeepInsights } from '../components/PrintableReport';
import { supabase } from '@/integrations/supabase/client';


const DOMAIN_LABELS: Record<string, string> = {
  decision_making: 'Decision Making',
  behavioral_style: 'Behavioral Style',
  communication: 'Communication',
  emotional_intelligence: 'Emotional Intelligence',
  professional_readiness: 'Professional Readiness',
  learning_agility: 'Learning Agility',
};

function formatDomainLabel(key: string) {
  return DOMAIN_LABELS[key] || key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}

function getScoreColor(score: number): string {
  if (score >= 0.75) return 'hsl(var(--primary))';
  if (score >= 0.5) return 'hsl(var(--warning, 45 93% 47%))';
  return 'hsl(var(--destructive))';
}

function getReadiness(score: number): { label: string; variant: 'default' | 'secondary' | 'destructive' } {
  if (score >= 0.7) return { label: 'Ready', variant: 'default' };
  if (score >= 0.5) return { label: 'Developing', variant: 'secondary' };
  return { label: 'Emerging', variant: 'destructive' };
}

const Results = () => {
  const [history, setHistory] = useState<MockAssessmentResult[]>([]);
  const [searchParams] = useSearchParams();
  const sessionParam = searchParams.get('session');
  const [selectedResultId, setSelectedResultId] = useState<string>('');
  const [compareId, setCompareId] = useState<string>('');
  const [comparing, setComparing] = useState(false);
  const [roleSearch, setRoleSearch] = useState('');
  const [deepDiveRole, setDeepDiveRole] = useState<string | null>(null);
  const [isPdfLoading, setIsPdfLoading] = useState(false);
  const [exportCustomRoles, setExportCustomRoles] = useState<IPrintableCustomRole[] | null>(null);
  const [exportDeepInsights, setExportDeepInsights] = useState<IPrintableDeepInsights | null>(null);
  const printableRef = useRef<HTMLDivElement>(null);
  const { user } = useAuth();
  const navigate = useNavigate();

  useEffect(() => {
    if (user?.id) {
      fetchAssessmentHistory(user.id).then(data => {
        setHistory(data);
        if (sessionParam && data.find(d => d.session_id === sessionParam)) {
          setSelectedResultId(sessionParam);
        } else if (data.length > 0 && !selectedResultId) {
          setSelectedResultId(data[0].session_id);
        }
      });
    }
  }, [sessionParam, user?.id, selectedResultId]);

  const selectedResult = history.find(h => h.session_id === selectedResultId) || history[0];
  const compareResult = comparing ? history.find(h => h.session_id === compareId) : null;

  // Radar data with optional comparison
  const radarData = useMemo(() => {
    if (!selectedResult) return [];
    return Object.entries(selectedResult.domain_scores).map(([key, val]) => {
      const item: { domain: string, score: number, compare?: number } = {
        domain: formatDomainLabel(key),
        score: Math.round((val as number) * 100),
      };
      if (compareResult) {
        item.compare = Math.round(((compareResult.domain_scores[key] as number) || 0) * 100);
      }
      return item;
    });
  }, [selectedResult, compareResult]);

  // Delta table for comparison
  const deltaData = useMemo(() => {
    if (!selectedResult || !compareResult) return [];
    return Object.entries(selectedResult.domain_scores).map(([key, val]) => {
      const current = val as number;
      const prev = (compareResult.domain_scores[key] as number) || 0;
      return {
        domain: formatDomainLabel(key),
        current: Math.round(current * 100),
        previous: Math.round(prev * 100),
        delta: Math.round((current - prev) * 100),
      };
    });
  }, [selectedResult, compareResult]);

  const allRoles = useMemo(() =>
    selectedResult
      ? Object.entries(selectedResult.role_scores)
          .sort(([, a], [, b]) => (b as number) - (a as number))
          .map(([role, score]) => ({ role, score: score as number }))
      : [],
    [selectedResult]
  );

  const filteredRoles = useMemo(() => {
    let roles = allRoles;
    if (roleSearch) {
      roles = roles.filter(r => r.role.toLowerCase().includes(roleSearch.toLowerCase()));
    }
    return roles.map(r => {
      const compareScore = comparing && compareResult && compareResult.role_scores[r.role]
        ? compareResult.role_scores[r.role] as number
        : undefined;
      return { ...r, compareScore };
    });
  }, [allRoles, roleSearch, comparing, compareResult]);

  const allTraits = useMemo(() =>
    selectedResult
      ? Object.entries(selectedResult.trait_scores)
          .sort(([, a], [, b]) => (b as number) - (a as number))
          .map(([trait, score]) => ({ trait, score: score as number }))
      : [],
    [selectedResult]
  );

  const traitBarData = useMemo(() => {
    return allTraits.slice(0, 10).map(t => {
      const base = {
        name: t.trait.replace(/_/g, ' '),
        score: Math.round(t.score * 100),
      };
      if (comparing && compareResult && compareResult.trait_scores[t.trait]) {
        return {
          ...base,
          compareScore: Math.round((compareResult.trait_scores[t.trait] as number) * 100)
        };
      }
      return base;
    });
  }, [allTraits, comparing, compareResult]);

  const insights = useMemo(() => {
    if (!selectedResult) return [];
    const entries = Object.entries(selectedResult.domain_scores) as [string, number][];
    const sorted = [...entries].sort(([, a], [, b]) => b - a);
    const strongest = sorted[0];
    const weakest = sorted[sorted.length - 1];
    const avg = entries.reduce((sum, [, v]) => sum + v, 0) / entries.length;

    const list: { icon: typeof TrendingUp; text: string }[] = [];
    list.push({ icon: TrendingUp, text: `Your strongest domain is ${formatDomainLabel(strongest[0])} at ${Math.round(strongest[1] * 100)}%.` });
    list.push({ icon: TrendingDown, text: `${formatDomainLabel(weakest[0])} is your area for growth at ${Math.round(weakest[1] * 100)}%.` });
    list.push({ icon: Minus, text: `Your average domain score is ${Math.round(avg * 100)}%.` });

    if (allRoles.length > 0) {
      list.push({ icon: TrendingUp, text: `Best role match: ${allRoles[0].role} (${Math.round(allRoles[0].score * 100)}% fit).` });
    }
    return list;
  }, [selectedResult, allRoles]);

  const pdfRoles = useMemo(
    () => allRoles.filter(r => r.score > 0),
    [allRoles]
  );

  const topDriverTraits = useMemo(() => allTraits.slice(0, 3), [allTraits]);
  const bottomDriverTraits = useMemo(() => allTraits.slice(-3), [allTraits]);

  const printableProps = useMemo(() => {
    if (!selectedResult) return null;
    return {
      candidateName: user?.user_metadata?.full_name || user?.email || 'Candidate',
      candidateEmail: user?.email,
      date: new Date(selectedResult.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }),
      topRole: allRoles[0]?.role || 'Unknown',
      topRoleScore: allRoles[0]?.score ? allRoles[0].score * 100 : 0,
      readinessLabel: getReadiness(selectedResult.average_score).label,
      insights: insights.map(i => ({ text: i.text })),
      domains: radarData,
      topTraits: allTraits,
      topDriverTraits,
      bottomDriverTraits,
      traits: allTraits,
      roles: pdfRoles,
      customRoles: exportCustomRoles,
      deepInsights: exportDeepInsights,
      country: 'India',
    };
  }, [selectedResult, user, allRoles, insights, radarData, allTraits, topDriverTraits, bottomDriverTraits, pdfRoles, exportCustomRoles, exportDeepInsights]);

  const handleExportPDF = async () => {
    if (!printableRef.current || !selectedResult) return;
    setIsPdfLoading(true);
    try {
      let customRoles: IPrintableCustomRole[] | null = null;
      let deepInsights: IPrintableDeepInsights | null = null;
      try {
        const [customRolesRes, deepInsightsRes] = await Promise.all([
          (supabase as unknown as Record<string, unknown>)
            .from('ai_insights')
            .select('data')
            .eq('session_id', selectedResult.session_id)
            .eq('insight_type', 'custom_roles')
            .eq('country', 'India')
            .maybeSingle(),
          (supabase as unknown as Record<string, unknown>)
            .from('ai_insights')
            .select('data')
            .eq('session_id', selectedResult.session_id)
            .eq('insight_type', 'deep_insights')
            .maybeSingle(),
        ]);
        if (customRolesRes.data?.data) {
          customRoles = customRolesRes.data.data as IPrintableCustomRole[];
        }
        if (deepInsightsRes.data?.data) {
          deepInsights = deepInsightsRes.data.data as IPrintableDeepInsights;
        }
      } catch {
        // AI insights are optional for PDF export
      }
      flushSync(() => {
        setExportCustomRoles(customRoles);
        setExportDeepInsights(deepInsights);
      });
      await new Promise(resolve => setTimeout(resolve, 200));
      await generatePDFReport(printableRef.current);
    } catch (e) {
      console.error('PDF export failed:', e);
    }
    setIsPdfLoading(false);
  };

  if (history.length === 0) {
    return (
      <AppLayout>

      {printableProps && (
        <div style={{ position: 'absolute', left: '-9999px', top: '-9999px' }}>
          <PrintableReport ref={printableRef} {...printableProps} />
        </div>
      )}
<div className="max-w-3xl mx-auto text-center py-20 space-y-6">
          <h1 className="text-3xl font-semibold tracking-tight">No Results Yet</h1>
          <p className="text-muted-foreground">Complete an assessment to view your detailed results here.</p>
          <Button onClick={() => navigate('/assessment')}>Take Assessment</Button>
        </div>
      </AppLayout>
    );
  }

  return (
    <AppLayout>

      {printableProps && (
        <div style={{ position: 'absolute', left: '-9999px', top: '-9999px' }}>
          <PrintableReport ref={printableRef} {...printableProps} />
        </div>
      )}
<div className="max-w-5xl mx-auto space-y-8 pb-12">
        {/* Header */}
        <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div className="flex items-center gap-3">
            <Button variant="ghost" size="icon" onClick={() => navigate('/dashboard')}>
              <ArrowLeft className="h-4 w-4" />
            </Button>
            <div>
              <h1 className="text-2xl font-bold tracking-tight">Assessment Results</h1>
              <p className="text-sm text-muted-foreground mt-1">
                {selectedResult && new Date(selectedResult.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
            </div>
          </div>
          <div className="flex items-center gap-2 flex-wrap">
            <Button variant="outline" size="sm" onClick={handleExportPDF} disabled={isPdfLoading}>
              <Download className="h-4 w-4 mr-2" />
              {isPdfLoading ? 'Generating...' : 'Export PDF'}
            </Button>
            {history.length > 1 && (
              <>
                <Select value={selectedResultId} onValueChange={setSelectedResultId}>
                  <SelectTrigger className="w-52 bg-background">
                    <SelectValue placeholder="Select assessment" />
                  </SelectTrigger>
                  <SelectContent>
                    {history.map((h, i) => (
                      <SelectItem key={h.session_id} value={h.session_id}>
                        #{history.length - i} — {new Date(h.date).toLocaleDateString()}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
                <Button
                  variant={comparing ? 'default' : 'outline'}
                  size="sm"
                  onClick={() => {
                    setComparing(!comparing);
                    if (!compareId && history.length > 1) {
                      const other = history.find(h => h.session_id !== selectedResultId);
                      if (other) setCompareId(other.session_id);
                    }
                  }}
                >
                  <GitCompareArrows className="h-4 w-4 mr-2" />
                  Compare
                </Button>
              </>
            )}
          </div>
        </div>

        {/* Comparison Selector */}
        {comparing && history.length > 1 && (
          <div className="flex items-center gap-3 p-3 rounded-none terminal-border bg-muted/50 border">
            <span className="text-sm font-medium">Compare with:</span>
            <Select value={compareId} onValueChange={setCompareId}>
              <SelectTrigger className="w-52 bg-background">
                <SelectValue placeholder="Select assessment" />
              </SelectTrigger>
              <SelectContent>
                {history.filter(h => h.session_id !== selectedResultId).map((h, i) => (
                  <SelectItem key={h.session_id} value={h.session_id}>
                    #{history.length - history.indexOf(h)} — {new Date(h.date).toLocaleDateString()}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
        )}

        {/* Insights Strip */}
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {insights.map((insight, i) => (
            <div key={i} className="rounded-none terminal-border border bg-card p-4 flex items-start gap-3">
              <insight.icon className="h-5 w-5 text-primary mt-0.5 shrink-0" />
              <p className="text-sm text-foreground">{insight.text}</p>
            </div>
          ))}
        </div>

        {/* Domain Radar + Trait Bar Charts */}
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div className="border border-white/20 bg-[#050505] p-6 text-white shadow-[0_0_15px_rgba(255,166,0,0.1)]">
            <div className="flex justify-between items-end border-b border-[#FFA600]/30 pb-4 mb-6">
              <div>
                <div className="text-[#FFA600] text-xs mb-1 tracking-widest">SYSTEM.METRICS</div>
                <h2 className="text-2xl font-black tracking-tighter uppercase">Domain Profile</h2>
              </div>
              <Badge className="bg-white text-black hover:bg-white rounded-none uppercase text-xs">Data Center</Badge>
            </div>

            <div className="flex flex-col h-[320px]">
              <ResponsiveContainer width="100%" height="100%">
                <RadarChart data={radarData}>
                  <PolarGrid stroke="rgba(255,255,255,0.1)" />
                  <PolarAngleAxis dataKey="domain" tick={{ fill: 'rgba(255,255,255,0.7)', fontSize: 10 }} />
                  <PolarRadiusAxis domain={[0, 100]} tick={false} axisLine={false} />
                  <Radar name="Current" dataKey="score" stroke="#FFA600" strokeWidth={2} fill="#FFA600" fillOpacity={0.05} />
                  {compareResult && (
                    <Radar name="Comparison" dataKey="compare" stroke="rgba(255,255,255,0.4)" fill="rgba(255,255,255,0.4)" fillOpacity={0.05} strokeDasharray="3 3" />
                  )}
                  <Tooltip contentStyle={{ backgroundColor: '#000', borderColor: '#FFA600', color: '#fff', borderRadius: 0 }} />
                  {compareResult && <Legend wrapperStyle={{ fontSize: '12px' }} />}
                </RadarChart>
              </ResponsiveContainer>
            </div>
          </div>

          <div className="rounded-none terminal-border border bg-card p-6">
            <h2 className="text-lg font-semibold mb-4">Top 10 Traits</h2>
            <ResponsiveContainer width="100%" height={320}>
              <BarChart data={traitBarData} layout="vertical" margin={{ left: 20 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="hsl(var(--border))" />
                <XAxis type="number" domain={[0, 100]} tick={{ fontSize: 11 }} />
                <YAxis dataKey="name" type="category" tick={{ fontSize: 11 }} width={120} />
                <Tooltip />
                <Bar dataKey="score" name="Current" radius={[0, 4, 4, 0]}>
                  {traitBarData.map((entry, idx) => (
                    <Cell key={idx} fill={getScoreColor(entry.score / 100)} />
                  ))}
                </Bar>
                {comparing && compareResult && (
                  <Bar dataKey="compareScore" name="Previous" fill="hsl(var(--muted-foreground))" fillOpacity={0.3} radius={[0, 4, 4, 0]} />
                )}
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>

        {/* Delta Table (Comparison) */}
        {comparing && compareResult && deltaData.length > 0 && (
          <div className="rounded-none terminal-border border bg-card p-6">
            <h2 className="text-lg font-semibold mb-4">Score Changes</h2>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {deltaData.map(d => (
                <div key={d.domain} className="flex items-center justify-between px-4 py-3 rounded-none terminal-border border">
                  <div>
                    <p className="text-sm font-medium">{d.domain}</p>
                    <p className="text-xs text-muted-foreground">{d.previous}% → {d.current}%</p>
                  </div>
                  <div className={`flex items-center gap-1 text-sm font-semibold ${d.delta > 0 ? 'text-primary' : d.delta < 0 ? 'text-destructive' : 'text-muted-foreground'}`}>
                    {d.delta > 0 ? <ArrowUpRight className="h-4 w-4" /> : d.delta < 0 ? <ArrowDownRight className="h-4 w-4" /> : null}
                    {d.delta > 0 ? '+' : ''}{d.delta}%
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* All Domain Scores as cards */}
        <div>
          <h2 className="text-lg font-semibold mb-4">Domain Breakdown</h2>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {selectedResult && Object.entries(selectedResult.domain_scores).map(([key, val]) => {
              const score = val as number;
              const readiness = getReadiness(score);
              return (
                <div key={key} className="rounded-none terminal-border border bg-card p-5 space-y-3">
                  <div className="flex justify-between items-center">
                    <h3 className="font-medium text-sm">{formatDomainLabel(key)}</h3>
                    <Badge variant={readiness.variant}>{readiness.label}</Badge>
                  </div>
                  <div className="flex items-end gap-2">
                    <span className="text-3xl font-bold">{Math.round(score * 100)}</span>
                    <span className="text-muted-foreground text-sm mb-1">/ 100</span>
                  </div>
                  <Progress value={score * 100} className="h-2" />
                </div>
              );
            })}
          </div>
        </div>

        {/* Role Fit — Searchable + Clickable */}
        <div className="rounded-none terminal-border border bg-card p-6 space-y-4">
          <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <h2 className="text-lg font-semibold">Role Fit Scores</h2>
            <div className="relative w-full sm:w-72">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
              <Input
                placeholder="Search roles..."
                value={roleSearch}
                onChange={e => setRoleSearch(e.target.value)}
                className="pl-9"
              />
            </div>
          </div>
          <div className="space-y-3 max-h-[400px] overflow-y-auto pr-1">
            {filteredRoles.length === 0 ? (
              <p className="text-sm text-muted-foreground text-center py-6">No roles match your search.</p>
            ) : (
              filteredRoles.map(({ role, score, compareScore }, idx) => {
                const readiness = getReadiness(score);
                const delta = compareScore !== undefined ? Math.round((score - compareScore) * 100) : null;
                return (
                  <div
                    key={role}
                    className="flex items-center gap-4 cursor-pointer hover:bg-muted/50 rounded-none terminal-border p-2 -m-1 transition-colors"
                    onClick={() => setDeepDiveRole(role)}
                  >
                    <span className="text-xs text-muted-foreground w-6 text-right shrink-0">#{idx + 1}</span>
                    <div className="flex-1 space-y-2">
                      <div className="flex justify-between items-center text-sm">
                        <span className="font-medium">{role}</span>
                        <div className="flex items-center gap-3">
                          {delta !== null && (
                             <span className={`text-xs font-bold ${delta > 0 ? 'text-primary' : delta < 0 ? 'text-destructive' : 'text-muted-foreground'}`}>
                               {delta > 0 ? '+' : ''}{delta}%
                             </span>
                          )}
                          <Badge variant={readiness.variant} className="text-xs">{readiness.label}</Badge>
                          <span className="text-primary font-semibold w-10 text-right">{Math.round(score * 100)}%</span>
                        </div>
                      </div>
                      <div className="relative h-1.5 w-full bg-secondary overflow-hidden rounded-full">
                        {compareScore !== undefined && (
                           <div className="absolute top-0 left-0 h-full bg-muted-foreground/30 z-0" style={{ width: `${compareScore * 100}%` }}></div>
                        )}
                        <div className="absolute top-0 left-0 h-full bg-primary z-10 transition-all" style={{ width: `${score * 100}%` }}></div>
                      </div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>

        {/* All Traits table */}
        <div className="rounded-none terminal-border border bg-card p-8 space-y-6">
          <h2 className="text-xl font-semibold border-b border-border pb-2">All Trait Scores</h2>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-h-[500px] overflow-y-auto pr-2">
            {allTraits.map(({ trait, score }) => {
              const compareScore = comparing && compareResult && compareResult.trait_scores[trait]
                 ? compareResult.trait_scores[trait] as number
                 : undefined;
              const delta = compareScore !== undefined ? Math.round((score - compareScore) * 100) : null;

              return (
                <div key={trait} className="flex items-center justify-between px-3 py-2 rounded-none terminal-border bg-muted/50">
                  <span className="text-sm capitalize truncate pr-2" title={trait.replace(/_/g, ' ')}>{trait.replace(/_/g, ' ')}</span>
                  <div className="flex items-center gap-3 shrink-0">
                    {delta !== null && (
                      <span className={`text-xs font-bold ${delta > 0 ? 'text-primary' : delta < 0 ? 'text-destructive' : 'text-muted-foreground'}`}>
                        {delta > 0 ? '+' : ''}{delta}%
                      </span>
                    )}
                    <span className="text-sm font-semibold w-9 text-right" style={{ color: getScoreColor(score) }}>
                      {Math.round(score * 100)}%
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* AI Enhanced Custom Roles */}
        {selectedResult && (
          <AIEnhancedResults
            sessionId={selectedResult.session_id}
            profile={selectedResult.trait_scores}
            archetypes={filteredRoles}
          />
        )}
      </div>

      {/* Role Deep Dive */}
      {selectedResult && deepDiveRole && (
        <RoleDeepDive
          open={!!deepDiveRole}
          onOpenChange={(open) => !open && setDeepDiveRole(null)}
          roleName={deepDiveRole}
          traitScores={selectedResult.trait_scores}
          domainScores={selectedResult.domain_scores}
          roleScore={(selectedResult.role_scores[deepDiveRole] as number) || 0}
        />
      )}

      {/* AI Career Coach */}
      {selectedResult && (
        <CareerCoach
          context={{
            domain_scores: selectedResult.domain_scores,
            trait_scores: selectedResult.trait_scores,
            role_scores: selectedResult.role_scores,
          }}
        />
      )}
    </AppLayout>
  );
};

export default Results;
</file>

