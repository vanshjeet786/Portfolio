import { useState } from 'react';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter, DialogDescription } from '@/components/ui/dialog';
import { Button } from '@/components/ui/button';
import { Checkbox } from '@/components/ui/checkbox';
import { Label } from '@/components/ui/label';

interface AdvancedExportModalProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  onExport: (options: { summary: boolean; radar: boolean; roles: boolean; traits: boolean }) => void;
  candidateCount: number;
  isExporting: boolean;
}

export function AdvancedExportModal({ open, onOpenChange, onExport, candidateCount, isExporting }: AdvancedExportModalProps) {
  const [options, setOptions] = useState({
    summary: true,
    radar: true,
    roles: true,
    traits: true,
  });

  const handleToggle = (key: keyof typeof options) => {
    setOptions(prev => ({ ...prev, [key]: !prev[key] }));
  };

  const handleExport = () => {
    onExport(options);
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-[425px] rounded-none terminal-border">
        <DialogHeader>
          <DialogTitle>Advanced PDF Export</DialogTitle>
          <DialogDescription>
            Select the sections to include in the exported PDFs for the {candidateCount} selected candidate{candidateCount !== 1 ? 's' : ''}.
          </DialogDescription>
        </DialogHeader>
        <div className="grid gap-4 py-4">
          <div className="flex items-center space-x-2">
            <Checkbox id="opt-summary" checked={options.summary} onCheckedChange={() => handleToggle('summary')} />
            <Label htmlFor="opt-summary" className="text-sm font-medium leading-none cursor-pointer">Summary Table</Label>
          </div>
          <div className="flex items-center space-x-2">
            <Checkbox id="opt-radar" checked={options.radar} onCheckedChange={() => handleToggle('radar')} />
            <Label htmlFor="opt-radar" className="text-sm font-medium leading-none cursor-pointer">Domain Scores</Label>
          </div>
          <div className="flex items-center space-x-2">
            <Checkbox id="opt-roles" checked={options.roles} onCheckedChange={() => handleToggle('roles')} />
            <Label htmlFor="opt-roles" className="text-sm font-medium leading-none cursor-pointer">Top Role Matches</Label>
          </div>
          <div className="flex items-center space-x-2">
            <Checkbox id="opt-traits" checked={options.traits} onCheckedChange={() => handleToggle('traits')} />
            <Label htmlFor="opt-traits" className="text-sm font-medium leading-none cursor-pointer">Full Trait Scores</Label>
          </div>
        </div>
        <DialogFooter>
          <Button variant="outline" onClick={() => onOpenChange(false)} disabled={isExporting}>
            Cancel
          </Button>
          <Button onClick={handleExport} disabled={isExporting}>
            {isExporting ? 'Exporting...' : `Download ${candidateCount} PDF${candidateCount !== 1 ? 's' : ''} (.zip)`}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
