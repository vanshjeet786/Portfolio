import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
import { shuffle } from "./questions";

describe("shuffle", () => {
  it("should return an empty array when given an empty array", () => {
    const input: number[] = [];
    const result = shuffle(input);
    expect(result).toEqual([]);
    expect(result).not.toBe(input); // Should be a new array
  });

  it("should return a new array with the same single element", () => {
    const input = [42];
    const result = shuffle(input);
    expect(result).toEqual([42]);
    expect(result).not.toBe(input); // Should be a new array
  });

  it("should not mutate the original array", () => {
    const input = [1, 2, 3, 4, 5];
    const inputCopy = [...input];
    shuffle(input);
    expect(input).toEqual(inputCopy);
  });

  it("should contain all original elements", () => {
    const input = [1, 2, 3, 4, 5];
    const result = shuffle(input);
    expect(result).toHaveLength(input.length);
    expect(result.sort()).toEqual(input.sort());
  });

  describe("deterministic shuffle with mocked crypto.getRandomValues", () => {
    let cryptoSpy: import("vitest").MockInstance;

    beforeEach(() => {
      cryptoSpy = vi.spyOn(crypto, 'getRandomValues');
    });

    afterEach(() => {
      cryptoSpy.mockRestore();
    });

    it("should shuffle predictably based on crypto.getRandomValues values", () => {
      const input = [1, 2, 3];

      let callCount = 0;
      cryptoSpy.mockImplementation((arr: Uint32Array) => {
          if (callCount === 0) arr[0] = 0; // i=2, j=floor(0 * 3) = 0. Swap arr[2], arr[0] -> [3, 2, 1]
          else arr[0] = 2147483648; // i=1, j=floor(0.5 * 2) = 1. Swap arr[1], arr[1] -> [3, 2, 1]
          callCount++;
          return arr;
      });

      const result = shuffle(input);
      expect(result).toEqual([3, 2, 1]);
    });
  });

  it("should handle different types of elements", () => {
    const input = [{ a: 1 }, { b: 2 }, { c: 3 }];
    const result = shuffle(input);
    expect(result).toHaveLength(3);
    expect(result).toContain(input[0]);
