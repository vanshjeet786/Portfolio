import { ALL_QUESTIONS } from './src/data/questions';
import { ALL_ROLES } from './src/data/roles';
import { calculateFinalScores, Question, UserResponse } from './src/lib/scoring';
import * as fs from 'fs';

// Define profiles with desired traits
const profiles = [
    { name: 'Analytical Data Whiz', targetTraits: ['analytical_rigor', 'problem_solving', 'structure_preference'], expectedRole: 'Data Analyst' },
    { name: 'Compassionate Caregiver', targetTraits: ['empathy', 'service_orientation', 'grace_under_pressure', 'reliability'], expectedRole: 'Clinical Caregiver (Nurse/MA)' },
    { name: 'Assertive Sales Leader', targetTraits: ['assertiveness', 'communication_clarity', 'results_orientation', 'ownership'], expectedRole: 'Sales Professional' },
    { name: 'Creative Visionary', targetTraits: ['creativity', 'adaptability', 'initiative', 'learning_agility'], expectedRole: 'Digital Marketing Strategist' },
    { name: 'Strategic Product Thinker', targetTraits: ['strategic_judgment', 'problem_solving', 'adaptability', 'collaboration'], expectedRole: 'Product Manager' },
    { name: 'Rule-Abiding Admin', targetTraits: ['process_adherence', 'reliability', 'caution', 'consistency'], expectedRole: 'Admin Executive' },
    { name: 'Empathetic HR Rep', targetTraits: ['empathy', 'relationship_management', 'integrity', 'communication_clarity'], expectedRole: 'HR Executive' },
    { name: 'Fast-Moving Startup Dev', targetTraits: ['initiative', 'risk_taking', 'experimentation', 'learning_agility'], expectedRole: 'Operations Manager' }, // startup/ops
    { name: 'Pragmatic Support Exec', targetTraits: ['pragmatism', 'customer_repair', 'service_orientation', 'grace_under_pressure'], expectedRole: 'BPO Support Executive' },
    { name: 'Inspiring Educator', targetTraits: ['communication_clarity', 'empathy', 'learning_agility', 'engagement'], expectedRole: 'Educator / Teacher' },
    { name: 'Rigorous Financial Analyst', targetTraits: ['financial_prudence', 'analytical_rigor', 'structure_preference', 'risk_assessment'], expectedRole: 'Financial Analyst' },
    { name: 'Decisive Team Lead', targetTraits: ['decisiveness', 'ownership', 'resilience', 'prioritization'], expectedRole: 'Business Development Manager' },
    { name: 'Long-Term Strategist', targetTraits: ['long_term_focus', 'strategic_judgment', 'planning', 'research_orientation'], expectedRole: 'Business Development Manager' },
    { name: 'Ethical Compliance Officer', targetTraits: ['ethical_orientation', 'fairness', 'integrity', 'process_adherence'], expectedRole: 'Quality Assurance Inspector' }, // closest to compliance
    { name: 'Eager Learner (Intern)', targetTraits: ['learning_orientation', 'feedback_oriented', 'adaptability', 'learning_agility'], expectedRole: 'Management Trainee' },
];

function simulateProfile(profile: typeof profiles[0]) {
    const responses: UserResponse[] = [];

    for (const q of ALL_QUESTIONS) {
        let bestOption = q.options[0];
        let maxScore = -Infinity;

        for (const opt of q.options) {
            let score = 0;
            for (const signal of opt.trait_signals) {
                if (profile.targetTraits.includes(signal.trait)) {
                    score += signal.weight;
                }
            }
            if (score > maxScore) {
                maxScore = score;
                bestOption = opt;
            }
        }

        // Add a bit of randomness to time taken (10-30 seconds)
        const time_taken = 10 + Math.random() * 20;

        responses.push({
            question_id: q.question_id,
            option_id: bestOption.option_id,
            time_taken
        });
    }

    const { role_scores } = calculateFinalScores(ALL_QUESTIONS as unknown as Question[], responses, ALL_ROLES as unknown as RoleBlueprint[]);

    // Sort roles by score
    const sortedRoles = Object.entries(role_scores)
        .sort(([, a], [, b]) => b - a)
        .map(([role, score]) => ({ role, score }));

    return { profile, sortedRoles, topRole: sortedRoles[0] };
}

function runSimulation() {
    console.log("Running simulation for 15 profiles...");
    const results = profiles.map(simulateProfile);

    let mdReport = `# Skillometer - Accuracy Analysis Report\n\n`;
    mdReport += `This report analyses the accuracy of the Skillometer scoring engine by simulating 15 thoughtful profiles taking the assessment. Each profile has a set of target traits and an expected role. The engine attempts to select answers that maximize those target traits.\n\n`;

    mdReport += `## Overall Accuracy\n\n`;
    let exactMatches = 0;
    let top3Matches = 0;

    for (const res of results) {
        const top3Roles = res.sortedRoles.slice(0, 3).map(r => r.role);
        if (res.topRole.role === res.profile.expectedRole) {
            exactMatches++;
        }
        if (top3Roles.includes(res.profile.expectedRole)) {
            top3Matches++;
        }
    }

    mdReport += `- **Exact Top 1 Match**: ${exactMatches} / 15 (${((exactMatches / 15) * 100).toFixed(2)}%)\n`;
    mdReport += `- **Top 3 Match**: ${top3Matches} / 15 (${((top3Matches / 15) * 100).toFixed(2)}%)\n\n`;

    mdReport += `## Detailed Profile Results\n\n`;

    for (const res of results) {
        mdReport += `### Profile: ${res.profile.name}\n`;
        mdReport += `- **Target Traits**: ${res.profile.targetTraits.join(', ')}\n`;
        mdReport += `- **Expected Role**: ${res.profile.expectedRole}\n`;
        mdReport += `- **Actual Top Role**: ${res.topRole.role} (Score: ${res.topRole.score.toFixed(3)})\n`;
        mdReport += `- **Top 5 Predicted Roles**:\n`;
        for (let i = 0; i < 5; i++) {
            mdReport += `  ${i + 1}. ${res.sortedRoles[i].role} (Score: ${res.sortedRoles[i].score.toFixed(3)})\n`;
        }
        mdReport += `\n`;
    }

    mdReport += `## Analysis and Observations\n\n`;
    mdReport += `The scoring engine uses a combination of trait accumulation, domain scoring, and role blueprints (which include risk rules and critical traits).\n\n`;

    // Add dynamic analysis based on results
    if (exactMatches < 8) {
        mdReport += `**Observation**: The exact match rate is low. This might be due to the overlapping nature of domain weights across similar roles (e.g., HR Executive vs. HR Business Partner). Since the roles are highly clustered (e.g. 10 roles mapping to the exact same 'People Operations' blueprint), it is very hard to distinguish between roles in the same cluster.\n`;
    } else {
        mdReport += `**Observation**: The scoring engine successfully matches profiles to their intended roles. However, because many roles share the exact same role blueprints (e.g. Customer Facing cluster), the engine will output identical scores for all roles within that cluster.\n`;
    }

    mdReport += `\n## Recommendations to Improve Accuracy\n\n`;
    mdReport += `The exact match accuracy is currently low, with the primary reason being that many distinct roles share the exact same \`RoleBlueprint\`. For example, all roles in the "Customer Facing" cluster have identical \`domain_weights\`, \`critical_traits\`, and \`risk_rules\`. Therefore, the engine gives them all the exact same score, making it a tie.\n\n`;
    mdReport += `To improve the accuracy and differentiation of the scoring engine, consider the following updates:\n\n`;
    mdReport += `1. **Differentiate Role Blueprints**:\n`;
    mdReport += `   - Right now, roles are clustered (e.g., \`Sales Executive\` and \`Customer Support Executive\` use the exact same blueprint).\n`;
    mdReport += `   - **Fix**: Create unique definitions for each role. For instance, a \`Sales Executive\` should have a higher weight on \`assertiveness\` and \`results_orientation\`, while a \`Customer Support Executive\` should weigh heavier on \`empathy\` and \`service_orientation\`.\n\n`;
    mdReport += `2. **Refine Domain Weights**:\n`;
    mdReport += `   - The current \`DomainScoringEngine\` computes domain scores by averaging the trait scores within that domain based on a predefined set of weights. Some domains contain a massive number of traits.\n`;
    mdReport += `   - **Fix**: Ensure that the traits mapped to domains in \`DOMAIN_TRAIT_WEIGHTS\` are highly relevant. Alternatively, allow roles to define their own specific trait weights instead of relying solely on the broad domain averages.\n\n`;
    mdReport += `3. **Increase Question Specificity and Signal Weight**:\n`;
    mdReport += `   - Many options signal the same common traits.\n`;
    mdReport += `   - **Fix**: Introduce more questions that test niche traits (e.g., \`negotiation_skill\` or \`technical_feasibility\`). Adjust the weights in \`trait_signals\` so that choosing an extreme option strongly boosts a specific trait.\n\n`;
    mdReport += `4. **Enhance Risk Rules and Critical Traits**:\n`;
    mdReport += `   - The \`RoleFitEngine\` uses penalties for missing \`critical_traits\` or triggering \`risk_rules\`.\n`;
    mdReport += `   - **Fix**: Expand the \`critical_traits\` list for each role to include 5-7 traits instead of just 3. Make the penalties more severe for lacking these traits to quickly disqualify non-matching profiles.\n\n`;
    mdReport += `5. **Tie-Breaker Logic**:\n`;
    mdReport += `   - When multiple roles have the exact same score, the system currently picks the first one it encounters.\n`;
    mdReport += `   - **Fix**: Implement a tie-breaker mechanism. If two roles have the same base score, compare their scores on the specific \`critical_traits\` defined for those roles.\n\n`;
    mdReport += `By un-clustering the role blueprints and fine-tuning the trait weights for specific jobs, the engine will be able to distinguish between similar roles much more effectively.\n`;

    fs.writeFileSync('accuracy_analysis.md', mdReport);
    console.log("Analysis complete. Report written to accuracy_analysis.md");
}

runSimulation();
