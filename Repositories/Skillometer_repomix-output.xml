import { TerminalLoader } from "@/components/TerminalLoader";
import { useState, useEffect } from 'react';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Button } from '@/components/ui/button';
import { Sparkles, Loader2, MapPin, Brain, RefreshCw } from 'lucide-react';
import { toast } from '@/hooks/use-toast';
import { AIInsightsModal } from './AIInsightsModal';
import { supabase } from '@/integrations/supabase/client';

const COUNTRIES = [
  "India", "United States", "United Kingdom", "Canada", "Australia",
  "Germany", "France", "Japan", "Singapore", "United Arab Emirates",
  "Brazil", "Mexico", "South Africa", "Netherlands", "Sweden",
  "Switzerland", "New Zealand", "Ireland", "Spain", "Italy"
];

interface AIEnhancedResultsProps {
  sessionId: string;
  profile: Record<string, number>;
  archetypes: { role: string, score: number }[];
}

interface CustomRole {
  role_name: string;
  description: string;
  match_score: number;
  critical_traits: string[];
}

export function AIEnhancedResults({ sessionId, profile, archetypes }: AIEnhancedResultsProps) {
  const [country, setCountry] = useState('India');
  const [isGenerating, setIsGenerating] = useState(false);
  const [customRoles, setCustomRoles] = useState<CustomRole[] | null>(null);
  const [isModalOpen, setIsModalOpen] = useState(false);

  const generateRoles = async (forceRegenerate = false) => {
    setIsGenerating(true);
    setCustomRoles(null);
    try {
      if (!forceRegenerate) {
        const { data: existingRoles, error } = await (supabase as unknown as Record<string, unknown>)
          .from('ai_insights')
          .select('data')
          .eq('session_id', sessionId)
          .eq('insight_type', 'custom_roles')
          .eq('country', country)
          .maybeSingle();

        if (existingRoles) {
          setCustomRoles(existingRoles.data as unknown as CustomRole[]);
          setIsGenerating(false);
          return;
        }
      }

      const resp = await fetch(`${import.meta.env.VITE_SUPABASE_URL}/functions/v1/generate-custom-roles`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY}`,
        },
        body: JSON.stringify({
          profile,
          archetypes: archetypes.slice(0, 5),
          country
        }),
      });

      if (!resp.ok) throw new Error("Failed to generate custom roles");

      const data = await resp.json();
      setCustomRoles(data.custom_roles);

      // Save to Supabase
      const { error: upsertError } = await (supabase as unknown as Record<string, unknown>)
        .from('ai_insights')
        .upsert({
          session_id: sessionId,
          insight_type: 'custom_roles',
          country: country,
          data: data.custom_roles
        }, {
          onConflict: 'session_id,insight_type,country'
        });

      if (upsertError) {
        console.error("Failed to save AI custom roles to database", upsertError);
      }

    } catch (error) {
      console.error(error);
      toast({ title: "Generation failed", description: "Could not generate AI roles. Please try again.", variant: "destructive" });
    }
    setIsGenerating(false);
  };

  useEffect(() => {
    // Generate on mount or country change
    generateRoles();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [country]);

  return (
    <div className="border border-white/20 bg-[#050505] p-8 space-y-10 mt-8 font-mono text-white shadow-[0_0_15px_rgba(255,166,0,0.1)]">
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-end border-b border-[#FFA600]/30 pb-4 gap-6">
        <div>
          <div className="text-[#FFA600] text-xs mb-2 tracking-widest uppercase">SYSTEM.MODULE.AI_RESULTS</div>
          <h2 className="text-3xl font-black tracking-tighter uppercase">Market Fit Analysis</h2>
        </div>

        <div className="flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <Select value={country} onValueChange={setCountry} disabled={isGenerating}>
            <SelectTrigger className="w-full sm:w-[140px] bg-transparent border-b border-white/30 border-t-0 border-l-0 border-r-0 text-white rounded-none focus:ring-0 px-0 h-8 uppercase">
              <SelectValue placeholder="Select Country" />
            </SelectTrigger>
            <SelectContent className="bg-black border-white text-white rounded-none">
              {COUNTRIES.map(c => (
                <SelectItem key={c} value={c} className="uppercase">{c}</SelectItem>
              ))}
            </SelectContent>
          </Select>
          <Button
            variant="ghost"
            size="icon"
            disabled={isGenerating}
            onClick={() => generateRoles(true)}
            className="text-white hover:text-[#FFA600] hover:bg-transparent rounded-none h-8 w-8"
            title="Regenerate custom roles for this country"
          >
            <RefreshCw className={`h-4 w-4 ${isGenerating ? 'animate-spin' : ''}`} />
          </Button>
          <div className="h-6 w-px bg-white/20 mx-2 hidden sm:block"></div>
          <Button
            className="w-full sm:w-auto bg-[#FFA600] text-black hover:bg-white hover:text-black border-0 rounded-none h-8 text-xs font-bold px-4"
            onClick={() => setIsModalOpen(true)}
          >
            [ DEEP DIVE ]
          </Button>
        </div>
      </div>

      <AIInsightsModal
        sessionId={sessionId}
        open={isModalOpen}
        onOpenChange={setIsModalOpen}
        profile={profile}
        archetypes={archetypes}
      />

      {isGenerating ? (
        <div className="flex flex-col items-center justify-center py-12 space-y-4">
          <TerminalLoader className="text-lg" />
          <p className="text-sm text-white/60 tracking-widest uppercase">Analyzing your profile against the {country} market...</p>
        </div>
      ) : customRoles && customRoles.length > 0 ? (
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
          {customRoles.map((role, idx) => (
            <div key={idx} className="group relative border border-white/10 bg-black p-6 hover:border-[#FFA600]/50 transition-all duration-300">
              <div className="absolute top-0 right-0 p-2 text-3xl font-black text-white/5 group-hover:text-[#FFA600]/10 transition-colors">
                0{idx + 1}
              </div>

              <div className="flex items-center gap-3 mb-6">
                <div className="h-8 w-8 bg-white text-black flex items-center justify-center font-bold text-xs">
                  {Math.round(role.match_score * 100)}
                </div>
                <div className="text-xs tracking-widest text-white/50 uppercase">Match Score</div>
              </div>

              <h3 className="font-bold text-xl uppercase mb-4 min-h-[3.5rem]">{role.role_name}</h3>

              <p className="text-sm text-white/60 mb-8 min-h-[5rem]">
                {role.description}
              </p>

              <div className="space-y-2">
                {role.critical_traits.map(trait => (
                  <div key={trait} className="flex items-center gap-2 text-xs text-white/40">
                    <div className="h-px w-4 bg-[#FFA600]/50 shrink-0"></div>
                    <span className="uppercase">{trait.replace(/_/g, ' ')}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div className="text-center py-8 text-white/50 tracking-widest uppercase text-sm">
          No custom roles could be generated.
        </div>
      )}
    </div>
  );
}
</file>

<file path="src/components/AIInsightsModal.tsx">
import { TerminalLoader } from "@/components/TerminalLoader";
import { useState, useEffect, useMemo } from 'react';
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from '@/components/ui/dialog';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Sparkles, Activity, Target, BrainCircuit, Network, Briefcase, Zap, Loader2, LayoutDashboard, Search, ChevronRight, RefreshCw } from 'lucide-react';
import { toast } from '@/hooks/use-toast';
import { ScatterChart, Scatter, XAxis, YAxis, CartesianGrid, Tooltip as RechartsTooltip, ResponsiveContainer, Cell } from 'recharts';
import { supabase } from '@/integrations/supabase/client';


// --- Caching for Role Search ---
interface RoleAnalysisData {
  name: string;
  score: number;
  advantages: string[];
  frictions: string[];
}

const roleSearchCache = new Map<string, RoleAnalysisData>();
const MAX_CACHE_SIZE = 50;

function getCacheKey(sessionId: string, query: string) {
  return `${sessionId}_${query.trim().toLowerCase()}`;
}

function getFromCache(key: string): RoleAnalysisData | undefined {
  if (!roleSearchCache.has(key)) return undefined;

  // LRU behavior: remove and re-add to mark as recently used
  const data = roleSearchCache.get(key)!;
  roleSearchCache.delete(key);
  roleSearchCache.set(key, data);
  return data;
}

function addToCache(key: string, data: RoleAnalysisData) {
  if (roleSearchCache.size >= MAX_CACHE_SIZE) {
    // Remove the oldest entry (first item in Map iteration)
    const firstKey = roleSearchCache.keys().next().value;
    roleSearchCache.delete(firstKey);
  }
  roleSearchCache.set(key, data);
}
// -------------------------------


interface AIInsightsModalProps {
  sessionId: string;
  open: boolean;
  onOpenChange: (open: boolean) => void;
  profile: Record<string, number>;
  archetypes: { role: string; score: number }[];
}

interface DeepInsightsData {
  strengths_blind_spots: {
    top_drivers_note: string;
    blind_spots_note: string;
  };
  skill_gap: {
    target_role: string;
    action_plan: string[];
  };
  workplace_fit: {
    startup_match_percentage: number;
    corporate_match_percentage: number;
    autonomy_score: number; // For scatter plot (1-100)
    pace_score: number; // For scatter plot (1-100)
    environment_note: string;
  };
  leadership_potential: {
    index_score: number;
    style_name: string;
    description: string;
  };
  pivot_potential: { industry: string; transferable_percentage: number }[];
  decision_making: {
    primary_bias: { name: string; description: string };
    secondary_bias: { name: string; description: string };
  };
}

const SIDEBAR_ITEMS = [
  { id: 'overview', label: 'Overview', icon: LayoutDashboard },
  { id: 'strengths', label: 'Strengths & Blind Spots', icon: Target },
  { id: 'skill-gap', label: 'Skill Gap Analysis', icon: Activity },
  { id: 'pivot', label: 'Cross-Industry Pivot', icon: Briefcase },
  { id: 'leadership', label: 'Leadership Potential', icon: Zap },
];

export function AIInsightsModal({ sessionId, open, onOpenChange, profile, archetypes }: AIInsightsModalProps) {
  const [insights, setInsights] = useState<DeepInsightsData | null>(null);
  const [isLoading, setIsLoading] = useState(false);
  const [activeTab, setActiveTab] = useState('overview');
  const [roleSearchQuery, setRoleSearchQuery] = useState('');
  const [searchedRole, setSearchedRole] = useState<{
    name: string,
    score: number,
    advantages: string[],
    frictions: string[]
  } | null>(null);
  const [isSearchingRole, setIsSearchingRole] = useState(false);

  const fetchInsights = async (forceRegenerate = false) => {
    if ((insights && !forceRegenerate) || !open) return;

    setIsLoading(true);
    try {
      if (!forceRegenerate) {
        // Try to fetch from DB first
        const { data: existingInsight, error } = await (supabase as unknown as Record<string, unknown>)
          .from('ai_insights')
          .select('data')
          .eq('session_id', sessionId)
          .eq('insight_type', 'deep_insights')
          .maybeSingle();

        if (existingInsight) {
          setInsights(existingInsight.data as unknown as DeepInsightsData);
          setIsLoading(false);
          return;
        }
      }

      const resp = await fetch(`${import.meta.env.VITE_SUPABASE_URL}/functions/v1/generate-deep-insights`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY}`,
        },
        body: JSON.stringify({
          profile,
          archetypes: archetypes.slice(0, 5),
        }),
      });

      if (!resp.ok) throw new Error("Failed to generate deep insights");

      const data = await resp.json();
      setInsights(data.insights);

      // Save to Supabase
      const { error: upsertError } = await (supabase as unknown as Record<string, unknown>)
        .from('ai_insights')
        .upsert({
          session_id: sessionId,
          insight_type: 'deep_insights',
          country: 'global', // Set explicit country to 'global' to make the unique constraint work
          data: data.insights
        }, {
          onConflict: 'session_id,insight_type,country'
        });

      if (upsertError) {
        console.error("Failed to save AI insights to database", upsertError);
      }

    } catch (error) {
      console.error(error);
      toast({ title: "Generation failed", description: "Could not generate deep AI insights. Please try again.", variant: "destructive" });
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    if (open) {
      fetchInsights();
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [open]);

  const sortedTraits = useMemo(() => {
    return Object.entries(profile).sort(([, a], [, b]) => b - a);
  }, [profile]);

  const topTraits = sortedTraits.slice(0, 3);
  const bottomTraits = sortedTraits.slice(-3);

  const handleRoleSearch = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!roleSearchQuery.trim() || isSearchingRole) return;

    setIsSearchingRole(true);
    setSearchedRole(null);

    try {
      const cacheKey = getCacheKey(sessionId, roleSearchQuery);
      const cachedResult = getFromCache(cacheKey);

      if (cachedResult) {
        // Artificial delay for UX
        await new Promise(resolve => setTimeout(resolve, 300));
        setSearchedRole(cachedResult);
        return;
      }

      const resp = await fetch(`${import.meta.env.VITE_SUPABASE_URL}/functions/v1/analyze-role-fit`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY}`,
        },
        body: JSON.stringify({
          profile,
          role: roleSearchQuery,
        }),
      });

      if (!resp.ok) throw new Error("Failed to analyze role fit");

      const data = await resp.json();
      const resultData: RoleAnalysisData = {
        name: roleSearchQuery,
        score: data.analysis.compatibility_score,
        advantages: data.analysis.advantages,
        frictions: data.analysis.frictions
      };

      addToCache(cacheKey, resultData);
      setSearchedRole(resultData);
    } catch (error) {
      console.error(error);
      toast({ title: "Analysis failed", description: "Could not compute role compatibility. Please try again.", variant: "destructive" });
    } finally {
      setIsSearchingRole(false);
    }
  };

  // Environment Fit Scatter Plot Data
  const scatterData = useMemo(() => {
    if (!insights) return [];
    return [
      {
        x: insights.workplace_fit.autonomy_score,
