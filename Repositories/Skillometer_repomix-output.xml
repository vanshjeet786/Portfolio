import { supabase } from '@/integrations/supabase/client';
import type { OrgRole } from './authorization';

export interface Organization {
  id: string;
  name: string;
  slug: string;
  description: string | null;
  logo_url: string | null;
  created_by: string | null;
  created_at: string;
}

export interface OrgMember {
  id: string;
  user_id: string;
  org_id: string;
  role: OrgRole;
  created_at: string;
  profile?: { full_name: string | null; email: string };
}

export async function createOrganization(name: string, slug: string, description?: string): Promise<Organization | null> {
  let currentSlug = slug;
  let attempt = 0;
  const maxAttempts = 3;

  while (attempt < maxAttempts) {
    const { data: org, error } = await supabase.rpc('create_org_with_owner', {
      _name: name,
      _slug: currentSlug,
      _description: description || null,
    });

    if (error) {
      if (error.code === '23505' && error.message.includes('organizations_slug_key')) {
        // Duplicate slug, append random string and retry
        attempt++;
        const array = new Uint32Array(1);
        window.crypto.getRandomValues(array);
        currentSlug = `${slug}-${array[0].toString(36).substring(0, 4)}`;
        continue;
      }
      console.error('[createOrg]', error);
      return null;
    }

    return org as Organization;
  }

  console.error('[createOrg] Max retries reached for unique slug generation');
  return null;
}

export async function fetchOrganization(orgId: string): Promise<Organization | null> {
  const { data, error } = await supabase
    .from('organizations')
    .select('*')
    .eq('id', orgId)
    .maybeSingle();
  if (error) { console.error('[fetchOrg]', error); return null; }
  return data as Organization | null;
}

export async function updateOrganization(
  orgId: string,
  updates: Pick<Organization, 'name' | 'slug' | 'description' | 'logo_url'>
): Promise<Organization | null> {
  const { data, error } = await supabase
    .from('organizations')
    .update(updates)
    .eq('id', orgId)
    .select('*')
    .single();

  if (error) {
    console.error('[updateOrganization]', error);
    return null;
  }

  return data as Organization;
}

export async function deleteOrganization(orgId: string): Promise<boolean> {
  const { error } = await supabase
    .from('organizations')
    .delete()
    .eq('id', orgId);

  if (error) {
    console.error('[deleteOrganization]', error);
    return false;
  }

  return true;
}

export async function fetchOrgMembers(orgId: string): Promise<OrgMember[]> {
  const { data, error } = await supabase
    .from('org_memberships')
    .select('*')
    .eq('org_id', orgId)
    .order('created_at', { ascending: true });

  if (error) {
    console.error('[fetchOrgMembers]', error);
    return [];
  }

  const memberships = (data || []) as OrgMember[];
  const userIds = [...new Set(memberships.map(m => m.user_id).filter(Boolean))];

  const profileById = new Map<string, { full_name: string | null; email: string }>();
  if (userIds.length > 0) {
    const { data: profiles, error: profileError } = await supabase
      .from('profiles')
      .select('id, full_name, email')
      .in('id', userIds);

    if (profileError) {
      console.error('[fetchOrgMemberProfiles]', profileError);
    } else {
      for (const p of profiles || []) {
        profileById.set(p.id, { full_name: p.full_name, email: p.email });
      }
    }
  }

  return memberships.map((m) => ({
    ...m,
    profile: profileById.get(m.user_id),
  }));
}

export async function updateMemberRole(membershipId: string, role: OrgRole): Promise<boolean> {
  const { error } = await supabase
    .from('org_memberships')
    .update({ role })
    .eq('id', membershipId);
  if (error) { console.error('[updateMemberRole]', error); return false; }
  return true;
}

export async function removeMember(membershipId: string): Promise<boolean> {
  const { error } = await supabase
    .from('org_memberships')
    .delete()
    .eq('id', membershipId);
  if (error) { console.error('[removeMember]', error); return false; }
  return true;
}
