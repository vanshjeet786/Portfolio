<file path="src/pages/OrgDetail.tsx">
import { useState, useEffect } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { useAuth } from '@/contexts/AuthContext';
import { useOrg } from '@/contexts/OrgContext';
import { AppLayout } from '@/components/AppLayout';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { Building2, Users, GitBranch, Mail, Shield, MessageSquare, Megaphone } from 'lucide-react';
import { fetchOrganization, fetchOrgMembers, type Organization, type OrgMember, removeMember, updateOrganization, deleteOrganization } from '@/lib/org-service';
import { fetchTeams, buildTeamTree, type Team } from '@/lib/team-service';
import { OrgTreeVisualizer } from '@/components/OrgTreeVisualizer';
import { fetchInvitations, fetchRoleChangeRequests, type Invitation, type RoleChangeRequest, reviewRoleChangeRequest } from '@/lib/invite-service';
import { fetchAnnouncements, type Announcement } from '@/lib/messaging-service';
import { fetchAuditLogs, type AuditLog } from '@/lib/audit-service';
import { getUserOrgRole, canManageMembers, canManageOrg, formatOrgRole, type OrgRole } from '@/lib/authorization';
import { toast } from 'sonner';
import { format } from 'date-fns';

export default function OrgDetail() {
  const { orgId } = useParams<{ orgId: string }>();
  const { user } = useAuth();
  const navigate = useNavigate();
  const [org, setOrg] = useState<Organization | null>(null);
  const [members, setMembers] = useState<OrgMember[]>([]);
  const [teams, setTeams] = useState<Team[]>([]);
  const [invitations, setInvitations] = useState<Invitation[]>([]);
  const [roleRequests, setRoleRequests] = useState<RoleChangeRequest[]>([]);
  const [announcements, setAnnouncements] = useState<Announcement[]>([]);
  const [auditLogs, setAuditLogs] = useState<AuditLog[]>([]);
  const [myRole, setMyRole] = useState<OrgRole | null>(null);
  const [editName, setEditName] = useState('');
  const [editSlug, setEditSlug] = useState('');
  const [editDescription, setEditDescription] = useState('');
  const [editLogoUrl, setEditLogoUrl] = useState('');
  const [savingOrg, setSavingOrg] = useState(false);
  const [deletingOrg, setDeletingOrg] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');

  useEffect(() => {
    if (!orgId || !user) return;
    fetchOrganization(orgId).then((value) => {
      setOrg(value);
      if (value) {
        setEditName(value.name);
        setEditSlug(value.slug);
        setEditDescription(value.description || '');
        setEditLogoUrl(value.logo_url || '');
      }
    });
    fetchOrgMembers(orgId).then(setMembers);
    fetchTeams(orgId).then(setTeams);
    fetchInvitations(orgId).then(setInvitations);
    fetchRoleChangeRequests(orgId).then(setRoleRequests);
    fetchAnnouncements(orgId).then(setAnnouncements);
    fetchAuditLogs(orgId).then(setAuditLogs);
    getUserOrgRole(user.id, orgId).then(setMyRole);
  }, [orgId, user]);

  const isAdmin = canManageOrg(myRole);
  const canManage = canManageMembers(myRole);

  const teamTree = buildTeamTree(teams);
  const roleColor: Record<string, string> = {
    dev_admin: 'bg-red-100 text-red-800',
    super_admin: 'bg-purple-100 text-purple-800',
    hr_admin: 'bg-blue-100 text-blue-800',
    team_lead: 'bg-green-100 text-green-800',
    member: 'bg-muted text-muted-foreground',
  };

  const handleReviewRoleChange = async (reqId: string, status: 'approved' | 'denied') => {
    const ok = await reviewRoleChangeRequest(reqId, status);
    if (ok) {
      toast.success(`Role change ${status}`);
      if (orgId) fetchRoleChangeRequests(orgId).then(setRoleRequests);
    }
  };

  const handleUpdateOrg = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!orgId) return;
    setSavingOrg(true);
    const updated = await updateOrganization(orgId, {
      name: editName,
      slug: editSlug,
      description: editDescription || null,
      logo_url: editLogoUrl || null,
    });
    setSavingOrg(false);
    if (!updated) {
      toast.error('Failed to update organization');
      return;
    }
    setOrg(updated);
    toast.success('Organization updated');
  };

  const handleDeleteOrg = async () => {
    if (!orgId) return;
    const confirmed = confirm('Delete this organization permanently? This action cannot be undone.');
    if (!confirmed) return;
    setDeletingOrg(true);
    const ok = await deleteOrganization(orgId);
    setDeletingOrg(false);
    if (!ok) {
      toast.error('Failed to delete organization');
      return;
    }
    toast.success('Organization deleted');
    navigate('/orgs');
  };

  const renderTeamNode = (team: Team & { children: Team[] }, depth = 0) => (
    <div key={team.id} style={{ marginLeft: depth * 20 }} className="py-2">
      <div className="flex items-center gap-2">
        <GitBranch className="h-4 w-4 text-muted-foreground" />
        <span className="font-medium">{team.name}</span>
        {team.description && <span className="text-sm text-muted-foreground">— {team.description}</span>}
      </div>
      {team.children.map(c => renderTeamNode(c as Team & { children: Team[] }, depth + 1))}
    </div>
  );

  if (!org) return <AppLayout><div className="flex items-center justify-center h-64 text-muted-foreground">Loading...</div></AppLayout>;

  return (
    <AppLayout>
      <div className="max-w-6xl mx-auto space-y-6">
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-3xl font-bold tracking-tight flex items-center gap-2">
              <Building2 className="h-8 w-8" /> {org.name}
            </h1>
            <p className="text-muted-foreground">/{org.slug} • Your role: <Badge className={roleColor[myRole || 'member'] || ''}>{formatOrgRole(myRole || 'member')}</Badge></p>
          </div>
          <div className="flex gap-2">
            {canManage && <Button variant="outline" onClick={() => navigate(`/org/${orgId}/invites`)}><Mail className="h-4 w-4 mr-2" /> Invites</Button>}
            <Button variant="outline" onClick={() => navigate(`/org/${orgId}/messages`)}><MessageSquare className="h-4 w-4 mr-2" /> Messages</Button>
            <Button variant="outline" onClick={() => navigate(`/org/${orgId}/announcements`)}><Megaphone className="h-4 w-4 mr-2" /> Announcements</Button>
          </div>
        </div>

        <Tabs defaultValue="members">
          <TabsList>
            <TabsTrigger value="members"><Users className="h-4 w-4 mr-1" /> Members ({members.length})</TabsTrigger>
            <TabsTrigger value="teams"><GitBranch className="h-4 w-4 mr-1" /> Teams ({teams.length})</TabsTrigger>
            {canManage && <TabsTrigger value="requests"><Shield className="h-4 w-4 mr-1" /> Role Requests</TabsTrigger>}
            {isAdmin && <TabsTrigger value="audit">Audit Log</TabsTrigger>}
          </TabsList>

          <TabsContent value="members" className="space-y-2 mt-4">
            {members.map(m => (
              <div key={m.id} className="flex items-center justify-between p-4 rounded-none terminal-border border">
                <div>
                  <p className="font-medium">{m.profile?.full_name || m.profile?.email || 'Unknown'}</p>
                  <p className="text-sm text-muted-foreground">{m.profile?.email}</p>
                </div>
                <div className="flex items-center gap-2">
                  <Badge className={roleColor[m.role] || ''}>{formatOrgRole(m.role)}</Badge>
                  {isAdmin && m.user_id !== user?.id && (
                    <Button variant="ghost" size="sm" className="text-destructive" onClick={async () => {
                      if (confirm('Remove this member?')) {
                        await removeMember(m.id);
                        if (orgId) fetchOrgMembers(orgId).then(setMembers);
                      }
                    }}>Remove</Button>
                  )}
                </div>
              </div>
            ))}
          </TabsContent>

          <TabsContent value="teams" className="space-y-4">
              <div className="flex justify-between items-center mb-4">
                <h3 className="text-lg font-medium">Teams Structure</h3>
              </div>
              <OrgTreeVisualizer teams={teams} members={members} />
            </TabsContent>

          {canManage && (
            <TabsContent value="requests" className="mt-4 space-y-2">
              {roleRequests.length === 0 ? (
                <p className="text-muted-foreground text-center py-8">No pending role change requests.</p>
              ) : (
                roleRequests.map(r => (
                  <div key={r.id} className="flex items-center justify-between p-4 rounded-none terminal-border border">
                    <div>
                      <p className="font-medium">{formatOrgRole(r.from_role)} → {formatOrgRole(r.to_role)}</p>
                      <p className="text-sm text-muted-foreground">{r.reason || 'No reason provided'}</p>
                      <p className="text-xs text-muted-foreground">{format(new Date(r.created_at), 'PPp')}</p>
                    </div>
                    <div className="flex items-center gap-2">
                      <Badge variant={r.status === 'pending' ? 'secondary' : r.status === 'approved' ? 'default' : 'destructive'}>
                        {r.status}
                      </Badge>
                      {r.status === 'pending' && isAdmin && (
                        <>
                          <Button size="sm" onClick={() => handleReviewRoleChange(r.id, 'approved')}>Approve</Button>
                          <Button size="sm" variant="destructive" onClick={() => handleReviewRoleChange(r.id, 'denied')}>Deny</Button>
                        </>
                      )}
                    </div>
                  </div>
                ))
              )}
            </TabsContent>
          )}

          {isAdmin && (
            <TabsContent value="audit" className="mt-4">
              <Card>
                <CardHeader><CardTitle>Audit Log</CardTitle></CardHeader>
                <CardContent>
                  {auditLogs.length === 0 ? (
                    <p className="text-muted-foreground text-center py-4">No audit events recorded yet.</p>
                  ) : (
                    <div className="space-y-2">
                      {auditLogs.slice(0, 50).map(log => (
                        <div key={log.id} className="text-sm p-2 border-b">
                          <span className="font-medium">{log.action}</span> on <span className="text-muted-foreground">{log.entity_type}</span>
                          <span className="text-xs text-muted-foreground ml-2">{format(new Date(log.created_at), 'PPp')}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </CardContent>
              </Card>
            </TabsContent>
          )}
        </Tabs>

        {isAdmin && (
          <Card>
            <CardHeader>
              <CardTitle>Organization Settings</CardTitle>
              <CardDescription>Edit organization details or delete this organization.</CardDescription>
            </CardHeader>
            <CardContent>
              <form onSubmit={handleUpdateOrg} className="space-y-4">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div className="space-y-2">
                    <Label htmlFor="org-name">Name</Label>
                    <Input id="org-name" value={editName} onChange={(e) => setEditName(e.target.value)} required />
                  </div>
                  <div className="space-y-2">
                    <Label htmlFor="org-slug">Slug</Label>
                    <Input id="org-slug" value={editSlug} onChange={(e) => setEditSlug(e.target.value)} required />
                  </div>
                </div>
                <div className="space-y-2">
                  <Label htmlFor="org-logo">Logo URL</Label>
                  <Input id="org-logo" value={editLogoUrl} onChange={(e) => setEditLogoUrl(e.target.value)} placeholder="https://..." />
                </div>
                <div className="space-y-2">
                  <Label htmlFor="org-description">Description</Label>
                  <Textarea id="org-description" value={editDescription} onChange={(e) => setEditDescription(e.target.value)} rows={3} />
                </div>
                <div className="flex flex-wrap gap-2">
                  <Button type="submit" disabled={savingOrg}>
                    {savingOrg ? 'Saving...' : 'Save Changes'}
                  </Button>
                  <Button type="button" variant="destructive" onClick={handleDeleteOrg} disabled={deletingOrg}>
                    {deletingOrg ? 'Deleting...' : 'Delete Organization'}
                  </Button>
                </div>
              </form>
            </CardContent>
          </Card>
        )}
      </div>
    </AppLayout>
  );
}
</file>

<file path="src/pages/Profile.tsx">
import { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { format } from 'date-fns';
import { Save, Download, Trash2, Award, Bell, Shield, Moon, Sun } from 'lucide-react';
import { useAuth } from '@/contexts/AuthContext';
import { AppLayout } from '@/components/AppLayout';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Label } from '@/components/ui/label';
import { Switch } from '@/components/ui/switch';
import { Card, CardContent, CardDescription, CardHeader, CardTitle, CardFooter } from '@/components/ui/card';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { fetchAssessmentHistory, MockAssessmentResult } from '@/lib/supabase-stubs';
import { toast } from 'sonner';
import { useTheme } from '@/contexts/ThemeContext';

export default function Profile() {
  const { user, updateProfile, logout } = useAuth();
  const navigate = useNavigate();
  const [history, setHistory] = useState<MockAssessmentResult[]>([]);

  // Profile Form State
  const [name, setName] = useState(user?.name || '');
  const [bio, setBio] = useState(user?.bio || '');

  // Notifications State (persisted to localStorage)
  const [emailReminders, setEmailReminders] = useState(() => localStorage.getItem('pref_emailReminders') !== 'false');
  const [completionAlerts, setCompletionAlerts] = useState(() => localStorage.getItem('pref_completionAlerts') !== 'false');
  const [weeklySummary, setWeeklySummary] = useState(() => localStorage.getItem('pref_weeklySummary') === 'true');

  // Theme state
  const { isDarkMode, toggleTheme } = useTheme();

  useEffect(() => {
    if (user) {
      fetchAssessmentHistory(user.id).then(setHistory);
    }
  }, [user]);

  // Persist notification preferences
  useEffect(() => {
    localStorage.setItem('pref_emailReminders', String(emailReminders));
    localStorage.setItem('pref_completionAlerts', String(completionAlerts));
    localStorage.setItem('pref_weeklySummary', String(weeklySummary));
  }, [emailReminders, completionAlerts, weeklySummary]);

  const handleSaveProfile = (e: React.FormEvent) => {
    e.preventDefault();
    updateProfile({ name, bio });
    toast.success('Profile updated successfully');
  };

  const handleExportData = (formatType: 'json' | 'csv') => {
    if (history.length === 0) {
      toast.error('No assessment data to export.');
      return;
    }

    let blob: Blob;
    let filename: string;

    if (formatType === 'json') {
      blob = new Blob([JSON.stringify(history, null, 2)], { type: 'application/json' });
      filename = `assessiq_history_${user?.id}.json`;
    } else {
      // Simple CSV export
      const headers = ['Date', 'Session ID', 'Top Role', 'Average Domain Score'];
      const rows = history.map(h => {
        const topRole = Object.entries(h.role_scores).sort((a,b)=>b[1]-a[1])[0][0];
        const avgScore = Object.values(h.domain_scores).reduce((a,b)=>a+b,0) / Object.keys(h.domain_scores).length;
        return [format(new Date(h.date), 'yyyy-MM-dd'), h.session_id, topRole, avgScore.toFixed(2)].join(',');
      });
      const csvContent = [headers.join(','), ...rows].join('\n');
      blob = new Blob([csvContent], { type: 'text/csv' });
      filename = `assessiq_history_${user?.id}.csv`;
    }

    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    toast.success(`Data exported as ${formatType.toUpperCase()}`);
  };

  const handleDeleteAccount = () => {
    if (window.confirm("Are you sure you want to delete your account? This action cannot be undone.")) {
      // Mock deletion
      logout();
      navigate('/login');
      toast.success('Account deleted.');
    }
  };

  // Compute Badges
  const hasFirstAssessment = history.length > 0;
  const hasStreak = history.length >= 3;
  const hasTopMatch = history.some(h => Math.max(...Object.values(h.role_scores)) >= 0.90);
  const allDomainsAbove70 = history.some(h => Object.values(h.domain_scores).every(score => score >= 0.70));

  return (
    <AppLayout>
    <div className="max-w-4xl mx-auto space-y-8 pb-20">

      <div className="flex items-center gap-4">
        <div className="h-16 w-16 rounded-none bg-primary/10 flex items-center justify-center text-2xl font-semibold text-primary">
          {user?.name.charAt(0)}
        </div>
        <div>
          <h1 className="text-3xl font-bold tracking-tight">Your Profile</h1>
          <p className="text-muted-foreground">Manage your settings and view achievements.</p>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-8">

        <div className="md:col-span-2 space-y-8">
          {/* 1. Editable Info */}
          <Card>
            <CardHeader>
              <CardTitle>Personal Information</CardTitle>
            </CardHeader>
            <CardContent>
              <form onSubmit={handleSaveProfile} className="space-y-4">
                <div className="grid grid-cols-2 gap-4">
                  <div className="space-y-2">
                    <Label htmlFor="name">Full Name</Label>
                    <Input id="name" value={name} onChange={(e) => setName(e.target.value)} required />
                  </div>
                  <div className="space-y-2">
                    <Label htmlFor="email">Email</Label>
                    <Input id="email" value={user?.email} disabled className="bg-muted" />
                  </div>
                </div>
                <div className="space-y-2">
                  <Label htmlFor="bio">Bio</Label>
                  <Textarea
                    id="bio"
                    placeholder="Tell us a bit about your professional background..."
                    value={bio}
                    onChange={(e) => setBio(e.target.value)}
                    className="resize-none"
                    rows={4}
                  />
                </div>
                <Button type="submit" className="w-full sm:w-auto">
                  <Save className="mr-2 h-4 w-4" /> Save Changes
                </Button>
              </form>
            </CardContent>
          </Card>

          {/* 2. Assessment History Summary */}
          <Card>
            <CardHeader>
              <CardTitle>Assessment History</CardTitle>
              <CardDescription>Your past assessment sessions</CardDescription>
            </CardHeader>
            <CardContent>
              {history.length > 0 ? (
                <div className="rounded-none terminal-border border">
                  <Table>
                    <TableHeader>
                      <TableRow>
                        <TableHead>Date</TableHead>
                        <TableHead>Top Role Match</TableHead>
                        <TableHead className="text-right">Avg Score</TableHead>
                        <TableHead></TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {history.map((record, i) => {
                        const topRole = Object.entries(record.role_scores).sort((a,b)=>b[1]-a[1])[0][0];
                        const avgScore = Object.values(record.domain_scores).reduce((a,b)=>a+b,0) / Object.keys(record.domain_scores).length;
                        return (
                          <TableRow key={i}>
                            <TableCell>{format(new Date(record.date), 'MMM d, yyyy')}</TableCell>
                            <TableCell>{topRole}</TableCell>
                            <TableCell className="text-right">{Math.round(avgScore * 100)}%</TableCell>
                            <TableCell className="text-right">
                              <Button variant="ghost" size="sm" onClick={() => navigate('/results')}>View</Button>
                            </TableCell>
                          </TableRow>
                        );
                      })}
                    </TableBody>
                  </Table>
                </div>
              ) : (
                <p className="text-muted-foreground text-center py-4">No assessments taken yet.</p>
              )}
            </CardContent>
          </Card>

          {/* 5. Badges & Achievements */}
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2"><Award className="h-5 w-5 text-primary" /> Achievements</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
                <div className={`p-4 rounded-none terminal-border border flex flex-col items-center gap-2 ${hasFirstAssessment ? 'bg-primary/5 border-primary/20' : 'opacity-50 grayscale'}`}>
                  <div className="h-10 w-10 rounded-none bg-primary/20 flex items-center justify-center text-primary text-xl">🎓</div>
                  <div className="text-xs font-semibold">First Step</div>
                </div>
                <div className={`p-4 rounded-none terminal-border border flex flex-col items-center gap-2 ${hasStreak ? 'bg-primary/5 border-primary/20' : 'opacity-50 grayscale'}`}>
                  <div className="h-10 w-10 rounded-none bg-primary/20 flex items-center justify-center text-primary text-xl">🔥</div>
                  <div className="text-xs font-semibold">Consistency (3+)</div>
                </div>
                <div className={`p-4 rounded-none terminal-border border flex flex-col items-center gap-2 ${hasTopMatch ? 'bg-primary/5 border-primary/20' : 'opacity-50 grayscale'}`}>
                  <div className="h-10 w-10 rounded-none bg-primary/20 flex items-center justify-center text-primary text-xl">⭐</div>
                  <div className="text-xs font-semibold">Top 10% Match</div>
                </div>
                <div className={`p-4 rounded-none terminal-border border flex flex-col items-center gap-2 ${allDomainsAbove70 ? 'bg-primary/5 border-primary/20' : 'opacity-50 grayscale'}`}>
                  <div className="h-10 w-10 rounded-none bg-primary/20 flex items-center justify-center text-primary text-xl">💎</div>
                  <div className="text-xs font-semibold">Well-Rounded</div>
                </div>
              </div>
            </CardContent>
          </Card>

        </div>

        <div className="space-y-8">

          {/* 3. Notification Preferences */}
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2"><Bell className="h-5 w-5" /> Notifications</CardTitle>
            </CardHeader>
            <CardContent className="space-y-6">
              <div className="flex items-center justify-between">
                <div className="space-y-0.5">
                  <Label>Email Reminders</Label>
                  <p className="text-xs text-muted-foreground">For incomplete assessments</p>
                </div>
                <Switch checked={emailReminders} onCheckedChange={setEmailReminders} />
              </div>
              <div className="flex items-center justify-between">
                <div className="space-y-0.5">
                  <Label>Completion Alerts</Label>
                  <p className="text-xs text-muted-foreground">When results are ready</p>
                </div>
                <Switch checked={completionAlerts} onCheckedChange={setCompletionAlerts} />
              </div>
              <div className="flex items-center justify-between">
                <div className="space-y-0.5">
                  <Label>Weekly Summary</Label>
                  <p className="text-xs text-muted-foreground">Growth plan updates</p>
                </div>
                <Switch checked={weeklySummary} onCheckedChange={setWeeklySummary} />
              </div>
            </CardContent>
          </Card>

          {/* 6. Data Export */}
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2"><Download className="h-5 w-5" /> Data Export</CardTitle>
              <CardDescription>Download your assessment data</CardDescription>
            </CardHeader>
            <CardContent className="space-y-3">
              <Button variant="outline" className="w-full justify-start" onClick={() => handleExportData('json')}>
                <Download className="mr-2 h-4 w-4" /> Export as JSON
              </Button>
              <Button variant="outline" className="w-full justify-start" onClick={() => handleExportData('csv')}>
                <Download className="mr-2 h-4 w-4" /> Export as CSV
              </Button>
            </CardContent>
          </Card>

          {/* 4. Account Settings */}
          <Card className="border-destructive/20">
            <CardHeader>
              <CardTitle className="flex items-center gap-2 text-destructive"><Shield className="h-5 w-5" /> Danger Zone</CardTitle>
            </CardHeader>
            <CardContent className="space-y-6">
              <div className="flex items-center justify-between">
                <div className="space-y-0.5">
                  <Label>Theme Preview</Label>
                  <p className="text-xs text-muted-foreground">Switch between light and dark mode</p>
                </div>
                <Button variant="ghost" size="icon" onClick={toggleTheme} aria-label={isDarkMode ? 'Switch to light mode' : 'Switch to dark mode'}>
                  {isDarkMode ? <Sun className="h-4 w-4" /> : <Moon className="h-4 w-4" />}
                </Button>
              </div>

              <div className="space-y-3 pt-4 border-t">
                <Label>Change Password</Label>
                <Input type="password" placeholder="New Password" />
                <Button variant="secondary" className="w-full">Update Password</Button>
              </div>

              <div className="pt-4 border-t">
                <Button variant="destructive" className="w-full" onClick={handleDeleteAccount}>
                  <Trash2 className="mr-2 h-4 w-4" /> Delete Account
                </Button>
              </div>
            </CardContent>
          </Card>

        </div>
      </div>
    </div>
    </AppLayout>
  );
}
