import { useState, useEffect, useMemo } from 'react';
import { useNavigate } from 'react-router-dom';
import { AppLayout } from '@/components/AppLayout';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import {
  Table, TableBody, TableCell, TableHead, TableHeader, TableRow,
} from '@/components/ui/table';
import { fetchCandidates } from '@/lib/supabase-stubs';
import type { MockCandidate } from '@/lib/supabase-stubs';
import { Search, Download, ArrowUpDown, Tag } from 'lucide-react';
import { Checkbox } from '@/components/ui/checkbox';
import { AssignGroupPopover } from '@/components/admin/AssignGroupPopover';
import { AdvancedExportModal } from '@/components/admin/AdvancedExportModal';
import { generateBatchZip } from '@/lib/pdf/generateBatchZip';
import { toast } from 'sonner';

type SortKey = 'name' | 'date_taken' | 'top_role_score' | 'average_score';
type SortDir = 'asc' | 'desc';

interface Group {
  id: string;
  name: string;
}

const Candidates = () => {
  const navigate = useNavigate();
  const [candidates, setCandidates] = useState<MockCandidate[]>([]);
  const [search, setSearch] = useState('');
  const [statusFilter, setStatusFilter] = useState<string>('all');
  const [groupFilter, setGroupFilter] = useState<string>('all');
  const [sortKey, setSortKey] = useState<SortKey>('date_taken');
  const [sortDir, setSortDir] = useState<SortDir>('desc');

  // Selection state
  const [selectedCandidates, setSelectedCandidates] = useState<string[]>([]);
  const [selectedForCompare, setSelectedForCompare] = useState<string[]>([]);

  // Group state
  const [availableGroups, setAvailableGroups] = useState<Group[]>([]);
  // Mapping candidate user_id -> array of group ids
  const [candidateGroups, setCandidateGroups] = useState<Record<string, string[]>>({});

  // Export Modal state
  const [exportModalOpen, setExportModalOpen] = useState(false);
  const [isExporting, setIsExporting] = useState(false);

  // Load candidates and persistent groups
  useEffect(() => {
    fetchCandidates().then(setCandidates);

    const savedGroups = localStorage.getItem('candidate_groups_def');
    if (savedGroups) {
      setAvailableGroups(JSON.parse(savedGroups));
    }
    const savedAssignments = localStorage.getItem('candidate_group_assignments');
    if (savedAssignments) {
      setCandidateGroups(JSON.parse(savedAssignments));
    }
  }, []);

  const saveGroups = (groups: Group[], assignments: Record<string, string[]>) => {
    localStorage.setItem('candidate_groups_def', JSON.stringify(groups));
    localStorage.setItem('candidate_group_assignments', JSON.stringify(assignments));
    setAvailableGroups(groups);
    setCandidateGroups(assignments);
  };

  const handleCreateGroup = (name: string) => {
    const newGroup: Group = { id: `group_${Date.now()}`, name };
    const updatedGroups = [...availableGroups, newGroup];
    saveGroups(updatedGroups, candidateGroups);
    toast.success(`Group "${name}" created`);

    // Automatically assign selected candidates to this new group
    if (selectedCandidates.length > 0) {
      handleAssignGroup(newGroup.id, newGroup.name);
    }
  };

  const handleAssignGroup = (groupId: string, groupName: string) => {
    const updatedAssignments = { ...candidateGroups };

    // Check if we should add or remove
    // If all selected are already in the group, remove them. Otherwise add them.
    const allInGroup = selectedCandidates.every(id =>
      updatedAssignments[id]?.includes(groupId)
    );

    selectedCandidates.forEach(id => {
      const currentGroups = updatedAssignments[id] || [];
      if (allInGroup) {
        // Remove
        updatedAssignments[id] = currentGroups.filter(g => g !== groupId);
      } else {
        // Add
        if (!currentGroups.includes(groupId)) {
          updatedAssignments[id] = [...currentGroups, groupId];
        }
      }
    });

    saveGroups(availableGroups, updatedAssignments);
    toast.success(allInGroup ? `Removed from "${groupName}"` : `Assigned to "${groupName}"`);
  };

  const toggleSort = (key: SortKey) => {
    if (sortKey === key) setSortDir(d => d === 'asc' ? 'desc' : 'asc');
    else { setSortKey(key); setSortDir('desc'); }
  };

  const filtered = useMemo(() => {
    let data = [...candidates];

    if (search) {
      const s = search.toLowerCase();
      data = data.filter(c => c.name.toLowerCase().includes(s) || c.email.toLowerCase().includes(s));
    }
    if (statusFilter !== 'all') {
      data = data.filter(c => c.status === statusFilter);
    }
    if (groupFilter !== 'all') {
      data = data.filter(c => candidateGroups[c.user_id]?.includes(groupFilter));
    }

    data.sort((a, b) => {
      const aVal = a[sortKey];
      const bVal = b[sortKey];
      const cmp = typeof aVal === 'string' ? aVal.localeCompare(bVal as string) : (aVal as number) - (bVal as number);
      return sortDir === 'asc' ? cmp : -cmp;
    });

    return data;
  }, [candidates, search, statusFilter, groupFilter, sortKey, sortDir, candidateGroups]);

  const exportCSV = () => {
    const headers = ['Name', 'Email', 'Date Taken', 'Top Role', 'Top Score', 'Avg Score', 'Status'];
    const rows = filtered.map(c => [c.name, c.email, c.date_taken, c.top_role, Math.round(c.top_role_score * 100) + '%', Math.round(c.average_score * 100) + '%', c.status]);
    const csv = [headers, ...rows].map(r => r.join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'candidates.csv';
    a.click();
    URL.revokeObjectURL(url);
  };

  const toggleCompare = (candidateId: string, checked: boolean) => {
    setSelectedForCompare(prev => {
      if (checked) {
        if (prev.includes(candidateId)) return prev;
        return [...prev, candidateId].slice(-2);
      }
      return prev.filter(id => id !== candidateId);
    });
  };

  const toggleSelect = (userId: string, checked: boolean) => {
    setSelectedCandidates(prev => {
      if (checked) {
        return prev.includes(userId) ? prev : [...prev, userId];
      }
      return prev.filter(id => id !== userId);
    });
  };

  const toggleSelectAll = (checked: boolean) => {
    if (checked) {
      setSelectedCandidates(filtered.map(c => c.user_id));
    } else {
      setSelectedCandidates([]);
    }
  };

  const handleBatchExport = async (options: { summary: boolean; radar: boolean; roles: boolean; traits: boolean }) => {
    setIsExporting(true);
    try {
      const candidatesToExport = candidates.filter(c => selectedCandidates.includes(c.user_id));
      await generateBatchZip(candidatesToExport, options);
      toast.success(`Exported ${candidatesToExport.length} candidate reports`);
      setExportModalOpen(false);
      setSelectedCandidates([]); // Clear selection after export
    } catch (e) {
      console.error(e);
      toast.error('Failed to generate export bundle');
    } finally {
      setIsExporting(false);
    }
  };

  const compareCandidates = candidates.filter(c => selectedForCompare.includes(c.id));
  const allFilteredSelected = filtered.length > 0 && filtered.every(c => selectedCandidates.includes(c.user_id));
  const someFilteredSelected = filtered.some(c => selectedCandidates.includes(c.user_id));

  const SortableHeader = ({ label, sortKeyName }: { label: string; sortKeyName: SortKey }) => (
    <TableHead className="cursor-pointer select-none" onClick={() => toggleSort(sortKeyName)}>
      <div className="flex items-center gap-1">
        {label}
        <ArrowUpDown className="h-3 w-3 text-muted-foreground" />
      </div>
    </TableHead>
  );

  return (
    <AppLayout>
      <div className="space-y-6 relative">
        <div className="flex items-center justify-between">
          <h1 className="text-2xl font-semibold">Candidates</h1>
          <div className="flex items-center gap-2">
            <Button variant="outline" size="sm" onClick={exportCSV}>
              <Download className="mr-2 h-4 w-4" /> Export CSV
            </Button>
          </div>
        </div>

        {/* Filters */}
        <div className="flex flex-wrap gap-3">
          <div className="relative flex-1 min-w-[200px] max-w-sm">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
            <Input placeholder="Search by name or email…" value={search} onChange={e => setSearch(e.target.value)} className="pl-9" />
          </div>
          <Select value={statusFilter} onValueChange={setStatusFilter}>
            <SelectTrigger className="w-40"><SelectValue /></SelectTrigger>
            <SelectContent>
              <SelectItem value="all">All Status</SelectItem>
              <SelectItem value="completed">Completed</SelectItem>
              <SelectItem value="in_progress">In Progress</SelectItem>
            </SelectContent>
          </Select>
          <Select value={groupFilter} onValueChange={setGroupFilter}>
            <SelectTrigger className="w-48">
              <div className="flex items-center gap-2">
                <Tag className="h-4 w-4 text-muted-foreground" />
                <SelectValue placeholder="Filter by Group" />
              </div>
            </SelectTrigger>
            <SelectContent>
              <SelectItem value="all">All Groups</SelectItem>
              {availableGroups.map(g => (
                <SelectItem key={g.id} value={g.id}>{g.name}</SelectItem>
              ))}
            </SelectContent>
          </Select>
        </div>

        {/* Bulk Action Toolbar */}
        {selectedCandidates.length > 0 && (
          <div className="bg-muted/50 border border-border rounded-none p-3 flex items-center justify-between sticky top-0 z-10">
            <div className="flex items-center gap-4">
              <span className="text-sm font-medium">
                {selectedCandidates.length} candidate{selectedCandidates.length !== 1 ? 's' : ''} selected
              </span>
              <div className="h-4 w-px bg-border mx-2" />
              <AssignGroupPopover
                selectedCandidateIds={selectedCandidates}
                candidateGroups={candidateGroups}
                availableGroups={availableGroups}
                onAssignGroup={handleAssignGroup}
                onCreateGroup={handleCreateGroup}
              />
              <Button variant="outline" size="sm" className="h-8" onClick={() => setExportModalOpen(true)}>
                <Download className="mr-2 h-4 w-4" /> Export Selected PDFs
              </Button>
            </div>
            <Button variant="ghost" size="sm" className="h-8" onClick={() => setSelectedCandidates([])}>
              Clear Selection
            </Button>
          </div>
        )}

        {/* Table */}
        <div className="rounded-none terminal-border border border-border">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead className="w-10">
                  <Checkbox
                    checked={allFilteredSelected ? true : someFilteredSelected ? 'indeterminate' : false}
                    onCheckedChange={(v) => toggleSelectAll(Boolean(v))}
                    aria-label="Select all"
                  />
                </TableHead>
                <SortableHeader label="Name" sortKeyName="name" />
                <TableHead>Email</TableHead>
                <SortableHeader label="Date" sortKeyName="date_taken" />
                <TableHead>Groups</TableHead>
                <TableHead>Top Role Fit</TableHead>
                <SortableHeader label="Top Score" sortKeyName="top_role_score" />
                <SortableHeader label="Avg Score" sortKeyName="average_score" />
                <TableHead>Status</TableHead>
                <TableHead className="w-14">Compare</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {filtered.map(c => {
                const userGroups = candidateGroups[c.user_id] || [];
                return (
                  <TableRow
                    key={c.id}
                    className="cursor-pointer"
                    onClick={() => navigate(`/admin/candidate/${c.user_id}`)}
                  >
                    <TableCell onClick={(e) => e.stopPropagation()}>
                      <Checkbox
                        checked={selectedCandidates.includes(c.user_id)}
                        onCheckedChange={(v) => toggleSelect(c.user_id, Boolean(v))}
                        aria-label={`Select ${c.name}`}
                      />
                    </TableCell>
                    <TableCell className="font-medium">{c.name}</TableCell>
                    <TableCell className="text-muted-foreground">{c.email}</TableCell>
                    <TableCell>{c.date_taken}</TableCell>
                    <TableCell>
                      <div className="flex flex-wrap gap-1">
                        {userGroups.map(gid => {
                          const gName = availableGroups.find(g => g.id === gid)?.name;
                          return gName ? (
                            <Badge key={gid} variant="outline" className="text-[10px] px-1 py-0 h-4">
                              {gName}
                            </Badge>
                          ) : null;
                        })}
                      </div>
                    </TableCell>
                    <TableCell>{c.top_role}</TableCell>
                    <TableCell>{Math.round(c.top_role_score * 100)}%</TableCell>
                    <TableCell>{Math.round(c.average_score * 100)}%</TableCell>
                    <TableCell>
                      <Badge variant={c.status === 'completed' ? 'default' : 'secondary'} className="text-xs">
                        {c.status === 'completed' ? 'Completed' : 'In Progress'}
                      </Badge>
                    </TableCell>
                    <TableCell onClick={(e) => e.stopPropagation()}>
                      <Checkbox
                        checked={selectedForCompare.includes(c.id)}
                        onCheckedChange={(v) => toggleCompare(c.id, Boolean(v))}
                        aria-label={`Compare ${c.name}`}
                      />
                    </TableCell>
                  </TableRow>
                );
              })}
              {filtered.length === 0 && (
                <TableRow>
                  <TableCell colSpan={10} className="text-center text-muted-foreground py-8">
                    No candidates found
                  </TableCell>
                </TableRow>
              )}
            </TableBody>
          </Table>
        </div>

        {compareCandidates.length === 2 && (
          <div className="rounded-none terminal-border border border-border p-5">
            <h2 className="text-lg font-medium mb-4">Compare Candidates</h2>
            <div className="grid md:grid-cols-2 gap-4">
              {compareCandidates.map(c => (
                <div key={c.id} className="rounded-none terminal-border border border-border p-4 space-y-2">
                  <p className="font-semibold">{c.name}</p>
                  <p className="text-sm text-muted-foreground">{c.email}</p>
                  <div className="text-sm">Top Role: <span className="font-medium">{c.top_role}</span></div>
                  <div className="text-sm">Top Role Score: <span className="font-medium">{Math.round(c.top_role_score * 100)}%</span></div>
                  <div className="text-sm">Average Score: <span className="font-medium">{Math.round(c.average_score * 100)}%</span></div>
                  <Button variant="outline" size="sm" onClick={() => navigate(`/admin/candidate/${c.user_id}`)}>
                    Open Full Assessment
                  </Button>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <AdvancedExportModal
        open={exportModalOpen}
        onOpenChange={setExportModalOpen}
        onExport={handleBatchExport}
        candidateCount={selectedCandidates.length}
        isExporting={isExporting}
      />
    </AppLayout>
  );
};

export default Candidates;
</file>

<file path="src/pages/admin/Users.tsx">
import { AppLayout } from '@/components/AppLayout';
import React, { useEffect, useState } from 'react';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { UserPlus } from 'lucide-react';
import { toast } from 'sonner';
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from '@/components/ui/dialog';
import { useNotifications } from '@/contexts/NotificationContext';
import { fetchUsers, updateUserRole } from '@/lib/supabase-stubs';
import type { PlatformUser } from '@/lib/supabase-stubs';

const roleLabels: Record<string, string> = {
  candidate: 'Candidate',
  hr_admin: 'HR Admin',
  super_admin: 'Super Admin',
  dev_admin: 'Dev Admin',
};

const roleVariant: Record<string, 'default' | 'secondary' | 'outline'> = {
  candidate: 'outline',
  hr_admin: 'secondary',
  super_admin: 'default',
  dev_admin: 'default',
};

const Users = () => {
  const [users, setUsers] = useState<PlatformUser[]>([]);
  const [isAddUserOpen, setIsAddUserOpen] = useState(false);
  const [newUserEmail, setNewUserEmail] = useState('');
  const [newUserRole, setNewUserRole] = useState<PlatformUser['role']>('candidate');
  const { addNotification } = useNotifications();

  useEffect(() => {
    fetchUsers().then(setUsers);
  }, []);

  const handleAddUser = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newUserEmail) return;

    // Simulate sending notification to the user (in a real app, this would be an email or a backend push)
    // Here we add it to the mock notifications targeting this email
    addNotification({
      title: 'Role Invitation',
      message: `You have been invited to join as a ${roleLabels[newUserRole]}. Please accept the invitation.`,
      type: 'invite',
      metadata: { role: newUserRole, email: newUserEmail },
    });

    // Add to pending users list visually
    toast.success(`Invitation sent to ${newUserEmail}`);
    setIsAddUserOpen(false);
    setNewUserEmail('');
    setNewUserRole('candidate');
  };

  const handleRoleChange = async (userId: string, role: PlatformUser['role']) => {
    try {
      await updateUserRole(userId, role);
      setUsers(prev => prev.map(u => u.id === userId ? { ...u, role } : u));
      toast.success('Role updated');
    } catch (error: unknown) {
      const description = (() => {
        if (error instanceof Error) return error.message;
        if (error && typeof error === 'object') {
          const maybeMessage = 'message' in error ? (error as { message?: unknown }).message : undefined;
          if (typeof maybeMessage === 'string') return maybeMessage;
          return JSON.stringify(error);
        }
        return String(error);
      })();

      toast.error('Could not update role', { description });
    }
  };

  return (
    <AppLayout>
      <div className="space-y-6">
        <div className="flex justify-between items-center">
          <h1 className="text-2xl font-semibold">User Management</h1>

          <Dialog open={isAddUserOpen} onOpenChange={setIsAddUserOpen}>
            <DialogTrigger asChild>
              <Button>
                <UserPlus className="mr-2 h-4 w-4" />
                Add User
              </Button>
            </DialogTrigger>
            <DialogContent className="sm:max-w-[425px]">
              <form onSubmit={handleAddUser}>
                <DialogHeader>
                  <DialogTitle>Add New User</DialogTitle>
                  <DialogDescription>
                    Invite a new user to the platform. They will receive a notification to accept their role.
                  </DialogDescription>
                </DialogHeader>
                <div className="grid gap-4 py-4">
                  <div className="grid grid-cols-4 items-center gap-4">
                    <Label htmlFor="email" className="text-right">
                      Email
                    </Label>
                    <Input
                      id="email"
                      type="email"
                      value={newUserEmail}
                      onChange={(e) => setNewUserEmail(e.target.value)}
                      placeholder="user@example.com"
                      className="col-span-3"
                      required
                    />
                  </div>
                  <div className="grid grid-cols-4 items-center gap-4">
                    <Label htmlFor="role" className="text-right">
                      Role
                    </Label>
                    <Select value={newUserRole} onValueChange={setNewUserRole}>
                      <SelectTrigger className="col-span-3">
                        <SelectValue placeholder="Select a role" />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="candidate">Candidate</SelectItem>
                        <SelectItem value="hr_admin">HR Admin</SelectItem>
                        <SelectItem value="dev_admin">Dev Admin</SelectItem>
                        <SelectItem value="super_admin">Super Admin</SelectItem>
                      </SelectContent>
                    </Select>
                  </div>
                </div>
                <DialogFooter>
                  <Button type="submit">Send Invitation</Button>
                </DialogFooter>
              </form>
            </DialogContent>
          </Dialog>
        </div>

        <div className="rounded-none terminal-border border border-border">
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Name</TableHead>
                <TableHead>Email</TableHead>
                <TableHead>Role</TableHead>
                <TableHead>Actions</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {users.map(u => (
                <TableRow key={u.id}>
                  <TableCell className="font-medium">{u.full_name || u.email.split('@')[0]}</TableCell>
                  <TableCell className="text-muted-foreground">{u.email}</TableCell>
                  <TableCell>
                    <Badge variant={roleVariant[u.role]} className="text-xs">
                      {roleLabels[u.role]}
                    </Badge>
                  </TableCell>
                  <TableCell>
                    <Select value={u.role} onValueChange={(role) => handleRoleChange(u.id, role as PlatformUser['role'])}>
                      <SelectTrigger className="w-32 h-8 text-xs">
                        <SelectValue />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="candidate">Candidate</SelectItem>
                        <SelectItem value="hr_admin">HR Admin</SelectItem>
                        <SelectItem value="dev_admin">Dev Admin</SelectItem>
                        <SelectItem value="super_admin">Super Admin</SelectItem>
                      </SelectContent>
                    </Select>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </div>
      </div>
    </AppLayout>
  );
};

export default Users;
</file>

