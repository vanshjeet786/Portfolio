import { supabase } from '@/integrations/supabase/client';

export type OrgRole = 'dev_admin' | 'super_admin' | 'hr_admin' | 'team_lead' | 'member';

export async function getUserOrgRole(userId: string, orgId: string): Promise<OrgRole | null> {
  const { data } = await supabase
    .from('org_memberships')
    .select('role')
    .eq('user_id', userId)
    .eq('org_id', orgId)
    .maybeSingle();
  return (data?.role as OrgRole) || null;
}

export async function getUserOrgs(userId: string) {
  const { data, error } = await supabase
    .from('org_memberships')
    .select('org_id, role, organizations(id, name, slug, logo_url)')
    .eq('user_id', userId);
  if (error) { console.error('[getUserOrgs]', error); return []; }
  return (data || []).map((m: unknown) => ({
    orgId: m.org_id,
    role: m.role as OrgRole,
    org: m.organizations,
  }));
}

export function canManageOrg(role: OrgRole | null): boolean {
  return role === 'dev_admin' || role === 'super_admin';
}

export function canManageMembers(role: OrgRole | null): boolean {
  return role === 'dev_admin' || role === 'super_admin' || role === 'hr_admin';
}

export function canViewReports(role: OrgRole | null): boolean {
  return role !== null && role !== 'member';
}

export function canBroadcast(role: OrgRole | null): boolean {
  return role !== null && role !== 'member';
}

export function isDevAdmin(role: OrgRole | null): boolean {
  return role === 'dev_admin';
}

export function formatOrgRole(role: OrgRole | string): string {
  return role
    .split('_')
    .map(part => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
}
