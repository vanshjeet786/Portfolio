<file path="src/components/PrintableReport.tsx">
import React from 'react';

export interface IPrintableInsight {
  text: string;
}

export interface IPrintableDomain {
  domain: string;
  score: number;
}

export interface IPrintableTrait {
  name?: string;
  trait?: string;
  score: number;
}

export interface IPrintableRole {
  role: string;
  score: number;
}

export interface IPrintableCustomRole {
  role_name: string;
  description: string;
  match_score: number;
  critical_traits: string[];
}

export interface IPrintableDeepInsights {
  strengths_blind_spots: {
    top_drivers_note: string;
    blind_spots_note: string;
  };
  skill_gap: {
    target_role: string;
    action_plan: string[];
  };
  workplace_fit: {
    startup_match_percentage: number;
    corporate_match_percentage: number;
    autonomy_score: number;
    pace_score: number;
    environment_note: string;
  };
  leadership_potential: {
    index_score: number;
    style_name: string;
    description: string;
  };
  pivot_potential: { industry: string; transferable_percentage: number }[];
  decision_making: {
    primary_bias: { name: string; description: string };
    secondary_bias: { name: string; description: string };
  };
}

export interface PrintableReportProps {
  candidateName: string;
  candidateEmail?: string;
  date: string;
  topRole: string;
  topRoleScore: number;
  readinessLabel: string;
  insights: IPrintableInsight[];
  domains: IPrintableDomain[];
  topTraits: IPrintableTrait[];
  topDriverTraits: IPrintableTrait[];
  bottomDriverTraits: IPrintableTrait[];
  traits: IPrintableTrait[];
  roles: IPrintableRole[];
  customRoles?: IPrintableCustomRole[] | null;
  deepInsights?: IPrintableDeepInsights | null;
  country?: string;
}

const ORANGE = '#FFA600';
const RED = '#ef4444';
const YELLOW = '#eab308';
const GREEN = '#22c55e';
const BG = '#ffffff';
const TEXT = '#111827';
const TEXT_MUTED = '#374151';
const BORDER = '#e5e7eb';
const CARD = '#f9fafb';
const CARD_ALT = '#f3f4f6';
const BAR_TRACK = '#e5e7eb';

const getBarColor = (score: number): string => {
  if (score >= 75) return ORANGE;
  if (score >= 50) return YELLOW;
  return RED;
};

const TEXT_STYLE: React.CSSProperties = {
  lineHeight: 1.5,
  overflow: 'visible',
};

const formatTraitName = (t: IPrintableTrait): string =>
  (t.name || t.trait || '').replace(/_/g, ' ');

const traitPercent = (score: number): number =>
  score > 1 ? Math.round(score) : Math.round(score * 100);

const chunkArray = <T,>(arr: T[], size: number): T[][] => {
  if (!arr.length) return [];
  const chunks: T[][] = [];
  for (let i = 0; i < arr.length; i += size) chunks.push(arr.slice(i, i + size));
  return chunks;
};

const PdfSection = ({ children, style }: { children: React.ReactNode; style?: React.CSSProperties }) => (
  <div
    data-pdf-section
    style={{
      width: '210mm',
      boxSizing: 'border-box',
      padding: '0 32px 16px',
      margin: 0,
      overflow: 'visible',
      backgroundColor: BG,
      ...style,
    }}
  >
    {children}
  </div>
);

const SectionTitle = ({ label, title }: { label?: string; title: string }) => (
  <div style={{ marginBottom: 16, ...TEXT_STYLE }}>
    {label && (
      <div style={{ color: ORANGE, fontSize: 10, letterSpacing: '0.2em', marginBottom: 4, textTransform: 'uppercase', lineHeight: 1.5 }}>
        {label}
      </div>
    )}
    <h3
      style={{
        fontSize: 20,
        fontWeight: 900,
        textTransform: 'uppercase',
        letterSpacing: '-0.02em',
        margin: 0,
        color: TEXT,
        lineHeight: 1.3,
      }}
    >
      {title}
    </h3>
  </div>
);

const SubSectionTitle = ({ title }: { title: string }) => (
  <h4 style={{ fontSize: 13, fontWeight: 700, color: ORANGE, textTransform: 'uppercase', margin: '0 0 12px', letterSpacing: '0.05em', lineHeight: 1.5 }}>
    {title}
  </h4>
);

const HorizontalBar = ({ label, score, maxLabelWidth = 140 }: { label: string; score: number; maxLabelWidth?: number }) => (
  <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 14, minHeight: 24, overflow: 'visible' }}>
    <span
      style={{
        width: maxLabelWidth,
        fontSize: 11,
        color: TEXT,
        textTransform: 'capitalize',
        flexShrink: 0,
        lineHeight: 1.5,
        paddingTop: 2,
        paddingBottom: 2,
        overflow: 'visible',
        display: 'block',
      }}
    >
      {label}
    </span>
    <div style={{ flex: 1, height: 14, minHeight: 14, border: `1px solid ${BORDER}`, backgroundColor: BAR_TRACK, position: 'relative', flexShrink: 0, alignSelf: 'center' }}>
      <div
        style={{
          height: '100%',
          width: `${score}%`,
          backgroundColor: getBarColor(score),
          position: 'absolute',
          top: 0,
          left: 0,
        }}
      />
    </div>
    <span style={{ width: 36, textAlign: 'right', fontSize: 11, fontWeight: 700, color: TEXT, flexShrink: 0, lineHeight: 1.5, paddingTop: 2, paddingBottom: 2 }}>
      {score}%
    </span>
  </div>
);

const TraitBadge = ({ label, score, variant }: { label: string; score: number; variant: 'green' | 'red' }) => (
  <span
    style={{
      fontSize: 10,
      padding: '5px 8px',
      backgroundColor: variant === 'green' ? `${GREEN}30` : `${RED}20`,
      color: variant === 'green' ? GREEN : RED,
      border: `1px solid ${variant === 'green' ? `${GREEN}50` : `${RED}40`}`,
      textTransform: 'capitalize',
      display: 'inline-block',
      marginRight: 6,
      marginBottom: 6,
      lineHeight: 1.5,
      overflow: 'visible',
    }}
  >
    {label} ({score}%)
  </span>
);

const DeepInsightsSection = ({
  deepInsights,
  topDriverTraits,
  bottomDriverTraits,
}: {
  deepInsights: IPrintableDeepInsights;
  topDriverTraits: IPrintableTrait[];
  bottomDriverTraits: IPrintableTrait[];
}) => (
  <>
    <PdfSection>
      <div style={{ border: `1px solid ${BORDER}`, padding: 24, backgroundColor: CARD }}>
        <SectionTitle label="SYSTEM.MODULE.AI_ANALYTICS" title="Deep AI Analytics & Insights" />
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
          <div style={{ border: `1px solid ${BORDER}`, padding: 16, backgroundColor: CARD }}>
            <SubSectionTitle title="Workplace Environment Fit" />
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8, marginBottom: 12 }}>
              <div style={{ fontSize: 11, color: TEXT }}>
                <span style={{ color: TEXT_MUTED }}>Startup Match: </span>
                <strong>{deepInsights.workplace_fit.startup_match_percentage}%</strong>
              </div>
              <div style={{ fontSize: 11, color: TEXT }}>
                <span style={{ color: TEXT_MUTED }}>Corporate Match: </span>
                <strong>{deepInsights.workplace_fit.corporate_match_percentage}%</strong>
              </div>
              <div style={{ fontSize: 11, color: TEXT }}>
                <span style={{ color: TEXT_MUTED }}>Autonomy: </span>
                <strong>{deepInsights.workplace_fit.autonomy_score}%</strong>
              </div>
              <div style={{ fontSize: 11, color: TEXT }}>
                <span style={{ color: TEXT_MUTED }}>Pace: </span>
                <strong>{deepInsights.workplace_fit.pace_score}%</strong>
              </div>
            </div>
            <p style={{ fontSize: 11, color: TEXT_MUTED, margin: 0, lineHeight: 1.5 }}>
              {deepInsights.workplace_fit.environment_note}
            </p>
          </div>
          <div style={{ border: `1px solid ${BORDER}`, padding: 16, backgroundColor: CARD }}>
            <SubSectionTitle title="Decision Path Under Pressure" />
            <div style={{ marginBottom: 12 }}>
              <p style={{ fontSize: 10, color: RED, fontWeight: 700, textTransform: 'uppercase', margin: '0 0 4px' }}>Primary Instinct</p>
              <p style={{ fontSize: 12, fontWeight: 600, color: TEXT, margin: '0 0 4px' }}>{deepInsights.decision_making.primary_bias.name}</p>
              <p style={{ fontSize: 11, color: TEXT_MUTED, margin: 0, lineHeight: 1.4 }}>
                {deepInsights.decision_making.primary_bias.description}
              </p>
            </div>
            <div>
              <p style={{ fontSize: 10, color: TEXT_MUTED, fontWeight: 700, textTransform: 'uppercase', margin: '0 0 4px' }}>Secondary Fallback</p>
              <p style={{ fontSize: 12, fontWeight: 600, color: TEXT, margin: '0 0 4px' }}>{deepInsights.decision_making.secondary_bias.name}</p>
              <p style={{ fontSize: 11, color: TEXT_MUTED, margin: 0, lineHeight: 1.4 }}>
                {deepInsights.decision_making.secondary_bias.description}
              </p>
            </div>
          </div>
        </div>
      </div>
    </PdfSection>

    <PdfSection>
      <div style={{ border: `1px solid ${BORDER}`, padding: 24, backgroundColor: CARD }}>
        <SubSectionTitle title="Strengths & Blind Spots" />
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
          <div style={{ border: `1px solid ${GREEN}40`, padding: 16, backgroundColor: `${GREEN}08` }}>
            <p style={{ fontSize: 10, color: GREEN, fontWeight: 700, textTransform: 'uppercase', margin: '0 0 10px' }}>The Top Drivers</p>
            <div style={{ marginBottom: 10 }}>
              {topDriverTraits.map((t, i) => (
                <TraitBadge key={i} label={formatTraitName(t)} score={traitPercent(t.score)} variant="green" />
              ))}
            </div>
            <p style={{ fontSize: 11, color: TEXT_MUTED, margin: 0, lineHeight: 1.5 }}>
              {deepInsights.strengths_blind_spots.top_drivers_note}
            </p>
          </div>
          <div style={{ border: `1px solid ${RED}40`, padding: 16, backgroundColor: `${RED}08` }}>
            <p style={{ fontSize: 10, color: RED, fontWeight: 700, textTransform: 'uppercase', margin: '0 0 10px' }}>Potential Derailers</p>
            <div style={{ marginBottom: 10 }}>
              {bottomDriverTraits.map((t, i) => (
                <TraitBadge key={i} label={formatTraitName(t)} score={traitPercent(t.score)} variant="red" />
              ))}
            </div>
            <p style={{ fontSize: 11, color: TEXT_MUTED, margin: 0, lineHeight: 1.5 }}>
              {deepInsights.strengths_blind_spots.blind_spots_note}
            </p>
          </div>
        </div>
      </div>
    </PdfSection>

    <PdfSection>
      <div style={{ border: `1px solid ${BORDER}`, padding: 24, backgroundColor: CARD }}>
        <SubSectionTitle title="Skill Gap Analysis" />
        <p style={{ fontSize: 10, color: TEXT_MUTED, textTransform: 'uppercase', margin: '0 0 4px' }}>Analyzing Target Role</p>
        <p style={{ fontSize: 18, fontWeight: 700, color: ORANGE, margin: '0 0 16px' }}>{deepInsights.skill_gap.target_role}</p>
        <p style={{ fontSize: 12, fontWeight: 600, color: TEXT, margin: '0 0 10px' }}>Recommended Action Plan</p>
        {deepInsights.skill_gap.action_plan.map((step, idx) => (
          <div key={idx} style={{ display: 'flex', gap: 12, marginBottom: 10, padding: 10, border: `1px solid ${BORDER}`, backgroundColor: CARD_ALT }}>
            <span
              style={{
                width: 24,
                height: 24,
                borderRadius: '50%',
                backgroundColor: `${ORANGE}30`,
                color: ORANGE,
                fontSize: 11,
                fontWeight: 700,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                flexShrink: 0,
              }}
            >
              {idx + 1}
            </span>
            <p style={{ fontSize: 11, color: TEXT, margin: 0, lineHeight: 1.5 }}>{step}</p>
          </div>
        ))}
      </div>
    </PdfSection>

    {deepInsights.pivot_potential?.length > 0 && (
      <PdfSection>
        <div style={{ border: `1px solid ${BORDER}`, padding: 24, backgroundColor: CARD }}>
          <SubSectionTitle title="Cross-Industry Pivot Potential" />
          {deepInsights.pivot_potential.map((ind, idx) => (
            <div key={idx} style={{ border: `1px solid ${BORDER}`, padding: 14, backgroundColor: CARD, marginBottom: 10 }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8 }}>
                <span style={{ fontSize: 13, fontWeight: 700, color: TEXT }}>{ind.industry}</span>
                <span style={{ fontSize: 11, fontWeight: 700, color: ORANGE }}>{ind.transferable_percentage}% Match</span>
              </div>
              <div style={{ height: 4, backgroundColor: BAR_TRACK }}>
                <div style={{ height: '100%', width: `${ind.transferable_percentage}%`, backgroundColor: ORANGE }} />
              </div>
            </div>
          ))}
        </div>
      </PdfSection>
    )}

    <PdfSection>
      <div style={{ border: `1px solid ${BORDER}`, padding: 24, backgroundColor: CARD }}>
        <SubSectionTitle title="Leadership Potential" />
        <div style={{ display: 'flex', gap: 20, alignItems: 'flex-start' }}>
          <div
            style={{
              width: 72,
              height: 72,
              border: `3px solid ${YELLOW}`,
              borderRadius: '50%',
              display: 'flex',
              flexDirection: 'column',
              alignItems: 'center',
              justifyContent: 'center',
              flexShrink: 0,
            }}
          >
            <span style={{ fontSize: 22, fontWeight: 900, color: YELLOW }}>{deepInsights.leadership_potential.index_score}</span>
            <span style={{ fontSize: 8, color: TEXT_MUTED, textTransform: 'uppercase' }}>Index</span>
          </div>
          <div>
            <p style={{ fontSize: 10, color: TEXT_MUTED, textTransform: 'uppercase', margin: '0 0 4px' }}>Natural Style</p>
            <p style={{ fontSize: 16, fontWeight: 700, color: YELLOW, margin: '0 0 8px' }}>{deepInsights.leadership_potential.style_name}</p>
            <p style={{ fontSize: 11, color: TEXT_MUTED, margin: 0, lineHeight: 1.5 }}>
              {deepInsights.leadership_potential.description}
            </p>
          </div>
        </div>
      </div>
    </PdfSection>
  </>
);

export const PrintableReport = React.forwardRef<HTMLDivElement, PrintableReportProps>(
  (
    {
      candidateName,
      candidateEmail,
      date,
      topRole,
      topRoleScore,
      readinessLabel,
      insights,
      domains,
      topTraits,
      topDriverTraits,
      bottomDriverTraits,
      traits,
      roles,
      customRoles,
      deepInsights,
      country = 'India',
    },
    ref
  ) => {
    const sortedDomains = [...(domains ?? [])].sort((a, b) => b.score - a.score);
    const roleChunks = chunkArray(roles ?? [], 14);
    const traitChunks = chunkArray(traits ?? [], 27);

    return (
      <div
        ref={ref}
        style={{
          width: '210mm',
          backgroundColor: BG,
          color: TEXT,
          fontFamily: 'Helvetica, Arial, sans-serif',
          boxSizing: 'border-box',
          lineHeight: 1.5,
          overflow: 'visible',
        }}
      >
        <PdfSection style={{ paddingTop: 32 }}>
          <div style={{ borderBottom: `2px solid ${ORANGE}`, paddingBottom: 24, display: 'flex', justifyContent: 'space-between', alignItems: 'flex-end' }}>
            <div>
              <h1 style={{ fontSize: 36, fontWeight: 900, textTransform: 'uppercase', letterSpacing: '-0.03em', margin: 0, color: TEXT }}>
                Skillometer
              </h1>
              <p style={{ fontSize: 12, color: TEXT_MUTED, textTransform: 'uppercase', letterSpacing: '0.15em', margin: '4px 0 0' }}>
                Assessment Results Report
              </p>
            </div>
            <div style={{ textAlign: 'right' }}>
              <p style={{ fontWeight: 700, margin: 0, color: TEXT }}>{candidateName}</p>
              {candidateEmail && <p style={{ fontSize: 12, color: TEXT_MUTED, margin: 0 }}>{candidateEmail}</p>}
              <p style={{ fontSize: 12, color: TEXT, margin: '4px 0 0' }}>{date}</p>
            </div>
          </div>
        </PdfSection>

        <PdfSection>
          <SectionTitle title="Summary" />
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>
            <div style={{ border: `1px solid ${BORDER}`, padding: 20, backgroundColor: CARD }}>
              <p style={{ fontSize: 11, color: TEXT_MUTED, textTransform: 'uppercase', margin: '0 0 8px' }}>Top Role Match</p>
              <p style={{ fontSize: 22, fontWeight: 700, color: ORANGE, margin: 0 }}>{topRole}</p>
              <p style={{ fontSize: 18, fontWeight: 700, margin: '8px 0 0', color: TEXT }}>{Math.round(topRoleScore)}% Fit</p>
            </div>
            <div style={{ border: `1px solid ${BORDER}`, padding: 20, backgroundColor: CARD }}>
              <p style={{ fontSize: 11, color: TEXT_MUTED, textTransform: 'uppercase', margin: '0 0 8px' }}>Readiness Level</p>
              <p style={{ fontSize: 22, fontWeight: 700, margin: 0, color: TEXT }}>{readinessLabel}</p>
              <p style={{ fontSize: 11, color: TEXT_MUTED, margin: '8px 0 0' }}>Based on aggregate domain performance.</p>
            </div>
          </div>
        </PdfSection>

        {insights?.length > 0 && (
          <PdfSection>
            <SectionTitle title="Key Insights" />
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
              {insights.map((insight, i) => (
                <div
                  key={i}
                  style={{
                    border: `1px solid ${BORDER}`,
                    backgroundColor: CARD,
                    padding: 14,
                    fontSize: 12,
                    color: TEXT,
                    lineHeight: 1.5,
                  }}
                >
                  {insight.text}
                </div>
              ))}
            </div>
          </PdfSection>
        )}

        <PdfSection>
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 24 }}>
            <div style={{ border: `1px solid ${BORDER}`, padding: 20, backgroundColor: CARD }}>
              <SectionTitle label="SYSTEM.METRICS" title="Domain Profile" />
              {sortedDomains.map((d, i) => (
                <HorizontalBar key={i} label={d.domain} score={d.score} maxLabelWidth={120} />
              ))}
            </div>
            <div style={{ border: `1px solid ${BORDER}`, padding: 20, backgroundColor: CARD }}>
              <SectionTitle title="Top 10 Traits" />
              {topTraits.slice(0, 10).map((t, i) => (
                <HorizontalBar key={i} label={formatTraitName(t)} score={traitPercent(t.score)} />
              ))}
            </div>
          </div>
        </PdfSection>

        {roleChunks.map((chunk, chunkIdx) => (
          <PdfSection key={`roles-${chunkIdx}`}>
            {chunkIdx === 0 && <SectionTitle title="Role Fit Scores" />}
            <div style={{ border: `1px solid ${BORDER}`, padding: 16, backgroundColor: CARD }}>
              {chunk.map((r, idx) => {
                const globalIdx = chunkIdx * 14 + idx;
                const pct = Math.round(r.score * 100);
                return (
                  <div key={r.role} style={{ marginBottom: 14, overflow: 'visible' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', fontSize: 12, marginBottom: 6, lineHeight: 1.5, minHeight: 20 }}>
                      <span style={{ fontWeight: 600, color: TEXT, lineHeight: 1.5, paddingTop: 2, paddingBottom: 2 }}>
                        <span style={{ color: TEXT_MUTED, marginRight: 8 }}>#{globalIdx + 1}</span>
                        {r.role}
                      </span>
                      <span style={{ fontWeight: 700, color: ORANGE, lineHeight: 1.5 }}>{pct}%</span>
                    </div>
                    <div style={{ height: 6, backgroundColor: BAR_TRACK }}>
                      <div style={{ height: '100%', width: `${pct}%`, backgroundColor: ORANGE }} />
                    </div>
                  </div>
                );
              })}
            </div>
          </PdfSection>
        ))}

        {traitChunks.map((chunk, chunkIdx) => (
          <PdfSection key={`traits-${chunkIdx}`}>
            {chunkIdx === 0 && <SectionTitle title="All Trait Scores" />}
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr', gap: 8 }}>
              {chunk.map((t, i) => {
                const pct = traitPercent(t.score);
                return (
                  <div
                    key={i}
                    style={{
                      display: 'flex',
                      justifyContent: 'space-between',
                      alignItems: 'center',
                      padding: '10px 12px',
                      border: `1px solid ${BORDER}`,
                      backgroundColor: CARD_ALT,
                      fontSize: 11,
                      lineHeight: 1.5,
                      minHeight: 36,
                      overflow: 'visible',
                    }}
                  >
                    <span style={{ color: TEXT, textTransform: 'capitalize', paddingRight: 8, lineHeight: 1.5, overflow: 'visible' }}>
                      {formatTraitName(t)}
                    </span>
                    <span style={{ fontWeight: 700, color: getBarColor(pct), flexShrink: 0, lineHeight: 1.5 }}>{pct}%</span>
                  </div>
                );
              })}
            </div>
          </PdfSection>
        ))}

        {customRoles && customRoles.length > 0 && (
          <PdfSection>
            <div style={{ border: `1px solid ${BORDER}`, padding: 24, backgroundColor: CARD }}>
              <SectionTitle label="SYSTEM.MODULE.AI_RESULTS" title={`Market Fit Analysis — ${country}`} />
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr', gap: 16 }}>
                {customRoles.map((role, idx) => (
                  <div key={idx} style={{ border: `1px solid ${BORDER}`, padding: 16, backgroundColor: CARD }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 10 }}>
                      <div
                        style={{
                          height: 28,
                          width: 28,
                          backgroundColor: ORANGE,
                          color: TEXT,
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          fontWeight: 700,
                          fontSize: 11,
                        }}
                      >
                        {Math.round(role.match_score * 100)}
                      </div>
                      <span style={{ fontSize: 10, color: TEXT_MUTED, textTransform: 'uppercase', letterSpacing: '0.1em' }}>
                        Match Score
                      </span>
                    </div>
                    <h4 style={{ fontSize: 14, fontWeight: 700, textTransform: 'uppercase', margin: '0 0 10px', color: TEXT, lineHeight: 1.4 }}>
                      {role.role_name}
                    </h4>
                    <div>
                      {role.critical_traits?.map((trait) => (
                        <div key={trait} style={{ display: 'flex', alignItems: 'flex-start', gap: 6, fontSize: 10, color: TEXT_MUTED, marginBottom: 6, lineHeight: 1.5, overflow: 'visible' }}>
                          <div style={{ height: 1, width: 12, backgroundColor: `${ORANGE}80`, flexShrink: 0, marginTop: 7 }} />
                          <span style={{ textTransform: 'uppercase', lineHeight: 1.5 }}>{trait.replace(/_/g, ' ')}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </PdfSection>
        )}

        {deepInsights && (
          <DeepInsightsSection
            deepInsights={deepInsights}
            topDriverTraits={topDriverTraits}
            bottomDriverTraits={bottomDriverTraits}
          />
        )}

        <PdfSection style={{ paddingBottom: 32 }}>
          <div
            style={{
              paddingTop: 16,
              borderTop: `1px solid ${BORDER}`,
              fontSize: 10,
              textAlign: 'center',
              color: TEXT_MUTED,
              textTransform: 'uppercase',
              letterSpacing: '0.15em',
            }}
          >
            Powered by SKITRE AI — Skillometer
          </div>
        </PdfSection>
      </div>
    );
  }
