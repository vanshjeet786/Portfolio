import { useState, useEffect } from 'react';
import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Badge } from '@/components/ui/badge';
import { Check, Plus, Users } from 'lucide-react';
import { ScrollArea } from '@/components/ui/scroll-area';

interface AssignGroupPopoverProps {
  selectedCandidateIds: string[];
  candidateGroups: Record<string, string[]>;
  onAssignGroup: (groupId: string, groupName: string) => void;
  availableGroups: { id: string; name: string }[];
  onCreateGroup: (name: string) => void;
}

export function AssignGroupPopover({
  selectedCandidateIds,
  candidateGroups,
  onAssignGroup,
  availableGroups,
  onCreateGroup,
}: AssignGroupPopoverProps) {
  const [open, setOpen] = useState(false);
  const [newGroupName, setNewGroupName] = useState('');

  const handleCreate = () => {
    if (newGroupName.trim()) {
      onCreateGroup(newGroupName.trim());
      setNewGroupName('');
    }
  };

  return (
    <Popover open={open} onOpenChange={setOpen}>
      <PopoverTrigger asChild>
        <Button variant="outline" size="sm" className="h-8">
          <Users className="mr-2 h-4 w-4" />
          Assign Group
        </Button>
      </PopoverTrigger>
      <PopoverContent className="w-64 p-0 rounded-none terminal-border" align="start">
        <div className="p-3 border-b border-border">
          <p className="text-sm font-medium mb-2">Assign to existing group</p>
          <ScrollArea className="h-[120px]">
            <div className="space-y-1">
              {availableGroups.length === 0 ? (
                <p className="text-xs text-muted-foreground py-2 text-center">No groups created yet</p>
              ) : (
                availableGroups.map((group) => {
                  // Check if ALL selected candidates are in this group
                  const allInGroup = selectedCandidateIds.every(id =>
                    candidateGroups[id]?.includes(group.id)
                  );
                  // Check if SOME selected candidates are in this group
                  const someInGroup = !allInGroup && selectedCandidateIds.some(id =>
                    candidateGroups[id]?.includes(group.id)
                  );

                  return (
                    <Button
                      key={group.id}
                      variant="ghost"
                      size="sm"
                      className="w-full justify-start font-normal h-8"
                      onClick={() => onAssignGroup(group.id, group.name)}
                    >
                      <div className="flex items-center w-full">
                        <div className="w-4 mr-2 flex justify-center">
                          {allInGroup && <Check className="h-3 w-3" />}
                          {someInGroup && <div className="h-1.5 w-1.5 rounded-full bg-primary" />}
                        </div>
                        {group.name}
                      </div>
                    </Button>
                  );
                })
              )}
            </div>
          </ScrollArea>
        </div>
        <div className="p-3">
          <p className="text-sm font-medium mb-2">Create new group</p>
          <div className="flex gap-2">
            <Input
              placeholder="Group name"
              value={newGroupName}
              onChange={(e) => setNewGroupName(e.target.value)}
              className="h-8 text-sm"
              onKeyDown={(e) => {
                if (e.key === 'Enter') {
                  e.preventDefault();
                  handleCreate();
                }
              }}
            />
            <Button size="sm" className="h-8 px-2" onClick={handleCreate} disabled={!newGroupName.trim()}>
              <Plus className="h-4 w-4" />
            </Button>
          </div>
        </div>
      </PopoverContent>
    </Popover>
  );
}
