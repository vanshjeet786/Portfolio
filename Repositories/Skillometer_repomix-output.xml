<file path="src/contexts/AuthContext.tsx">
import React, { createContext, useContext, useState, useCallback, useEffect } from 'react';
import { supabase } from '@/integrations/supabase/client';

export type UserRole = 'candidate' | 'hr_admin' | 'super_admin' | 'dev_admin' | 'team_lead' | 'member';

export interface AuthUser {
  id: string;
  name: string;
  email: string;
  role: UserRole;
  bio?: string;
}

interface AuthContextType {
  user: AuthUser | null;
  isLoading: boolean;
  login: (email: string, password: string) => Promise<void>;
  signup: (name: string, email: string, password: string, professionalBackground?: string, experienceLevel?: string) => Promise<void>;
  logout: () => void;
  switchRole: (role: UserRole) => void;
  updateProfile: (updates: Partial<AuthUser>) => void;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

// Mock users for demo
const MOCK_USERS: Record<string, AuthUser> = {
  'candidate@demo.com': { id: '00000000-0000-0000-0000-000000000001', name: 'Alex Candidate', email: 'candidate@demo.com', role: 'candidate', bio: '' },
  'hr@demo.com': { id: '00000000-0000-0000-0000-000000000002', name: 'Sarah HR Admin', email: 'hr@demo.com', role: 'hr_admin', bio: '' },
  'admin@demo.com': { id: '00000000-0000-0000-0000-000000000003', name: 'Mike Super Admin', email: 'admin@demo.com', role: 'super_admin', bio: '' },
};

export function AuthProvider({ children }: { children: React.ReactNode }) {
  const [user, setUser] = useState<AuthUser | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  const loadProfile = async (sessionUser: Record<string, unknown>) => {
    if (!sessionUser) {
      setUser(null);
      return;
    }
    const { data: profile } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', sessionUser.id)
      .maybeSingle();

    if (profile) {
      setUser({
        id: profile.id,
        name: profile.full_name || sessionUser.email.split('@')[0],
        email: profile.email,
        role: (profile.role as UserRole) || 'candidate',
        bio: profile.professional_background || '',
      });
    } else {
      setUser({
        id: sessionUser.id,
        name: sessionUser.email.split('@')[0],
        email: sessionUser.email,
        role: 'candidate',
        bio: '',
      });
    }
  };

  useEffect(() => {
    supabase.auth.getSession().then(({ data: { session } }) => {
      loadProfile(session?.user).finally(() => setIsLoading(false));
    });

    const { data: { subscription } } = supabase.auth.onAuthStateChange((_event, session) => {
      loadProfile(session?.user);
    });

    return () => subscription.unsubscribe();
  }, []);

  const login = useCallback(async (email: string, password: string) => {
    setIsLoading(true);
    if (MOCK_USERS[email]) {
      const mockUser = MOCK_USERS[email];
      setUser(mockUser);
      setIsLoading(false);
      return;
    }

    const { error } = await supabase.auth.signInWithPassword({ email, password });
    setIsLoading(false);
    if (error) throw error;
  }, []);

  const signup = useCallback(async (name: string, email: string, password: string, professionalBackground?: string, experienceLevel?: string) => {
    setIsLoading(true);
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: { data: { full_name: name } }
    });

    if (error) { setIsLoading(false); throw error; }

    if (data.user) {
      const { error: profileError } = await (supabase as unknown as Record<string, unknown>)
        .from('profiles')
        .upsert({
          id: data.user.id,
          email,
          role: 'candidate',
          full_name: name,
          professional_background: professionalBackground,
          experience_level: experienceLevel
        });
      if (profileError) console.error('Error creating profile:', profileError);
    }

    setIsLoading(false);
  }, []);

  const logout = useCallback(async () => {
    setIsLoading(true);
    await supabase.auth.signOut();
    setUser(null);
    setIsLoading(false);
  }, []);

  const switchRole = useCallback((role: UserRole) => {
    if (user) setUser({ ...user, role });
  }, [user]);

  const updateProfile = useCallback((updates: Partial<AuthUser>) => {
    if (user) setUser({ ...user, ...updates });
  }, [user]);

  return (
    <AuthContext.Provider value={{ user, isLoading, login, signup, logout, switchRole, updateProfile }}>
      {children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  const ctx = useContext(AuthContext);
  if (!ctx) throw new Error('useAuth must be used within AuthProvider');
  return ctx;
}
</file>

