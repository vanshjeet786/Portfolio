  const [orgMembers, setOrgMembers] = useState<OrgMember[]>([]);
  const [showCreate, setShowCreate] = useState(false);
  const [endorseeId, setEndorseeId] = useState('');
  const [trait, setTrait] = useState('');
  const [comment, setComment] = useState('');

  useEffect(() => {
    if (!currentOrg || !user) return;
    // Fetch endorsements for current user
    fetchEndorsements(user.id, currentOrg.orgId).then(setEndorsements);
    fetchOrgMembers(currentOrg.orgId).then(setOrgMembers);
  }, [currentOrg, user]);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!currentOrg || !endorseeId || !trait) return;
    const ok = await createEndorsement(endorseeId, currentOrg.orgId, trait, comment);
    if (ok) {
      toast.success('Endorsement created!');
      setShowCreate(false); setEndorseeId(''); setTrait(''); setComment('');
      // Refresh endorsements for the endorsee
      fetchEndorsements(endorseeId, currentOrg.orgId);
    } else {
      toast.error('Failed to create endorsement');
    }
  };

  return (
    <AppLayout>
      <div className="max-w-4xl mx-auto space-y-6">
        <div className="flex items-center justify-between">
          <h1 className="text-3xl font-bold tracking-tight flex items-center gap-2">
            <Award className="h-8 w-8" /> Endorsements
          </h1>
          {currentOrg && (
            <Button onClick={() => setShowCreate(!showCreate)}><Plus className="h-4 w-4 mr-2" /> Endorse Someone</Button>
          )}
        </div>

        {showCreate && currentOrg && (
          <Card>
            <CardHeader><CardTitle>Endorse a Colleague</CardTitle></CardHeader>
            <CardContent>
              <form onSubmit={handleCreate} className="space-y-4">
                <div className="grid grid-cols-2 gap-4">
                  <div className="space-y-2">
                    <Label>Colleague</Label>
                    <Select value={endorseeId} onValueChange={setEndorseeId}>
                      <SelectTrigger><SelectValue placeholder="Select a colleague" /></SelectTrigger>
                      <SelectContent>
                        {orgMembers.filter(m => m.user_id !== user?.id).map(m => (
                          <SelectItem key={m.user_id} value={m.user_id}>
                            {m.profile?.full_name || m.profile?.email}
                          </SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  </div>
                  <div className="space-y-2">
                    <Label>Trait</Label>
                    <Select value={trait} onValueChange={setTrait}>
                      <SelectTrigger><SelectValue placeholder="Select a trait" /></SelectTrigger>
                      <SelectContent>
                        {TRAIT_OPTIONS.map(t => <SelectItem key={t} value={t}>{t}</SelectItem>)}
                      </SelectContent>
                    </Select>
                  </div>
                </div>
                <div className="space-y-2">
                  <Label>Comment (optional)</Label>
                  <Textarea value={comment} onChange={e => setComment(e.target.value)} rows={2} placeholder="Share why you're endorsing this trait..." />
                </div>
                <Button type="submit" disabled={!endorseeId || !trait}>Endorse</Button>
              </form>
            </CardContent>
          </Card>
        )}

        <Card>
          <CardHeader>
            <CardTitle>Your Endorsements</CardTitle>
            <CardDescription>Traits endorsed by your colleagues</CardDescription>
          </CardHeader>
          <CardContent>
            {!currentOrg ? (
              <p className="text-muted-foreground text-center py-8">Join an organization to see endorsements</p>
            ) : endorsements.length === 0 ? (
              <p className="text-muted-foreground text-center py-8">No endorsements received yet</p>
            ) : (
              <div className="space-y-3">
                {endorsements.map(e => (
                  <div key={e.id} className="flex items-start gap-3 p-4 border rounded-lg">
                    <div className="p-2 bg-primary/10 rounded-full">
                      <Star className="h-5 w-5 text-primary" />
                    </div>
                    <div className="flex-1">
                      <div className="flex items-center gap-2">
                        <Badge variant="secondary">{e.trait}</Badge>
                        <span className="text-xs text-muted-foreground">
                          {formatDistanceToNow(new Date(e.created_at), { addSuffix: true })}
                        </span>
                      </div>
                      {e.comment && <p className="text-sm mt-1">{e.comment}</p>}
                      <p className="text-xs text-muted-foreground mt-1">
                        By {e.endorser_profile?.full_name || e.endorser_profile?.email || 'Anonymous'}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </CardContent>
        </Card>
      </div>
    </AppLayout>
  );
}
</file>

<file path="src/pages/Growth.tsx">
import { useState, useEffect, useMemo } from 'react';
import { useNavigate } from 'react-router-dom';
import { AppLayout } from '@/components/AppLayout';
import { Badge } from '@/components/ui/badge';
import { Progress } from '@/components/ui/progress';
import { Button } from '@/components/ui/button';
import { fetchAssessmentHistory } from '@/lib/supabase-stubs';
import { useAuth } from '@/contexts/AuthContext';
import type { MockAssessmentResult } from '@/lib/supabase-stubs';
import { Target, ArrowLeft, Lightbulb, TrendingUp } from 'lucide-react';

const DOMAIN_LABELS: Record<string, string> = {
  decision_making: 'Decision Making',
  behavioral_style: 'Behavioral Style',
  communication: 'Communication',
  emotional_intelligence: 'Emotional Intelligence',
  professional_readiness: 'Professional Readiness',
  learning_agility: 'Learning Agility',
};

const DOMAIN_SUGGESTIONS: Record<string, string[]> = {
  decision_making: [
    'Practice structured decision frameworks (e.g., pros/cons matrix, weighted scoring)',
    'Seek feedback on past decisions to identify blind spots',
    'Try time-boxed decision-making exercises to improve speed',
  ],
  behavioral_style: [
    'Experiment with new approaches to familiar tasks',
    'Build a personal routine that balances structure with flexibility',
    'Take on cross-functional projects to broaden your adaptability',
  ],
  communication: [
    'Practice active listening exercises in meetings',
    'Record and review your presentations for clarity improvements',
    'Seek out negotiation or public speaking training',
  ],
  emotional_intelligence: [
    'Keep a journal of emotional reactions and triggers',
    'Practice empathy mapping when resolving team conflicts',
    'Develop a habit of asking open-ended questions in conversations',
  ],
  professional_readiness: [
    'Create a personal accountability framework with deadlines',
    'Seek mentorship from experienced professionals in your field',
    'Take ownership of a challenging project end-to-end',
  ],
  learning_agility: [
    'Dedicate weekly time to learning new tools or concepts',
    'Actively seek constructive feedback and create action plans',
    'Reflect on recent mistakes and document the lessons learned',
  ],
};

const Growth = () => {
  const { user } = useAuth();
  const [result, setResult] = useState<MockAssessmentResult | null>(null);
  const navigate = useNavigate();

  useEffect(() => {
    if (user?.id) {
      fetchAssessmentHistory(user.id).then(data => {
        if (data.length > 0) setResult(data[0]);
      });
    }
  }, [user?.id]);

  const weakDomains = useMemo(() => {
    if (!result) return [];
    return Object.entries(result.domain_scores)
      .sort(([, a], [, b]) => (a as number) - (b as number))
      .slice(0, 3)
      .map(([key, val]) => ({
        key,
        label: DOMAIN_LABELS[key] || key,
        current: val as number,
        target: Math.min(0.85, (val as number) + 0.15),
        suggestions: DOMAIN_SUGGESTIONS[key] || [],
      }));
  }, [result]);

  const weakTraits = useMemo(() => {
    if (!result) return [];
    return Object.entries(result.trait_scores)
      .sort(([, a], [, b]) => (a as number) - (b as number))
      .slice(0, 5)
      .map(([trait, score]) => ({
        trait,
        current: score as number,
        target: Math.min(0.85, (score as number) + 0.15),
      }));
  }, [result]);

  if (!result) {
    return (
      <AppLayout>
        <div className="max-w-3xl mx-auto text-center py-20 space-y-6">
          <h1 className="text-3xl font-semibold tracking-tight">No Data Yet</h1>
          <p className="text-muted-foreground">Complete an assessment to see your personalized growth plan.</p>
          <Button onClick={() => navigate('/assessment')}>Take Assessment</Button>
        </div>
      </AppLayout>
    );
  }

  return (
    <AppLayout>
      <div className="max-w-5xl mx-auto space-y-8 pb-12">
        <div className="flex items-center gap-3">
          <Button variant="ghost" size="icon" onClick={() => navigate('/dashboard')}>
            <ArrowLeft className="h-4 w-4" />
          </Button>
          <div>
            <h1 className="text-2xl font-bold tracking-tight flex items-center gap-2">
              <Target className="h-6 w-6 text-primary" /> Growth Plan
            </h1>
            <p className="text-sm text-muted-foreground mt-1">Personalized development recommendations based on your latest assessment</p>
          </div>
        </div>

        {/* Weak Domains */}
        <div>
          <h2 className="text-lg font-semibold mb-4">Priority Development Areas</h2>
          <div className="space-y-4">
            {weakDomains.map(({ key, label, current, target, suggestions }) => (
              <div key={key} className="rounded-none terminal-border border bg-card p-6 space-y-4">
                <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                  <div>
                    <h3 className="font-semibold text-lg">{label}</h3>
                    <p className="text-sm text-muted-foreground">
                      Current: {Math.round(current * 100)}% → Target: {Math.round(target * 100)}%
                    </p>
                  </div>
                  <Badge variant="secondary" className="flex items-center gap-1">
                    <TrendingUp className="h-3 w-3" />
                    +{Math.round((target - current) * 100)}% goal
                  </Badge>
                </div>
                <div className="space-y-1">
                  <div className="flex justify-between text-xs text-muted-foreground">
                    <span>Current</span>
                    <span>Target</span>
                  </div>
                  <div className="relative h-3 rounded-none bg-muted">
                    <div className="absolute h-full rounded-none bg-primary" style={{ width: `${current * 100}%` }} />
                    <div className="absolute h-full w-0.5 bg-foreground/60 rounded" style={{ left: `${target * 100}%` }} />
                  </div>
                </div>
                <div className="space-y-2 pt-2">
                  <div className="flex items-center gap-2 text-sm font-medium text-muted-foreground">
                    <Lightbulb className="h-4 w-4" /> Suggested Actions
                  </div>
                  {suggestions.map((s, i) => (
                    <p key={i} className="text-sm pl-6 text-foreground">• {s}</p>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Weak Traits */}
        <div>
          <h2 className="text-lg font-semibold mb-4">Traits to Develop</h2>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {weakTraits.map(({ trait, current, target }) => (
              <div key={trait} className="rounded-none terminal-border border bg-card p-4 space-y-3">
                <h3 className="font-medium text-sm capitalize">{trait.replace(/_/g, ' ')}</h3>
                <div className="flex items-end gap-2">
                  <span className="text-2xl font-bold">{Math.round(current * 100)}</span>
                  <span className="text-muted-foreground text-sm mb-0.5">→ {Math.round(target * 100)}</span>
                </div>
                <Progress value={current * 100} className="h-2" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </AppLayout>
  );
};

export default Growth;
</file>

<file path="src/pages/Home.tsx">
import { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { format } from 'date-fns';
import { Radar, RadarChart, PolarGrid, PolarAngleAxis, PolarRadiusAxis, ResponsiveContainer } from 'recharts';
import { ArrowRight, Activity, Target, Flame, Trophy } from 'lucide-react';
import { useAuth } from '@/contexts/AuthContext';
import { AppLayout } from '@/components/AppLayout';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle, CardFooter } from '@/components/ui/card';
import { fetchAssessmentHistory, MockAssessmentResult } from '@/lib/supabase-stubs';

export default function Home() {
  const { user } = useAuth();
  const navigate = useNavigate();
  const [history, setHistory] = useState<MockAssessmentResult[]>([]);
  const [isLoading, setIsLoading] = useState(true);

  useEffect(() => {
    if (user) {
      fetchAssessmentHistory(user.id).then(data => {
        setHistory(data);
        setIsLoading(false);
      });
    }
  }, [user]);

  const latestAssessment = history.length > 0 ? history[0] : null;

  // Domain score data for radar chart
  const radarData = latestAssessment
    ? Object.entries(latestAssessment.domain_scores).map(([domain, score]) => ({
        domain: domain.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
        score: Math.round(score * 100),
      }))
    : [];

  // Top roles logic
  const topRoles = latestAssessment
    ? Object.entries(latestAssessment.role_scores)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 5)
    : [];

  // Weakest domain for Goals
  const weakestDomain = latestAssessment
    ? Object.entries(latestAssessment.domain_scores).reduce((min, curr) => curr[1] < min[1] ? curr : min, ['None', 1])
    : null;

  const getGreeting = () => {
    const hour = new Date().getHours();
    if (hour < 12) return 'Good morning';
    if (hour < 18) return 'Good afternoon';
    return 'Good evening';
  };

  const calculateStreak = () => {
    return history.length; // Simplified streak based on total assessments for demo
  };

  const getPercentile = () => {
    if (!latestAssessment) return 0;
    const avgScore = Object.values(latestAssessment.domain_scores).reduce((a, b) => a + b, 0) / Object.keys(latestAssessment.domain_scores).length;
    // Mock percentile logic based on score (0.5 to 1.0 mapping roughly to 0-100th percentile)
    return Math.max(0, Math.min(Math.round(((avgScore - 0.5) / 0.5) * 100), 99));
  };

  return (
    <AppLayout>
    <div className="max-w-6xl mx-auto space-y-6">

      {/* 1. Welcome Banner */}
      <Card className="bg-primary/5 border-primary/20">
        <CardContent className="p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div>
            <h1 className="text-3xl font-bold tracking-tight">
              {getGreeting()}, {user?.name.split(' ')[0]}! 👋
            </h1>
            <p className="text-muted-foreground mt-2">
              Ready to explore your professional DNA? Keep growing and discovering your ideal roles.
            </p>
          </div>
          <div className="flex gap-3 w-full sm:w-auto">
            <Button onClick={() => navigate('/assessment')}>Take Assessment</Button>
            {latestAssessment && (
              <Button variant="outline" onClick={() => navigate('/results')}>View Latest Results</Button>
            )}
          </div>
        </CardContent>
      </Card>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">

        {/* 2. Score Snapshot */}
        <Card>
          <CardHeader>
            <CardTitle>Score Snapshot</CardTitle>
            <CardDescription>Your latest domain performance</CardDescription>
          </CardHeader>
          <CardContent className="h-[300px] flex items-center justify-center">
            {isLoading ? (
              <div className="text-muted-foreground animate-pulse">Loading...</div>
            ) : latestAssessment ? (
              <ResponsiveContainer width="100%" height="100%">
                <RadarChart cx="50%" cy="50%" outerRadius="70%" data={radarData}>
                  <PolarGrid stroke="var(--border)" />
                  <PolarAngleAxis dataKey="domain" tick={{ fill: 'currentColor', fontSize: 10 }} />
                  <PolarRadiusAxis angle={30} domain={[0, 100]} tick={false} />
                  <Radar name="Score" dataKey="score" stroke="hsl(var(--primary))" fill="hsl(var(--primary))" fillOpacity={0.4} />
                </RadarChart>
              </ResponsiveContainer>
            ) : (
              <div className="text-center space-y-4">
                <p className="text-muted-foreground">No assessments taken yet.</p>
                <Button variant="secondary" onClick={() => navigate('/assessment')}>Start Your First Assessment</Button>
              </div>
            )}
          </CardContent>
        </Card>

        {/* 3. Activity Feed */}
        <Card>
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Activity className="h-5 w-5 text-primary" />
              Recent Activity
            </CardTitle>
          </CardHeader>
          <CardContent>
            {isLoading ? (
              <div className="text-muted-foreground">Loading...</div>
            ) : history.length > 0 ? (
              <div className="space-y-6">
                {history.slice(0, 4).map((record, i) => (
                  <div key={i} className="flex gap-4 relative">
                    {i !== history.length - 1 && i !== 3 && (
                      <div className="absolute left-[11px] top-7 bottom-[-24px] w-px bg-border" />
                    )}
                    <div className="mt-1 h-6 w-6 rounded-none bg-primary/10 flex items-center justify-center z-10 shrink-0">
                      <div className="h-2 w-2 rounded-none bg-primary" />
                    </div>
                    <div>
                      <p className="text-sm font-medium">Completed Assessment</p>
                      <p className="text-xs text-muted-foreground">{format(new Date(record.date), 'PPP')}</p>
                      <p className="text-sm mt-1">
                        Top match: <span className="font-semibold">{Object.entries(record.role_scores).sort((a,b)=>b[1]-a[1])[0][0]}</span>
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <p className="text-muted-foreground text-center py-8">No activity to display.</p>
            )}
          </CardContent>
        </Card>

        {/* 4. Leaderboard Card */}
        <Card className="bg-gradient-to-br from-card to-muted">
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Trophy className="h-5 w-5 text-yellow-500" />
              Leaderboard Standing
            </CardTitle>
          </CardHeader>
          <CardContent className="flex flex-col items-center justify-center py-12 text-center space-y-4">
            {latestAssessment ? (
              <>
                <div className="text-5xl font-bold text-primary mb-2">Top {100 - getPercentile()}%</div>
                <p className="text-muted-foreground">of candidates in overall scoring.</p>
              </>
            ) : (
              <p className="text-muted-foreground">Take an assessment to see your ranking.</p>
            )}
          </CardContent>
        </Card>

        {/* 5. Goals/Streak Tracker */}
        <Card>
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Target className="h-5 w-5 text-primary" />
              Current Goals & Streaks
            </CardTitle>
          </CardHeader>
          <CardContent className="space-y-6">
            <div className="flex items-center gap-4 bg-orange-500/10 p-4 rounded-none terminal-border">
              <div className="p-3 bg-orange-500/20 rounded-none">
                <Flame className="h-6 w-6 text-orange-500" />
              </div>
              <div>
                <p className="font-medium text-lg">{calculateStreak()} Assessment Streak</p>
                <p className="text-sm text-muted-foreground">Keep it up!</p>
              </div>
            </div>

            {weakestDomain && (
              <div className="space-y-2">
                <div className="flex justify-between text-sm">
                  <span className="font-medium">Focus Area: {weakestDomain[0].split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}</span>
                  <span className="text-muted-foreground">{Math.round(weakestDomain[1] * 100)} / 100</span>
                </div>
                <div className="h-2 w-full bg-secondary rounded-none overflow-hidden">
                  <div className="h-full bg-primary" style={{ width: `${weakestDomain[1] * 100}%` }} />
                </div>
                <p className="text-xs text-muted-foreground">Target: 75% for next assessment</p>
              </div>
            )}
          </CardContent>
        </Card>

      </div>

      {/* 6. Recommended Roles Carousel */}
      {latestAssessment && (
        <Card>
          <CardHeader>
            <CardTitle>Recommended Roles</CardTitle>
            <CardDescription>Based on your latest assessment</CardDescription>
          </CardHeader>
          <CardContent>
            <div className="flex gap-4 overflow-x-auto pb-4 snap-x">
              {topRoles.map(([role, score], idx) => (
                <Card
                  key={role}
                  className="min-w-[250px] cursor-pointer hover:border-primary transition-colors snap-start shrink-0"
                  onClick={() => navigate('/results')}
                >
                  <CardHeader className="pb-2">
                    <CardTitle className="text-base">{role}</CardTitle>
                    <CardDescription>Match Score</CardDescription>
                  </CardHeader>
                  <CardContent>
                    <div className="text-2xl font-bold text-primary">{Math.round(score * 100)}%</div>
                  </CardContent>
                  <CardFooter className="pt-0">
                    <Button variant="ghost" className="w-full justify-between p-0 h-auto" onClick={(e) => { e.stopPropagation(); navigate('/results'); }}>
                      View Details <ArrowRight className="h-4 w-4" />
                    </Button>
                  </CardFooter>
                </Card>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

    </div>
    </AppLayout>
  );
}
</file>

