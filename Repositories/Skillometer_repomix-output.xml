<file path="advanced_roles.sql">
-- Create permissions table
CREATE TABLE IF NOT EXISTS public.permissions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name TEXT NOT NULL UNIQUE,
    description TEXT
);

-- Create role_permissions table
CREATE TABLE IF NOT EXISTS public.role_permissions (
    role TEXT NOT NULL,
    permission_id UUID NOT NULL REFERENCES public.permissions(id) ON DELETE CASCADE,
    PRIMARY KEY (role, permission_id)
);

-- Insert baseline permissions
INSERT INTO public.permissions (name, description) VALUES
    ('manage_organization', 'Can edit organization details and settings'),
    ('manage_members', 'Can invite, remove, and change roles of members'),
    ('view_reports', 'Can view organizational reports and analytics'),
    ('broadcast', 'Can send organization-wide announcements')
ON CONFLICT (name) DO NOTHING;

-- Map permissions to roles
DO $$
DECLARE
    p_manage_org UUID;
    p_manage_mem UUID;
    p_view_rep UUID;
    p_broadcast UUID;
BEGIN
    SELECT id INTO p_manage_org FROM public.permissions WHERE name = 'manage_organization';
    SELECT id INTO p_manage_mem FROM public.permissions WHERE name = 'manage_members';
    SELECT id INTO p_view_rep FROM public.permissions WHERE name = 'view_reports';
    SELECT id INTO p_broadcast FROM public.permissions WHERE name = 'broadcast';

    -- super_admin gets all
    INSERT INTO public.role_permissions (role, permission_id) VALUES
        ('super_admin', p_manage_org),
        ('super_admin', p_manage_mem),
        ('super_admin', p_view_rep),
        ('super_admin', p_broadcast)
    ON CONFLICT DO NOTHING;

    -- hr_admin gets manage_members, view_reports, broadcast
    INSERT INTO public.role_permissions (role, permission_id) VALUES
        ('hr_admin', p_manage_mem),
        ('hr_admin', p_view_rep),
        ('hr_admin', p_broadcast)
    ON CONFLICT DO NOTHING;

    -- team_lead gets view_reports
    INSERT INTO public.role_permissions (role, permission_id) VALUES
        ('team_lead', p_view_rep)
    ON CONFLICT DO NOTHING;
END $$;

-- Migrate legacy roles to super_admin
UPDATE public.org_memberships
SET role = 'super_admin'
WHERE role IN ('owner', 'admin', 'dev_admin');

UPDATE public.invitations
SET role = 'super_admin'
WHERE role IN ('owner', 'admin', 'dev_admin');
