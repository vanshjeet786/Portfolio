<file path="src/components/background/TechSingularityBackground.tsx">
import React, { useEffect, useState, useMemo } from 'react';
import { motion, AnimatePresence } from 'framer-motion';

// Tech debris items in ASCII or simple unicode style to emulate 8-bit/pixel-art style
const DEBRIS_ITEMS = [
  '💻', '📱', '💾', '💿', '🕹️', '⌨️', '🖱️', '🔋', '🔌', '📟',
  '{ }', '</>', '[]', '()', '01', '10', '##', '&&', '||', '=>',
];

interface Debris {
  id: string;
  item: string;
  startX: number;
  startY: number;
  duration: number;
  delay: number;
  color: string;
  scale: number;
}

export const TechSingularityBackground: React.FC = () => {
  const [debrisList, setDebrisList] = useState<Debris[]>([]);

  // Generate random items continuously
  useEffect(() => {
    let idCounter = 0;

    // Create initial batch
    const createItem = (): Debris => {
      // Determine spawn edge (0: top, 1: right, 2: bottom, 3: left)
      const edge = Math.floor(Math.random() * 4);
      let startX = 0;
      let startY = 0;

      switch (edge) {
        case 0: // Top
          startX = Math.random() * 100;
          startY = -10;
          break;
        case 1: // Right
          startX = 110;
          startY = Math.random() * 100;
          break;
        case 2: // Bottom
          startX = Math.random() * 100;
          startY = 110;
          break;
        case 3: // Left
          startX = -10;
          startY = Math.random() * 100;
          break;
      }

      const colors = ['#FFA600', '#FFA600', '#00FFFF', '#FF00FF']; // Mostly orange, some cyan/magenta

      return {
        id: `debris-${idCounter++}-${Date.now()}`,
        item: DEBRIS_ITEMS[Math.floor(Math.random() * DEBRIS_ITEMS.length)],
        startX,
        startY,
        duration: 10 + Math.random() * 20, // 10-30s slow drift
        delay: Math.random() * 5,
        color: colors[Math.floor(Math.random() * colors.length)],
        scale: 0.5 + Math.random() * 1.5,
      };
    };

    // Initial fill
    const initialDebris = Array.from({ length: 50 }, createItem);
    setDebrisList(initialDebris);

    // Continuous spawner
    const interval = setInterval(() => {
      setDebrisList((prev) => {
        // Keep list bounded, remove old items, add new ones
        const list = prev.length > 150 ? prev.slice(20) : [...prev];
        return [...list, createItem(), createItem()];
      });
    }, 1000);

    return () => clearInterval(interval);
  }, []);

  // Living Constellation nodes
  const nodes = useMemo(() => Array.from({ length: 30 }, (_, i) => ({
    id: i,
    x: Math.random() * 100,
    y: Math.random() * 100,
    duration: 20 + Math.random() * 40,
    delay: Math.random() * -20,
  })), []);

  return (
    <div className="fixed inset-0 z-[-1] overflow-hidden bg-black pointer-events-none">
      {/* Deep Background Grid / Constellation */}
      <div className="absolute inset-0 opacity-20">
        <svg className="w-full h-full">
          <defs>
            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#FFA600" strokeWidth="0.5" strokeOpacity="0.2" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#grid)" />

          {/* Connecting lines between some nodes */}
          {nodes.map((node, i) => {
            if (i % 3 === 0 && i < nodes.length - 1) {
              return (
                <motion.line
                  key={`line-${i}`}
                  x1={`${node.x}%`} y1={`${node.y}%`}
                  x2={`${nodes[i+1].x}%`} y2={`${nodes[i+1].y}%`}
                  stroke="#FFA600"
                  strokeWidth="0.5"
                  strokeOpacity="0.3"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: [0, 0.5, 0] }}
                  transition={{ duration: 5 + Math.random() * 5, repeat: Infinity, repeatType: "mirror" }}
                />
              );
            }
            return null;
          })}
        </svg>

        {/* Floating nodes */}
        {nodes.map((node) => (
          <motion.div
            key={`node-${node.id}`}
            className="absolute w-1 h-1 bg-[#FFA600] rounded-full shadow-[0_0_8px_#FFA600]"
            initial={{ left: `${node.x}%`, top: `${node.y}%`, opacity: 0.1 }}
            animate={{
              left: [`${node.x}%`, `${(node.x + 10) % 100}%`, `${node.x}%`],
              top: [`${node.y}%`, `${(node.y + 10) % 100}%`, `${node.y}%`],
              opacity: [0.1, 0.5, 0.1],
            }}
            transition={{
              duration: node.duration,
              delay: node.delay,
              repeat: Infinity,
              ease: "linear",
            }}
          />
        ))}
      </div>

      {/* Tech Debris Loop */}
      <AnimatePresence>
        {debrisList.map((debris) => (
          <motion.div
            key={debris.id}
            className="absolute font-mono text-sm leading-none whitespace-nowrap opacity-70"
            style={{
              color: debris.color,
              textShadow: `0 0 5px ${debris.color}`,
              zIndex: 1
            }}
            initial={{
              left: `${debris.startX}%`,
              top: `${debris.startY}%`,
              scale: debris.scale,
              opacity: 0
            }}
            animate={{
              left: '50%',
              top: '50%',
              scale: 0,
              opacity: [0, 1, 0.8, 0]
            }}
            transition={{
              duration: debris.duration,
              delay: debris.delay,
              ease: "easeInOut",
            }}
          >
            {debris.item}
          </motion.div>
        ))}
      </AnimatePresence>

      {/* Central Singularity Glow */}
      <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[30vh] h-[30vh] rounded-full bg-[#FFA600] opacity-5 blur-[100px] pointer-events-none mix-blend-screen" />
    </div>
  );
};
</file>

