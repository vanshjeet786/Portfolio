import { Sheet, SheetContent, SheetHeader, SheetTitle } from '@/components/ui/sheet';
import { Badge } from '@/components/ui/badge';
import { Progress } from '@/components/ui/progress';
import { ALL_ROLES } from '@/data/roles';
import type { RoleBlueprint } from '@/lib/scoring';
import { CheckCircle2, XCircle, AlertTriangle } from 'lucide-react';

const DOMAIN_LABELS: Record<string, string> = {
  decision_making: 'Decision Making',
  behavioral_style: 'Behavioral Style',
  communication: 'Communication',
  emotional_intelligence: 'Emotional Intelligence',
  professional_readiness: 'Professional Readiness',
  learning_agility: 'Learning Agility',
};

interface RoleDeepDiveProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  roleName: string;
  traitScores: Record<string, number>;
  domainScores: Record<string, number>;
  roleScore: number;
}

export function RoleDeepDive({ open, onOpenChange, roleName, traitScores, domainScores, roleScore }: RoleDeepDiveProps) {
  const blueprint = ALL_ROLES.find(r => r.role_name === roleName);
  if (!blueprint) return null;

  const activeDomains = Object.entries(blueprint.domain_weights)
    .filter(([, w]) => w > 0)
    .sort(([, a], [, b]) => b - a);

  const criticalTraits = Object.entries(blueprint.critical_traits).map(([trait, threshold]) => ({
    trait,
    threshold,
    userScore: traitScores[trait] ?? 0,
    gap: Math.max(0, threshold - (traitScores[trait] ?? 0)),
  }));

  const riskResults = blueprint.risk_rules.map(rule => ({
    ...rule,
    triggered: (traitScores[rule.trait] ?? 0) < rule.threshold,
    userScore: traitScores[rule.trait] ?? 0,
  }));

  const gaps = criticalTraits.filter(t => t.gap > 0).sort((a, b) => b.gap - a.gap);

  return (
    <Sheet open={open} onOpenChange={onOpenChange}>
      <SheetContent className="w-full sm:max-w-lg overflow-y-auto">
        <SheetHeader>
          <SheetTitle className="flex items-center gap-3">
            {roleName}
            <Badge variant={roleScore >= 0.7 ? 'default' : roleScore >= 0.5 ? 'secondary' : 'destructive'}>
              {Math.round(roleScore * 100)}% fit
            </Badge>
          </SheetTitle>
        </SheetHeader>

        <div className="space-y-6 mt-6">
          {/* Domain Weights */}
          <div>
            <h3 className="text-sm font-semibold mb-3 text-muted-foreground uppercase tracking-wider">Domain Importance</h3>
            <div className="space-y-3">
              {activeDomains.map(([domain, weight]) => {
                const userScore = domainScores[domain] ?? 0;
                return (
                  <div key={domain} className="space-y-1.5">
                    <div className="flex justify-between text-sm">
                      <span className="font-medium">{DOMAIN_LABELS[domain] || domain}</span>
                      <span className="text-muted-foreground">Weight: {Math.round(weight * 100)}% · You: {Math.round(userScore * 100)}%</span>
                    </div>
                    <div className="relative h-2 rounded-full bg-muted">
                      <div className="absolute h-full rounded-full bg-primary/30" style={{ width: `${weight * 100}%` }} />
                      <div className="absolute h-full rounded-full bg-primary" style={{ width: `${Math.min(userScore, weight) * 100}%` }} />
                    </div>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Critical Traits */}
          <div>
            <h3 className="text-sm font-semibold mb-3 text-muted-foreground uppercase tracking-wider">Critical Traits</h3>
            <div className="space-y-3">
              {criticalTraits.map(({ trait, threshold, userScore, gap }) => (
                <div key={trait} className="rounded-lg border p-3 space-y-2">
                  <div className="flex justify-between items-center">
                    <span className="text-sm font-medium capitalize">{trait.replace(/_/g, ' ')}</span>
                    {gap > 0 ? (
                      <Badge variant="destructive" className="text-xs">Gap: {Math.round(gap * 100)}%</Badge>
                    ) : (
                      <Badge variant="default" className="text-xs">Met</Badge>
                    )}
                  </div>
                  <div className="flex gap-4 text-xs text-muted-foreground">
                    <span>Required: {Math.round(threshold * 100)}%</span>
                    <span>Your score: {Math.round(userScore * 100)}%</span>
                  </div>
                  <div className="relative h-2 rounded-full bg-muted">
                    <div
                      className="absolute h-full rounded-full"
                      style={{
                        width: `${userScore * 100}%`,
                        backgroundColor: gap > 0 ? 'hsl(var(--destructive))' : 'hsl(var(--primary))',
                      }}
                    />
                    <div
                      className="absolute h-full w-0.5 bg-foreground/50"
                      style={{ left: `${threshold * 100}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Risk Rules */}
          <div>
            <h3 className="text-sm font-semibold mb-3 text-muted-foreground uppercase tracking-wider">Risk Rules</h3>
            <div className="space-y-2">
              {riskResults.map((rule, i) => (
                <div key={i} className={`flex items-start gap-3 p-3 rounded-lg ${rule.triggered ? 'bg-destructive/10' : 'bg-muted/50'}`}>
                  {rule.triggered ? (
                    <XCircle className="h-4 w-4 text-destructive mt-0.5 shrink-0" />
                  ) : (
                    <CheckCircle2 className="h-4 w-4 text-primary mt-0.5 shrink-0" />
                  )}
                  <div className="text-sm">
                    <p className={rule.triggered ? 'text-destructive font-medium' : 'text-foreground'}>{rule.description}</p>
                    <p className="text-xs text-muted-foreground mt-1">
                      {rule.trait.replace(/_/g, ' ')}: {Math.round(rule.userScore * 100)}% (threshold: {Math.round(rule.threshold * 100)}%)
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Fit Gap Summary */}
          {gaps.length > 0 && (
            <div>
              <h3 className="text-sm font-semibold mb-3 text-muted-foreground uppercase tracking-wider">Improvement Areas</h3>
              <div className="rounded-lg border border-warning/30 bg-warning/5 p-4 space-y-2">
                <div className="flex items-center gap-2 mb-2">
                  <AlertTriangle className="h-4 w-4 text-yellow-600" />
                  <span className="text-sm font-medium">Focus on these traits to improve your fit:</span>
                </div>
                {gaps.map(g => (
                  <div key={g.trait} className="flex justify-between text-sm pl-6">
                    <span className="capitalize">{g.trait.replace(/_/g, ' ')}</span>
                    <span className="text-muted-foreground">+{Math.round(g.gap * 100)}% needed</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </SheetContent>
    </Sheet>
  );
}
</file>

