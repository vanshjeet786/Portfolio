import { useState, useEffect } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { AppLayout } from '@/components/AppLayout';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { Progress } from '@/components/ui/progress';
import {
  Table, TableBody, TableCell, TableHead, TableHeader, TableRow,
} from '@/components/ui/table';
import { fetchCandidateResultsBySession, fetchCandidateAssessments, fetchCandidates } from '@/lib/supabase-stubs';
import type { MockAssessmentResult, MockCandidate } from '@/lib/supabase-stubs';
import { ArrowLeft } from 'lucide-react';
import { TerminalLoader } from '@/components/TerminalLoader';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import {
  RadarChart, Radar, PolarGrid, PolarAngleAxis, PolarRadiusAxis, ResponsiveContainer,
} from 'recharts';

const DOMAIN_LABELS: Record<string, string> = {
  decision_making: 'Decision Making',
  behavioral_style: 'Behavioral Style',
  communication: 'Communication',
  emotional_intelligence: 'Emotional Intelligence',
  professional_readiness: 'Professional Readiness',
  learning_agility: 'Learning Agility',
};

const CandidateDetail = () => {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();
  const [candidate, setCandidate] = useState<MockCandidate | null>(null);
  const [result, setResult] = useState<MockAssessmentResult | null>(null);
  const [assessments, setAssessments] = useState<Array<{ session_id: string; completed_at: string; status: string }>>([]);
  const [selectedSession, setSelectedSession] = useState<string>('');

  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (!id) return;
    fetchCandidates().then(cs => setCandidate(cs.find(c => c.user_id === id) || null));
    fetchCandidateAssessments(id)
      .then((rows) => {
        setAssessments(rows);
        if (rows[0]) setSelectedSession(rows[0].session_id);
      })
      .catch(() => setError('No results found for this candidate.'));
  }, [id]);

  useEffect(() => {
    if (!selectedSession) return;
    fetchCandidateResultsBySession(selectedSession)
      .then(setResult)
      .catch(() => setError('No results found for this assessment.'));
  }, [selectedSession]);

  if (error) {
    return (
      <AppLayout>
        <div className="flex flex-col items-center justify-center py-20 gap-4">
          <p className="text-muted-foreground">{error}</p>
          <Button variant="outline" onClick={() => navigate('/admin/candidates')}>
            <ArrowLeft className="h-4 w-4 mr-2" /> Back to Candidates
          </Button>
        </div>
      </AppLayout>
    );
  }

  if (!candidate || !result) {
    return (
      <AppLayout>
        <div className="flex items-center justify-center py-20">
          <TerminalLoader className="text-lg" />
        </div>
      </AppLayout>
    );
  }

  const radarData = Object.entries(result.domain_scores).map(([key, val]) => ({
    domain: DOMAIN_LABELS[key] || key,
    score: Math.round(val * 100),
  }));

  const sortedRoles = Object.entries(result.role_scores).sort(([, a], [, b]) => b - a).slice(0, 5);
  const sortedTraits = Object.entries(result.trait_scores).sort(([, a], [, b]) => b - a);

  return (
    <AppLayout>
      <div className="max-w-4xl mx-auto space-y-6">
        <div className="flex items-center gap-3">
          <Button variant="ghost" size="icon" onClick={() => navigate('/admin/candidates')}>
            <ArrowLeft className="h-4 w-4" />
          </Button>
          <div>
            <h1 className="text-2xl font-semibold">{candidate.name}</h1>
            <p className="text-sm text-muted-foreground">{candidate.email} · {candidate.date_taken}</p>
          </div>
          <Badge variant={candidate.status === 'completed' ? 'default' : 'secondary'} className="ml-auto">
            {candidate.status === 'completed' ? 'Completed' : 'In Progress'}
          </Badge>
        </div>

        {/* Domain Radar */}
        <div className="rounded-none terminal-border border border-border p-6">
          <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
            <h2 className="text-lg font-medium">Domain Scores</h2>
            <Select value={selectedSession} onValueChange={setSelectedSession}>
              <SelectTrigger className="w-full sm:w-[280px]">
                <SelectValue placeholder="Select assessment" />
              </SelectTrigger>
              <SelectContent>
                {assessments.map((a, idx) => (
                  <SelectItem key={a.session_id} value={a.session_id}>
                    Assessment #{assessments.length - idx} · {new Date(a.completed_at).toLocaleString()}
                  </SelectItem>
                ))}
              </SelectContent>
            </Select>
          </div>
          <ResponsiveContainer width="100%" height={320}>
            <RadarChart data={radarData}>
              <PolarGrid stroke="hsl(var(--border))" />
              <PolarAngleAxis dataKey="domain" tick={{ fontSize: 11 }} />
              <PolarRadiusAxis domain={[0, 100]} tick={{ fontSize: 10 }} />
              <Radar dataKey="score" stroke="hsl(var(--primary))" fill="hsl(var(--primary))" fillOpacity={0.2} />
            </RadarChart>
          </ResponsiveContainer>
        </div>

        {/* Role Fit */}
        <div className="rounded-none terminal-border border border-border p-6">
          <h2 className="text-lg font-medium mb-4">Top Role Matches</h2>
          <div className="space-y-4">
            {sortedRoles.map(([role, score]) => (
              <div key={role} className="space-y-1.5">
                <div className="flex justify-between text-sm">
                  <span className="font-medium">{role}</span>
                  <span className="text-muted-foreground">{Math.round(score * 100)}%</span>
                </div>
                <Progress value={score * 100} className="h-2" />
              </div>
            ))}
          </div>
        </div>

        {/* All Trait Scores */}
        <div className="rounded-none terminal-border border border-border p-6">
          <h2 className="text-lg font-medium mb-4">Trait Scores</h2>
          <div className="max-h-80 overflow-auto">
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Trait</TableHead>
                  <TableHead className="text-right">Score</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {sortedTraits.map(([trait, score]) => (
                  <TableRow key={trait}>
                    <TableCell className="capitalize">{trait.replace(/_/g, ' ')}</TableCell>
                    <TableCell className="text-right">{Math.round(score * 100)}%</TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </div>
        </div>

        {/* Time per Question */}
        <div className="rounded-none terminal-border border border-border p-6">
          <h2 className="text-lg font-medium mb-4">Time per Question</h2>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {Object.entries(result.time_per_question).map(([qId, time]) => (
              <div key={qId} className="rounded-none terminal-border border border-border p-3 text-center">
                <p className="text-xs text-muted-foreground">{qId}</p>
                <p className="text-lg font-medium">{time}s</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </AppLayout>
  );
};

export default CandidateDetail;
