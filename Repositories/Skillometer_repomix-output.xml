import { describe, it, expect } from 'vitest';
import { getRandomizedQuestions } from '@/lib/questions';

describe('getRandomizedQuestions', () => {
  it('should return exactly 50 questions', () => {
    const questions = getRandomizedQuestions();
    expect(questions).toHaveLength(50);
  });

  it('should group scenario questions together', () => {
    const questions = getRandomizedQuestions();
    for (let i = 0; i < questions.length - 1; i++) {
      const q = questions[i];
      const match = q.question_id.match(/^(.*_s\d+)_(q\d+)$/);
      if (match) {
        const scenarioId = match[1];
        const nextQ = questions[i + 1];
        const nextMatch = nextQ.question_id.match(/^(.*_s\d+)_(q\d+)$/);

        // If this isn't the last question of the scenario, the next question MUST be the same scenario
        if (match[2] === 'q1') {
            expect(nextMatch).not.toBeNull();
            if (nextMatch) {
              expect(nextMatch[1]).toBe(scenarioId);
            }
        }
      }
    }
  });
});
</file>

