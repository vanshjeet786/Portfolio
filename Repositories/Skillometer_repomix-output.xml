        </div>
      </section>

      {/* Footer */}
      <footer className="border-t border-border py-6 text-center text-sm text-muted-foreground">
        © {new Date().getFullYear()} Skillometer · Powered by SKITRE AI. Built for better hiring.
      </footer>
    </div>
  );
};

export default Index;
</file>

<file path="src/pages/InviteManagement.tsx">
import { useState, useEffect } from 'react';
import { useParams } from 'react-router-dom';
import { useAuth } from '@/contexts/AuthContext';
import { AppLayout } from '@/components/AppLayout';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Badge } from '@/components/ui/badge';
import { Mail, Check, X } from 'lucide-react';
import { createInvitation, fetchInvitations, acceptInvitation, declineInvitation, type Invitation } from '@/lib/invite-service';
import { formatOrgRole, type OrgRole } from '@/lib/authorization';
import { toast } from 'sonner';
import { format } from 'date-fns';

export default function InviteManagement() {
  const { orgId } = useParams<{ orgId: string }>();
  const { user } = useAuth();
  const [invitations, setInvitations] = useState<Invitation[]>([]);
  const [email, setEmail] = useState('');
  const [role, setRole] = useState<OrgRole>('member');
  const [sending, setSending] = useState(false);

  useEffect(() => {
    if (orgId) fetchInvitations(orgId).then(setInvitations);
  }, [orgId]);

  const handleSend = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!orgId || !email) return;
    setSending(true);
    const inv = await createInvitation(orgId, email, role);
    setSending(false);
    if (inv) {
      toast.success(`Invitation sent to ${email}`);
      setEmail('');
      fetchInvitations(orgId).then(setInvitations);
    } else {
      toast.error('Failed to send invitation');
    }
  };

  const handleAccept = async (id: string) => {
    const ok = await acceptInvitation(id);
    if (ok) {
      toast.success('Invitation accepted');
      if (orgId) fetchInvitations(orgId).then(setInvitations);
    }
  };

  const handleDecline = async (id: string) => {
    const ok = await declineInvitation(id);
    if (ok) {
      toast.success('Invitation declined');
      if (orgId) fetchInvitations(orgId).then(setInvitations);
    }
  };

  const statusColor: Record<string, string> = {
    pending: 'bg-yellow-100 text-yellow-800',
    accepted: 'bg-green-100 text-green-800',
    declined: 'bg-red-100 text-red-800',
    expired: 'bg-muted text-muted-foreground',
  };

  return (
    <AppLayout>
      <div className="max-w-4xl mx-auto space-y-6">
        <h1 className="text-3xl font-bold tracking-tight flex items-center gap-2">
          <Mail className="h-8 w-8" /> Invitations
        </h1>

        <Card>
          <CardHeader><CardTitle>Send Invitation</CardTitle></CardHeader>
          <CardContent>
            <form onSubmit={handleSend} className="flex gap-4 items-end">
              <div className="flex-1 space-y-2">
                <Label>Email</Label>
                <Input type="email" value={email} onChange={e => setEmail(e.target.value)} placeholder="user@example.com" required />
              </div>
              <div className="w-40 space-y-2">
                <Label>Role</Label>
                <Select value={role} onValueChange={v => setRole(v as OrgRole)}>
                  <SelectTrigger><SelectValue /></SelectTrigger>
                  <SelectContent>
                    <SelectItem value="member">Member</SelectItem>
                    <SelectItem value="team_lead">Team Lead</SelectItem>
                    <SelectItem value="hr_admin">HR Admin</SelectItem>
                    <SelectItem value="super_admin">Super Admin</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              <Button type="submit" disabled={sending}>{sending ? 'Sending...' : 'Send'}</Button>
            </form>
          </CardContent>
        </Card>

        <Card>
          <CardHeader><CardTitle>All Invitations</CardTitle></CardHeader>
          <CardContent>
            {invitations.length === 0 ? (
              <p className="text-muted-foreground text-center py-4">No invitations yet</p>
            ) : (
              <div className="space-y-2">
                {invitations.map(inv => (
                  <div key={inv.id} className="flex items-center justify-between p-3 border rounded-lg">
                    <div>
                      <p className="font-medium">{inv.email}</p>
                      <p className="text-xs text-muted-foreground">
                        Role: {formatOrgRole(inv.role)} • {format(new Date(inv.created_at), 'PPp')}
                      </p>
                    </div>
                    <div className="flex items-center gap-2">
                      <Badge className={statusColor[inv.status]}>{inv.status}</Badge>
                      {inv.status === 'pending' && inv.email === user?.email && (
                        <>
                          <Button size="sm" variant="default" onClick={() => handleAccept(inv.id)}><Check className="h-4 w-4 mr-1" /> Accept</Button>
                          <Button size="sm" variant="destructive" onClick={() => handleDecline(inv.id)}><X className="h-4 w-4 mr-1" /> Decline</Button>
                        </>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </CardContent>
        </Card>
      </div>
    </AppLayout>
  );
}
</file>

<file path="src/pages/Login.tsx">
import { useState, useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '@/contexts/AuthContext';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { toast } from 'sonner';

const Login = () => {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const { login, isLoading } = useAuth();
  const navigate = useNavigate();

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      await login(email, password);
    } catch (err: unknown) {
      toast.error('Login failed', {
        description: err instanceof Error ? err.message : 'Invalid credentials'
      });
    }
  };

  // Redirect after login based on role
  const { user } = useAuth();
  useEffect(() => {
    if (user) {
      if (user.role === 'hr_admin' || user.role === 'super_admin') {
        navigate('/admin/candidates', { replace: true });
      } else {
        navigate('/home', { replace: true });
      }
    }
  }, [user, navigate]);

  return (
    <div className="flex min-h-screen items-center justify-center bg-background">
      <div className="w-full max-w-sm space-y-6 px-4">
        <div className="text-center space-y-1">
          <h1 className="text-2xl font-semibold tracking-tight">Welcome back</h1>
          <p className="text-sm text-muted-foreground">Sign in to your account</p>
        </div>

        <form onSubmit={handleSubmit} className="space-y-4">
          <div className="space-y-2">
            <Label htmlFor="email">Email</Label>
            <Input id="email" type="email" placeholder="you@example.com" value={email} onChange={e => setEmail(e.target.value)} required />
          </div>
          <div className="space-y-2">
            <Label htmlFor="password">Password</Label>
            <Input id="password" type="password" placeholder="••••••••" value={password} onChange={e => setPassword(e.target.value)} required />
          </div>
          <Button type="submit" className="w-full" disabled={isLoading}>
            {isLoading ? 'Signing in…' : 'Sign in'}
          </Button>
        </form>

        <div className="text-center text-sm text-muted-foreground">
          Don't have an account?{' '}
          <Link to="/signup" className="text-primary hover:underline">Sign up</Link>
        </div>


      </div>
    </div>
  );
};

export default Login;
</file>

<file path="src/pages/Messages.tsx">
import { useState, useEffect, useRef, useMemo } from 'react';
import { useParams } from 'react-router-dom';
import { useAuth } from '@/contexts/AuthContext';
import { AppLayout } from '@/components/AppLayout';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Badge } from '@/components/ui/badge';
import { MessageSquare, Send } from 'lucide-react';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { fetchConversationList, fetchConversation, sendMessage, markMessagesRead, fetchAnnouncements, type DirectMessage, type Announcement } from '@/lib/messaging-service';
import { fetchNotifications, markNotificationRead, type Notification } from '@/lib/notification-service';
import { fetchOrgMembers, type OrgMember } from '@/lib/org-service';
import { format } from 'date-fns';
import { Bell, Megaphone } from 'lucide-react';

export default function Messages() {
  const { orgId } = useParams<{ orgId: string }>();
  const { user } = useAuth();
  const [conversations, setConversations] = useState<{ userId: string; lastMessage: string; lastAt: string; unread: number }[]>([]);
  const [orgMembers, setOrgMembers] = useState<OrgMember[]>([]);
  const [selectedUser, setSelectedUser] = useState<string | null>(null);
  const [messages, setMessages] = useState<DirectMessage[]>([]);
  const [announcements, setAnnouncements] = useState<Announcement[]>([]);
  const [notifications, setNotifications] = useState<Notification[]>([]);
  const [draft, setDraft] = useState('');
  const [sending, setSending] = useState(false);
  const bottomRef = useRef<HTMLDivElement>(null);

  const conversationMap = useMemo(() => {
    return new Map(conversations.map(c => [c.userId, c]));
  }, [conversations]);

  const memberMap = useMemo(() => {
    return new Map(orgMembers.map(m => [m.user_id, m]));
  }, [orgMembers]);

  useEffect(() => {
    if (orgId) {
      fetchConversationList(orgId).then(setConversations);
      fetchOrgMembers(orgId).then(setOrgMembers);
      fetchAnnouncements(orgId).then(setAnnouncements);
    }
    fetchNotifications(30).then(setNotifications);
  }, [orgId]);

  useEffect(() => {
    if (orgId && selectedUser) {
      fetchConversation(orgId, selectedUser).then(setMessages);
      markMessagesRead(orgId, selectedUser);
    }
  }, [orgId, selectedUser]);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  // Poll for new messages every 5 seconds
  useEffect(() => {
    if (!orgId || !selectedUser) return;
    const interval = setInterval(() => {
      fetchConversation(orgId, selectedUser).then(setMessages);
    }, 5000);
    return () => clearInterval(interval);
  }, [orgId, selectedUser]);

  const handleSend = async () => {
    if (!orgId || !selectedUser || !draft.trim()) return;
    setSending(true);
    const ok = await sendMessage(orgId, selectedUser, draft.trim());
    setSending(false);
    if (ok) {
      setDraft('');
      fetchConversation(orgId, selectedUser).then(setMessages);
    }
  };

  const getMemberName = (uid: string) => {
    const m = memberMap.get(uid);
    return m?.profile?.full_name || m?.profile?.email || uid.slice(0, 8);
  };

  return (
    <AppLayout>
      <div className="max-w-6xl mx-auto h-[calc(100vh-100px)] flex flex-col font-mono text-white">
        <h1 className="text-3xl font-bold tracking-tight flex items-center gap-2 mb-6 shrink-0 text-[#FFA600] uppercase border-b border-[#333] pb-4">
          <MessageSquare className="h-8 w-8" /> Hub
        </h1>

        <Tabs defaultValue="dms" className="flex-1 flex flex-col min-h-0">
          <TabsList className="shrink-0 max-w-fit mb-4">
            <TabsTrigger value="dms"><MessageSquare className="w-4 h-4 mr-2" /> Direct Messages</TabsTrigger>
            <TabsTrigger value="announcements"><Megaphone className="w-4 h-4 mr-2" /> Announcements</TabsTrigger>
            <TabsTrigger value="system"><Bell className="w-4 h-4 mr-2" /> System Alerts</TabsTrigger>
          </TabsList>

          <TabsContent value="dms" className="flex-1 mt-0">
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 h-full">
          <Card className="md:col-span-1 overflow-hidden flex flex-col bg-black border border-[#333] rounded-none bg-black border border-[#333] rounded-none">
            <CardHeader className="pb-2 shrink-0"><CardTitle className="text-lg">Conversations</CardTitle></CardHeader>
            <CardContent className="p-0">
              <ScrollArea className="h-[calc(100vh-300px)]">
                {/* Show all org members as potential conversation partners */}
                {orgMembers.filter(m => m.user_id !== user?.id).map(m => {
                  const conv = conversationMap.get(m.user_id);
                  return (
                    <div key={m.user_id}
                      className={`flex items-center justify-between p-3 border-b cursor-pointer hover:bg-muted/50 ${selectedUser === m.user_id ? 'bg-muted' : ''}`}
                      onClick={() => setSelectedUser(m.user_id)}>
                      <div className="min-w-0">
                        <p className="font-medium text-sm truncate">{m.profile?.full_name || m.profile?.email}</p>
                        {conv && <p className="text-xs text-muted-foreground truncate">{conv.lastMessage}</p>}
                      </div>
                      {conv && conv.unread > 0 && (
                        <Badge variant="destructive" className="text-xs ml-2">{conv.unread}</Badge>
                      )}
                    </div>
                  );
                })}
              </ScrollArea>
            </CardContent>
          </Card>

          <Card className="md:col-span-2 flex flex-col overflow-hidden bg-black border border-[#333] rounded-none bg-black border border-[#333] rounded-none">
            {selectedUser ? (
              <>
                <CardHeader className="pb-2 border-b">
                  <CardTitle className="text-lg">{getMemberName(selectedUser)}</CardTitle>
                </CardHeader>
                <ScrollArea className="flex-1 p-4">
                  <div className="space-y-3">
                    {messages.map(msg => (
                      <div key={msg.id} className={`flex ${msg.sender_id === user?.id ? 'justify-end' : 'justify-start'}`}>
                        <div className={`max-w-[70%] p-3 rounded-lg text-sm ${msg.sender_id === user?.id ? 'bg-primary text-primary-foreground' : 'bg-muted'}`}>
                          <p>{msg.content}</p>
                          <p className={`text-[10px] mt-1 ${msg.sender_id === user?.id ? 'text-primary-foreground/70' : 'text-muted-foreground'}`}>
                            {format(new Date(msg.created_at), 'p')}
                          </p>
                        </div>
                      </div>
                    ))}
                    <div ref={bottomRef} />
                  </div>
                </ScrollArea>
                <div className="p-4 border-t flex gap-2">
                  <Input value={draft} onChange={e => setDraft(e.target.value)} placeholder="Type a message..."
                    onKeyDown={e => e.key === 'Enter' && !e.shiftKey && handleSend()} />
                  <Button onClick={handleSend} disabled={sending || !draft.trim()}>
                    <Send className="h-4 w-4" />
                  </Button>
                </div>
              </>
            ) : (
              <div className="flex-1 flex items-center justify-center text-muted-foreground">
                Select a conversation to start messaging
              </div>
            )}
          </Card>
        </div>
          </TabsContent>

          <TabsContent value="announcements" className="flex-1 mt-0">
            <Card className="h-full flex flex-col bg-black border border-[#333] rounded-none bg-black border border-[#333] rounded-none">
              <CardHeader className="shrink-0"><CardTitle>Organization Announcements</CardTitle></CardHeader>
              <CardContent className="flex-1 overflow-auto">
                {announcements.length === 0 ? (
                  <p className="text-muted-foreground text-center py-8">No announcements found.</p>
                ) : (
                  <div className="space-y-4">
                    {announcements.map(a => (
                      <div key={a.id} className="p-4 rounded-lg border bg-muted/20">
                        <div className="flex justify-between items-start mb-2">
                          <h3 className="font-bold">{a.title}</h3>
                          <span className="text-xs text-muted-foreground">{format(new Date(a.created_at), 'MMM d, h:mm a')}</span>
                        </div>
                        <p className="text-sm whitespace-pre-wrap mb-3">{a.body}</p>
                        <div className="text-xs text-muted-foreground">Posted by {a.author_id.slice(0,8)}</div>
                      </div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>

          <TabsContent value="system" className="flex-1 mt-0">
            <Card className="h-full flex flex-col bg-black border border-[#333] rounded-none bg-black border border-[#333] rounded-none">
              <CardHeader className="shrink-0"><CardTitle>System Notifications</CardTitle></CardHeader>
              <CardContent className="flex-1 overflow-auto">
                {notifications.length === 0 ? (
                  <p className="text-muted-foreground text-center py-8">No notifications.</p>
                ) : (
                  <div className="space-y-2">
                    {notifications.map(n => (
                      <div key={n.id} className={`p-4 rounded-lg border flex gap-3 ${n.is_read ? 'opacity-70' : 'bg-muted/20'}`}>
                        <Bell className={`h-5 w-5 mt-0.5 ${!n.is_read ? 'text-orange-500' : 'text-muted-foreground'}`} />
                        <div className="flex-1">
                          <div className="flex justify-between items-start">
                            <h4 className="font-medium text-sm">{n.title}</h4>
                            <span className="text-xs text-muted-foreground">{format(new Date(n.created_at), 'MMM d, h:mm a')}</span>
                          </div>
                          {n.body && <p className="text-sm text-muted-foreground mt-1">{n.body}</p>}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>
      </div>
    </AppLayout>
  );
}
</file>

