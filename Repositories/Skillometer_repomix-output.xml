<file path="fix_rls_policies.sql">
-- Drop existing policies on org_memberships
DROP POLICY IF EXISTS "Users can view memberships of their orgs" ON public.org_memberships;
DROP POLICY IF EXISTS "Users can view memberships of their orgs v2" ON public.org_memberships;
DROP POLICY IF EXISTS "Org admins can manage memberships" ON public.org_memberships;
DROP POLICY IF EXISTS "Org admins can manage memberships v2" ON public.org_memberships;
DROP POLICY IF EXISTS "Users can view memberships in their orgs" ON public.org_memberships;
DROP POLICY IF EXISTS "Admins can manage memberships" ON public.org_memberships;
DROP POLICY IF EXISTS "Users can insert memberships via invite or admin" ON public.org_memberships;
DROP POLICY IF EXISTS "Admins can delete memberships" ON public.org_memberships;

-- Create a helper function to avoid infinite recursion
CREATE OR REPLACE FUNCTION public.get_user_org_ids()
RETURNS SETOF uuid
LANGUAGE sql
SECURITY DEFINER
SET search_path = public
STABLE
AS $$
  SELECT org_id FROM org_memberships WHERE user_id = auth.uid();
$$;

-- Create comprehensive SELECT policy
-- Users can see memberships if it's their own membership OR if they belong to the same organization
CREATE POLICY "Users can view memberships in their orgs"
ON public.org_memberships
FOR SELECT
USING (
  auth.uid() = user_id OR
  org_memberships.org_id IN (SELECT get_user_org_ids())
);

-- Create comprehensive INSERT policy
-- Users can be added to an org if:
-- 1. An admin is doing it (has super_admin or dev_admin role in that org) OR
-- 2. The user is inserting themselves AND they have a matching invitation for that org
CREATE POLICY "Users can insert memberships via invite or admin"
ON public.org_memberships
FOR INSERT
WITH CHECK (
  (
    -- Check if the inserting user is an admin in this org
    EXISTS (
      SELECT 1 FROM org_memberships om
      WHERE om.user_id = auth.uid()
      AND om.org_id = org_memberships.org_id
      AND om.role IN ('super_admin', 'dev_admin', 'hr_admin')
    )
  )
  OR
  (
    -- Check if the user is inserting themselves with a valid invitation
    auth.uid() = user_id AND
    EXISTS (
      SELECT 1 FROM invitations i
      WHERE i.org_id = org_memberships.org_id
      AND i.email = (SELECT email FROM auth.users WHERE id = auth.uid())
      AND i.status IN ('pending', 'accepted')
    )
  )
);

-- Admins can update
CREATE POLICY "Admins can manage memberships"
ON public.org_memberships
FOR UPDATE
USING (
  EXISTS (
    SELECT 1 FROM org_memberships om
    WHERE om.user_id = auth.uid()
    AND om.org_id = org_memberships.org_id
    AND om.role IN ('super_admin', 'dev_admin', 'hr_admin')
  )
);

-- Admins can delete
CREATE POLICY "Admins can delete memberships"
ON public.org_memberships
FOR DELETE
USING (
  EXISTS (
    SELECT 1 FROM org_memberships om
    WHERE om.user_id = auth.uid()
    AND om.org_id = org_memberships.org_id
    AND om.role IN ('super_admin', 'dev_admin', 'hr_admin')
  )
);
</file>

