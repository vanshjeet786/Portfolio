import { ALL_QUESTIONS } from '@/data/questions';
import type { Question } from '@/lib/scoring';

// Shuffle an array using Fisher-Yates
export function shuffle<T>(array: T[]): T[] {
  const newArr = [...array];
  for (let i = newArr.length - 1; i > 0; i--) {
    // Use cryptographically secure random numbers
    const randomArray = new Uint32Array(1);
    crypto.getRandomValues(randomArray);
    const j = Math.floor((randomArray[0] / (0xffffffff + 1)) * (i + 1));
    [newArr[i], newArr[j]] = [newArr[j], newArr[i]];
  }
  return newArr;
}

export function getRandomizedQuestions(): Question[] {
  // Group questions by scenario ID if they are part of a scenario, otherwise group by full ID
  // Scenario IDs typically look like dm_s1_q1, so the prefix is dm_s1
  const groupedBlocks = new Map<string, Question[]>();

  ALL_QUESTIONS.forEach(q => {
    let blockId = q.question_id;
    // Check if it matches a scenario pattern like dm_s1_q1
    const match = q.question_id.match(/^(.*_s\d+)_(q\d+)$/);
    if (match) {
      blockId = match[1]; // e.g. dm_s1
    }

    if (!groupedBlocks.has(blockId)) {
      groupedBlocks.set(blockId, []);
    }
    groupedBlocks.get(blockId)!.push(q);
  });

  const blocksArray = Array.from(groupedBlocks.values());
  const shuffledBlocks = shuffle(blocksArray);

  const flattenedQuestions: Question[] = [];
  shuffledBlocks.forEach(block => {
    // Keep scenario questions in order (q1, q2, etc.)
    flattenedQuestions.push(...block);
  });

  // Return the first 50 questions as the "main" assessment
  return flattenedQuestions.slice(0, 50);
}

// Phase 2: Adaptive Verification
export function getVerificationQuestions(topTraits: string[], usedQuestionIds: string[] = []): Question[] {
  // Find questions that target the top traits (lowered threshold for broader matching)
  const targeted = ALL_QUESTIONS.filter(q => {
    if (usedQuestionIds.includes(q.question_id)) return false;
    return q.options.some(opt =>
      opt.trait_signals.some(sig => topTraits.includes(sig.trait) && sig.weight >= 0.3)
    );
  });

  const selected = shuffle(targeted).slice(0, 5);

  // Fallback: fill remaining slots with unused random questions
  if (selected.length < 5) {
    const selectedIds = new Set(selected.map(q => q.question_id));
    const remaining = ALL_QUESTIONS.filter(
      q => !usedQuestionIds.includes(q.question_id) && !selectedIds.has(q.question_id)
    );
    selected.push(...shuffle(remaining).slice(0, 5 - selected.length));
  }

  return selected;
}
