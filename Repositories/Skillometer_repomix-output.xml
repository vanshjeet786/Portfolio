import { describe, it, expect, vi } from 'vitest';
import { shuffle } from '@/lib/questions';

describe('shuffle function', () => {
  it('should return an array with the same elements', () => {
    const input = [1, 2, 3, 4, 5];
    const result = shuffle(input);
    expect(result).toHaveLength(input.length);
    expect(new Set(result)).toEqual(new Set(input));
  });

  it('should use crypto.getRandomValues', () => {
    const spy = vi.spyOn(crypto, 'getRandomValues');
    const input = [1, 2, 3];
    shuffle(input);
    expect(spy).toHaveBeenCalled();
    spy.mockRestore();
  });

  it('should shuffle the array', () => {
    // With 10 elements, the probability of getting the same order is very low
    const input = Array.from({ length: 10 }, (_, i) => i);
    const result = shuffle(input);
    // Note: It IS possible for shuffle to return the same order, but extremely unlikely for 10 elements.
    expect(result).not.toEqual(input);
  });
});
