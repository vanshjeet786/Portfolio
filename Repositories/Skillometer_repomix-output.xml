import { supabase } from '@/integrations/supabase/client';
import type { OrgRole } from './authorization';

export interface Invitation {
  id: string;
  org_id: string;
  team_id: string | null;
  email: string;
  role: OrgRole;
  invited_by: string;
  status: 'pending' | 'accepted' | 'declined' | 'expired';
  token: string;
  expires_at: string;
  created_at: string;
}

export interface RoleChangeRequest {
  id: string;
  org_id: string;
  user_id: string;
  from_role: OrgRole;
  to_role: OrgRole;
  requested_by: string;
  reviewed_by: string | null;
  status: 'pending' | 'approved' | 'denied';
  reason: string | null;
  created_at: string;
}

export async function createInvitation(orgId: string, email: string, role: OrgRole, teamId?: string): Promise<Invitation | null> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return null;

  const { data, error } = await supabase
    .from('invitations')
    .insert({ org_id: orgId, email, role, team_id: teamId || null, invited_by: user.id })
    .select()
    .single();

  if (error) { console.error('[createInvitation]', error); return null; }

  // Look up invitee by email to send notification
  const { data: inviteeProfile } = await supabase
    .from('profiles')
    .select('id')
    .eq('email', email)
    .maybeSingle();

  if (inviteeProfile) {
    // Create notification for invitee if they exist
    await supabase.from('notifications').insert({
      user_id: inviteeProfile.id,
      type: 'invite',
      title: 'Organization Invitation',
      body: `You've been invited to join an organization as ${role}`,
      actor_id: user.id,
      metadata: { invitation_id: data.id, org_id: orgId, role },
      action_type: 'invitation',
      action_id: data.id,
    });
  }

  return data as Invitation;
}

export async function fetchInvitations(orgId: string): Promise<Invitation[]> {
  const { data, error } = await supabase
    .from('invitations')
    .select('*')
    .eq('org_id', orgId)
    .order('created_at', { ascending: false });
  if (error) { console.error('[fetchInvitations]', error); return []; }
  return data as Invitation[];
}

export async function acceptInvitation(invitationId: string): Promise<boolean> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return false;

  const { data: invite, error: fetchErr } = await supabase
    .from('invitations')
    .select('*')
    .eq('id', invitationId)
    .single();

  if (fetchErr || !invite) return false;

  // Update invitation status
  const { error: updateErr } = await supabase
    .from('invitations')
    .update({ status: 'accepted', accepted_by: user.id })
    .eq('id', invitationId);

  if (updateErr) return false;

  // Add user to org
  const { error: insertErr } = await supabase.from('org_memberships').insert({
    user_id: user.id,
    org_id: invite.org_id,
    role: invite.role,
  });

  if (insertErr) {
    console.error('[acceptInvitation] insert error:', insertErr);
    // Rollback invitation status
    await supabase
      .from('invitations')
      .update({ status: 'pending', accepted_by: null })
      .eq('id', invitationId);
    return false;
  }

  // Add to team if specified
  if (invite.team_id) {
    await supabase.from('team_memberships').insert({
      user_id: user.id,
      team_id: invite.team_id,
    });
  }

  return true;
}

export async function declineInvitation(invitationId: string): Promise<boolean> {
  const { error } = await supabase
    .from('invitations')
    .update({ status: 'declined' })
    .eq('id', invitationId);
  return !error;
}

export async function createRoleChangeRequest(orgId: string, userId: string, fromRole: OrgRole, toRole: OrgRole, reason?: string): Promise<boolean> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return false;

  const { error } = await supabase
    .from('role_change_requests')
    .insert({ org_id: orgId, user_id: userId, from_role: fromRole, to_role: toRole, requested_by: user.id, reason: reason || null });

  if (error) { console.error('[createRoleChangeRequest]', error); return false; }
  return true;
}

export async function fetchRoleChangeRequests(orgId: string): Promise<RoleChangeRequest[]> {
  const { data, error } = await supabase
    .from('role_change_requests')
    .select('*')
    .eq('org_id', orgId)
    .order('created_at', { ascending: false });
  if (error) return [];
  return data as RoleChangeRequest[];
}

export async function reviewRoleChangeRequest(requestId: string, status: 'approved' | 'denied'): Promise<boolean> {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) return false;

  const { data: req } = await supabase
    .from('role_change_requests')
    .select('*')
    .eq('id', requestId)
    .single();

  if (!req) return false;

  const { error } = await supabase
    .from('role_change_requests')
    .update({ status, reviewed_by: user.id })
    .eq('id', requestId);

  if (error) return false;

  if (status === 'approved') {
    await supabase
      .from('org_memberships')
      .update({ role: req.to_role })
      .eq('user_id', req.user_id)
      .eq('org_id', req.org_id);
  }

  return true;
}
