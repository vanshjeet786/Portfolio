-- Check if user is member of org
CREATE OR REPLACE FUNCTION public.is_org_member(_user_id UUID, _org_id UUID)
RETURNS BOOLEAN
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public
AS $$
  SELECT EXISTS (
    SELECT 1 FROM public.org_memberships
    WHERE user_id = _user_id AND org_id = _org_id
  );
$$;

-- Get user's role in org
CREATE OR REPLACE FUNCTION public.get_org_role(_user_id UUID, _org_id UUID)
RETURNS public.org_role
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public
AS $$
  SELECT role FROM public.org_memberships
  WHERE user_id = _user_id AND org_id = _org_id
  LIMIT 1;
$$;

-- Check if user has org admin role (super_admin, hr_admin, or dev_admin)
CREATE OR REPLACE FUNCTION public.is_org_admin(_user_id UUID, _org_id UUID)
RETURNS BOOLEAN
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public
AS $$
  SELECT EXISTS (
    SELECT 1 FROM public.org_memberships
    WHERE user_id = _user_id AND org_id = _org_id
    AND role IN ('dev_admin', 'super_admin', 'hr_admin')
  );
$$;

-- Check if user is dev_admin in any org
CREATE OR REPLACE FUNCTION public.is_dev_admin(_user_id UUID)
RETURNS BOOLEAN
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public
AS $$
  SELECT EXISTS (
    SELECT 1 FROM public.org_memberships
    WHERE user_id = _user_id AND role = 'dev_admin'
  );
$$;

-- Recursive CTE: get all team IDs in subtree under a given team
CREATE OR REPLACE FUNCTION public.get_team_subtree(_team_id UUID)
RETURNS SETOF UUID
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public
AS $$
  WITH RECURSIVE subtree AS (
    SELECT id FROM public.teams WHERE id = _team_id
    UNION ALL
    SELECT t.id FROM public.teams t
    JOIN subtree s ON t.parent_team_id = s.id
  )
  SELECT id FROM subtree;
$$;

-- Get all user IDs in a team's subtree
CREATE OR REPLACE FUNCTION public.get_subtree_user_ids(_team_id UUID)
RETURNS SETOF UUID
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public
AS $$
  SELECT DISTINCT tm.user_id
  FROM public.team_memberships tm
  WHERE tm.team_id IN (SELECT public.get_team_subtree(_team_id));
$$;

-- Check if user is TL of a team that has target_user in its subtree
CREATE OR REPLACE FUNCTION public.is_tl_of_user(_tl_user_id UUID, _target_user_id UUID, _org_id UUID)
RETURNS BOOLEAN
LANGUAGE sql STABLE SECURITY DEFINER SET search_path = public
AS $$
  SELECT EXISTS (
    SELECT 1
    FROM public.team_memberships tl_tm
    JOIN public.teams t ON t.id = tl_tm.team_id AND t.org_id = _org_id
    WHERE tl_tm.user_id = _tl_user_id
    AND tl_tm.role = 'lead'
    AND _target_user_id IN (SELECT public.get_subtree_user_ids(tl_tm.team_id))
  );
$$;

