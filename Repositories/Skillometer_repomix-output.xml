<file path="src/pages/Announcements.tsx">
import { useState, useEffect } from 'react';
import { useParams } from 'react-router-dom';
import { useAuth } from '@/contexts/AuthContext';
import { AppLayout } from '@/components/AppLayout';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { Megaphone, Plus } from 'lucide-react';
import { createAnnouncement, fetchAnnouncements, type Announcement } from '@/lib/messaging-service';
import { getUserOrgRole, canBroadcast, type OrgRole } from '@/lib/authorization';
import { toast } from 'sonner';
import { format } from 'date-fns';

export default function Announcements() {
  const { orgId } = useParams<{ orgId: string }>();
  const { user } = useAuth();
  const [announcements, setAnnouncements] = useState<Announcement[]>([]);
  const [myRole, setMyRole] = useState<OrgRole | null>(null);
  const [showCreate, setShowCreate] = useState(false);
  const [title, setTitle] = useState('');
  const [content, setContent] = useState('');

  useEffect(() => {
    if (orgId) {
      fetchAnnouncements(orgId).then(setAnnouncements);
      if (user) getUserOrgRole(user.id, orgId).then(setMyRole);
    }
  }, [orgId, user]);

  const handleCreate = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!orgId || !title || !content) return;
    const ok = await createAnnouncement(orgId, title, content);
    if (ok) {
      toast.success('Announcement published');
      setShowCreate(false); setTitle(''); setContent('');
      fetchAnnouncements(orgId).then(setAnnouncements);
    }
  };

  return (
    <AppLayout>
      <div className="max-w-4xl mx-auto space-y-6">
        <div className="flex items-center justify-between">
          <h1 className="text-3xl font-bold tracking-tight flex items-center gap-2">
            <Megaphone className="h-8 w-8" /> Announcements
          </h1>
          {canBroadcast(myRole) && (
            <Button onClick={() => setShowCreate(!showCreate)}><Plus className="h-4 w-4 mr-2" /> New Announcement</Button>
          )}
        </div>

        {showCreate && (
          <Card>
            <CardHeader><CardTitle>Create Announcement</CardTitle></CardHeader>
            <CardContent>
              <form onSubmit={handleCreate} className="space-y-4">
                <div className="space-y-2">
                  <Label>Title</Label>
                  <Input value={title} onChange={e => setTitle(e.target.value)} required />
                </div>
                <div className="space-y-2">
                  <Label>Content</Label>
                  <Textarea value={content} onChange={e => setContent(e.target.value)} rows={4} required />
                </div>
                <Button type="submit">Publish</Button>
              </form>
            </CardContent>
          </Card>
        )}

        {announcements.length === 0 ? (
          <Card>
            <CardContent className="py-12 text-center text-muted-foreground">
              No announcements yet.
            </CardContent>
          </Card>
        ) : (
          announcements.map(a => (
            <Card key={a.id}>
              <CardHeader>
                <CardTitle className="text-lg">{a.title}</CardTitle>
                <p className="text-sm text-muted-foreground">{format(new Date(a.created_at), 'PPp')}</p>
              </CardHeader>
              <CardContent>
                <p className="whitespace-pre-wrap">{a.content}</p>
              </CardContent>
            </Card>
          ))
        )}
      </div>
    </AppLayout>
  );
}
</file>

