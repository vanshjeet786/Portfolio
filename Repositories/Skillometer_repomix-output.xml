<file path="src/lib/scoring.ts">
export interface TraitSignal {
  trait: string;
  weight: number;
}

export interface AnswerOption {
  option_id: string;
  text: string;
  trait_signals: TraitSignal[];
}

export interface Question {
  question_id: string;
  layer: 'psychometric' | 'decision' | 'communication' | 'logical' | 'values';
  question_type: string;
  text: string;
  options: AnswerOption[];
}

export interface UserResponse {
  question_id: string;
  option_id: string;
  time_taken: number;
}

// --- TRAIT SCORING ENGINE ---

export class TraitProfile {
  trait_totals: Record<string, number> = {};
  trait_counts: Record<string, number> = {};
  trait_opportunities: Record<string, number> = {};

  applySignal(signal: TraitSignal, speed_multiplier: number = 1.0) {
    if (!this.trait_totals[signal.trait]) {
      this.trait_totals[signal.trait] = 0.0;
      this.trait_counts[signal.trait] = 0;
    }
    this.trait_totals[signal.trait] += signal.weight * speed_multiplier;
    this.trait_counts[signal.trait] += 1;
  }

  recordOpportunity(trait: string) {
    if (!this.trait_opportunities[trait]) {
      this.trait_opportunities[trait] = 0;
    }
    this.trait_opportunities[trait] += 1;
  }
}

export class TraitScoringEngine {
  constructor(public totals: Record<string, number>, public counts: Record<string, number>, public opportunities: Record<string, number>) {}

  score(): Record<string, number> {
    const hit_rates: Record<string, number> = {};
    const confident: Record<string, number> = {};
    const saturated: Record<string, number> = {};

    // Calculate Hit Rate (Win Rate): totals / opportunities
    for (const trait in this.totals) {
      const opps = this.opportunities[trait] || 1;
      hit_rates[trait] = Math.min(this.totals[trait] / opps, 1.0);
    }

    // Apply Confidence based on opportunities
    for (const trait in hit_rates) {
      const opps = this.opportunities[trait] || 1;
      let confidence = 1.0;
      if (opps <= 1) confidence = 0.6;
      else if (opps === 2) confidence = 0.8;
      else if (opps === 3) confidence = 0.9;
      
      confident[trait] = hit_rates[trait] * confidence;
    }

    // Apply Saturation (tanh) to smooth out the curve
    for (const trait in confident) {
      // Clamp between 0.0 and 1.0 to prevent scores from exceeding 100%
      const saturatedValue = Math.tanh(confident[trait] * 1.5);
      saturated[trait] = Math.min(Math.max(saturatedValue, 0.0), 1.0);
    }

    return saturated;
  }
}

// --- DOMAIN SCORING ENGINE ---

export const DOMAIN_TRAIT_WEIGHTS: Record<string, Record<string, number>> = {
  decision_making: { decision_speed: 0.20, judgment_quality: 0.20, risk_assessment: 0.20, prioritization: 0.20, strategic_judgment: 0.20, analytical_rigor: 0.15, financial_prudence: 0.15, pragmatism: 0.15, contingency_planning: 0.15, decisiveness: 0.15, long_term_focus: 0.15, short_term_focus: 0.10, heuristic_reasoning: 0.10, mitigation_planning: 0.15, risk_management: 0.20, roadmap_integrity: 0.15, technical_feasibility: 0.15, operational_practicality: 0.15, problem_solving: 0.25, skepticism: 0.15, optimism: 0.10 },
  behavioral_style: { structure_preference: 0.20, adaptability: 0.20, initiative: 0.20, iterative_mindset: 0.20, resilience: 0.20, process_adherence: 0.15, experimentation: 0.20, consistency: 0.15, caution: 0.10, risk_taking: 0.15, risk_aversion: 0.10, efficiency: 0.15, preparedness: 0.15, planning: 0.15, creativity: 0.20 },
  communication: { communication_clarity: 0.25, assertiveness: 0.20, confidence_expression: 0.20, negotiation_skill: 0.20, client_communication: 0.20, transparency: 0.20, influence: 0.20, public_orientation: 0.15, evidence_based_communication: 0.15, top_down_communication: 0.15, technical_clarity: 0.15, clarity_seeking: 0.15, engagement: 0.15, interpersonal_evidence: 0.15, situational_awareness: 0.20 },
  emotional_intelligence: { empathy: 0.25, emotional_regulation: 0.25, conflict_handling: 0.20, collaboration: 0.25, people_focus: 0.20, relationship_management: 0.20, fairness: 0.20, cultural_fit: 0.15, team_orientation: 0.20, interpersonal_skill: 0.20, grace_under_pressure: 0.15, compromise_orientation: 0.15, customer_repair: 0.20, service_orientation: 0.25, humility: 0.20, justice_orientation: 0.20 },
  professional_readiness: { ownership: 0.25, reliability: 0.20, professional_maturity: 0.20, ethical_orientation: 0.25, customer_focus: 0.20, client_focus: 0.20, deadline_orientation: 0.20, integrity: 0.25, accountability: 0.20, business_priority: 0.15, performance_management: 0.15, stakeholder_management: 0.20, legal_awareness: 0.15, proactive_enforcement: 0.15, role_alignment: 0.15, performance_balance: 0.15, quality_orientation: 0.20 },
  learning_agility: { learning_orientation: 0.25, feedback_receptiveness: 0.20, self_awareness: 0.20, feedback_oriented: 0.25, reflection: 0.20, mentorship_orientation: 0.20, research_orientation: 0.20, development_orientation: 0.20, resourcefulness: 0.20, holistic_assessment: 0.15, synthesis: 0.15, learning_agility: 0.25 }
};

export class DomainScoringEngine {
  static compute(trait_scores: Record<string, number>): Record<string, number> {
    const domain_scores: Record<string, number> = {};
    
    for (const [domain, traits] of Object.entries(DOMAIN_TRAIT_WEIGHTS)) {
      const scored_traits: { trait: string, score: number, weight: number }[] = [];
      
      for (const [trait, weight] of Object.entries(traits)) {
        if (trait_scores[trait] !== undefined) {
          scored_traits.push({ trait, score: trait_scores[trait], weight });
        }
      }

      scored_traits.sort((a, b) => b.score - a.score);
      const top_traits = scored_traits.slice(0, 5);

      let total = 0.0;
      let weight_sum = 0.0;

      for (const item of top_traits) {
        total += item.score * item.weight;
        weight_sum += item.weight;
      }

      domain_scores[domain] = weight_sum > 0 ? total / weight_sum : 0.0;
    }
    return domain_scores;
  }
}

// --- ROLE FIT ENGINE ---

export interface RiskRule { trait: string; threshold: number; penalty: number; description: string; }
export interface RoleBlueprint {
  role_name: string;
  domain_weights: Record<string, number>;
  critical_traits: Record<string, number>;
  risk_rules: RiskRule[];
  readiness_thresholds: { ready: number; developing: number; };
}

export class RoleFitEngine {
  static computeRoleFit(domain_scores: Record<string, number>, trait_scores: Record<string, number>, blueprint: RoleBlueprint): number {
    let base_score = 0.0;
    for (const [domain, weight] of Object.entries(blueprint.domain_weights)) {
      base_score += (domain_scores[domain] || 0.0) * weight;
    }

    let penalty = 0.0;
    let critical_bonus = 0.0;

    for (const rule of blueprint.risk_rules) {
      if ((trait_scores[rule.trait] || 0.0) < rule.threshold) {
        penalty += rule.penalty;
      }
    }

    for (const [trait, minVal] of Object.entries(blueprint.critical_traits)) {
      const val = trait_scores[trait] || 0.0;
      if (val < minVal) {
        penalty += 0.15;
      } else {
        // Tie-breaker bonus for exceeding critical trait minimums
        critical_bonus += (val - minVal) * 0.2;
      }
    }

    return Math.max(base_score - penalty + critical_bonus, 0.0);
  }
}

// --- TIMING AND SESSION LOGIC ---

export function getSpeedMultiplier(time_taken: number, layer: string): number {
  if (time_taken > 60.0) return 0.9; // Slow penalty
  if (time_taken < 10.0 && (layer === 'decision' || layer === 'logical')) return 1.1; // Fast bonus
  return 1.0;
}

export function calculateFinalScores(questions: Question[], responses: UserResponse[], blueprints: RoleBlueprint[]) {
  const profile = new TraitProfile();
  
  const questionMap = new Map<string, Question>();
  const optionMap = new Map<string, AnswerOption>();
  const questionUniqueTraits = new Map<string, string[]>();

  for (const q of questions) {
    questionMap.set(q.question_id, q);

    const traits = new Set<string>();
    for (const opt of q.options) {
      optionMap.set(opt.option_id, opt);
      for (const sig of opt.trait_signals) {
        traits.add(sig.trait);
      }
    }
    questionUniqueTraits.set(q.question_id, Array.from(traits));
  }

  for (const response of responses) {
    const question = questionMap.get(response.question_id);
    if (!question) continue;

    // Record opportunities for ALL traits present in ANY option of this question
    const uniqueTraits = questionUniqueTraits.get(question.question_id);
    if (uniqueTraits) {
      for (const trait of uniqueTraits) {
        profile.recordOpportunity(trait);
      }
    }

    const option = optionMap.get(response.option_id);
    if (!option) continue;
    
    const multiplier = getSpeedMultiplier(response.time_taken, question.layer);
    for (const signal of option.trait_signals) {
      profile.applySignal(signal, multiplier);
    }
  }
  
  const engine = new TraitScoringEngine(profile.trait_totals, profile.trait_counts, profile.trait_opportunities);
  const trait_scores = engine.score();
  const domain_scores = DomainScoringEngine.compute(trait_scores);
  
  const role_scores: Record<string, number> = {};
  for (const bp of blueprints) {
    role_scores[bp.role_name] = RoleFitEngine.computeRoleFit(domain_scores, trait_scores, bp);
  }
  
  return { trait_scores, domain_scores, role_scores };
}
