            className="h-14 px-8 text-lg font-medium rounded-full bg-transparent border-white/30 text-white/50 backdrop-blur-sm w-full sm:w-auto cursor-not-allowed"
          >
            <RotateCcw className="w-5 h-5 mr-2 opacity-50" />
            Continue Assessment
          </Button>
        </div>
      </div>
    </div>
  );
}
