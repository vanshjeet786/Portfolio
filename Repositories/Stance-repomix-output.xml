export function Logo3D({ 
  version = 1, 
  color = "#DDFE71", 
  scale = 0.0008, 
  wireframe = false,
  thickness = 150
}: { 
  version?: number, 
  color?: string, 
  scale?: number, 
  wireframe?: boolean,
  thickness?: number
}) {
  const groupRef = useRef<THREE.Group>(null!)

  // Parse the SVG once on load to extract the lightning shape.
  const shapesData = useMemo(() => {
    try {
      const loader = new SVGLoader()
      const svgData = loader.parse(SVG_DATA_STRING)
      return svgData.paths.flatMap(path => SVGLoader.createShapes(path))
    } catch (e) {
      console.error("Failed to parse logo SVG paths in 3D loader:", e)
      return []
    }
  }, [])

  // Standard Extrusion parameters
  const extrudeSettings = useMemo(() => {
    return {
      depth: thickness,
      bevelEnabled: true,
      bevelSegments: 5,
      steps: 1,
      bevelSize: 10,
      bevelThickness: 10
    }
  }, [thickness])

  // Center alignment offset calculation (SVG bounds are approx 2124x3093)
  // Shift by half and rotate X to convert from web coordinates to WebGL.
  const svgCenterOffset = { x: -1062, y: -1546, z: -thickness / 2 }

  if (shapesData.length === 0) {
    return (
      <mesh>
        <boxGeometry args={[1.5, 1.5, 0.2]} />
        <meshStandardMaterial color={color} roughness={0.5} />
      </mesh>
    )
  }

  // We use a ref to store animation variables to prevent extra React re-renders.
  const animationRef = useRef({
    active: false,
    elapsed: 0,
    duration: 0.8, // 0.8 seconds duration
  })

  const handleClick = (e: any) => {
    e.stopPropagation()
    animationRef.current.active = true
    animationRef.current.elapsed = 0
  }

  // PASSIVE GENTLE FLOAT / SPINNING ANIMATION Inside Anatomy Background
  // We utilize useFrame to keep the logo organic and alive in a low-draw manner.
  useFrame((state, delta) => {
    if (groupRef.current) {
      // Gentle floating oscillation
      const floatY = Math.sin(state.clock.elapsedTime * 1.5) * 0.06
      groupRef.current.position.y = floatY

      if (animationRef.current.active) {
        animationRef.current.elapsed += delta
        const progress = Math.min(1, animationRef.current.elapsed / animationRef.current.duration)
        
        // Quick 360-degree rotation spin
        const rotationAngle = progress * Math.PI * 2
        groupRef.current.rotation.y = rotationAngle

        // Quick scale pulse back and forth
        const scaleMultiplier = 1 + Math.sin(progress * Math.PI) * 0.35
        groupRef.current.scale.set(scale * scaleMultiplier, scale * scaleMultiplier, scale * scaleMultiplier)

        if (progress >= 1) {
          animationRef.current.active = false
        }
      } else {
        // Reset scale and rotation back to default organic state when not pulsing
        groupRef.current.rotation.y = 0
        groupRef.current.scale.set(scale, scale, scale)
      }
    }
  })

  return (
    <group ref={groupRef} scale={[scale, scale, scale]} onClick={handleClick}>
      {/* Outer wrapper adjusts SVG coords: scale, Y-flip, and Z placement */}
      <group rotation={[Math.PI, 0, 0]} position={[0, 0, 0]}>
        
        {/* Style Version 1: "Skeletal Precision" (Pure Galvanized Steel + High-Sheen Lime Highlights) */}
        {version === 1 && shapesData.map((shape, i) => (
          <mesh 
            key={`v1-${i}`} 
            position={[svgCenterOffset.x, svgCenterOffset.y, svgCenterOffset.z]}
            castShadow 
            receiveShadow
          >
            <extrudeGeometry args={[shape, extrudeSettings]} />
            <meshStandardMaterial 
              color={color}
              roughness={0.15}
              metalness={0.8}
              transparent={true}
              opacity={0.9}
              wireframe={wireframe}
            />
          </mesh>
        ))}

        {/* Style Version 2: "Neurological Pulse" (Luminous Neon Core + Float Outline Wireframe) */}
        {version === 2 && shapesData.map((shape, i) => (
          <group key={`v2-group-${i}`}>
            {/* Luminous Core Body */}
            <mesh 
              position={[svgCenterOffset.x, svgCenterOffset.y, svgCenterOffset.z]}
            >
              <extrudeGeometry args={[shape, { ...extrudeSettings, depth: thickness * 0.8 }]} />
              <meshBasicMaterial 
                color={color} 
                transparent={true}
                opacity={0.8}
              />
            </mesh>

            {/* Neural Telemetry Outline Grid (offset slightly forward and larger) */}
            <mesh 
              position={[svgCenterOffset.x, svgCenterOffset.y, svgCenterOffset.z + 10]}
              scale={[1.02, 1.02, 1.02]}
            >
              <extrudeGeometry args={[shape, { ...extrudeSettings, depth: thickness * 0.9, bevelEnabled: false }]} />
              <meshBasicMaterial 
                color="#132644" 
                wireframe={true} 
                transparent={true}
                opacity={0.4}
              />
            </mesh>
          </group>
        ))}

        {/* Style Version 3: "Contrast Carbon" (Heavy-Duty Dual Layer Matte Black + Fluorescent Volt Overlay) */}
        {version === 3 && shapesData.map((shape, i) => (
          <group key={`v3-group-${i}`}>
            {/* Heavy Base Plate (Extra chunky depth, Dark Steel/Slate finish) */}
            <mesh 
              position={[svgCenterOffset.x, svgCenterOffset.y, svgCenterOffset.z - 40]}
              castShadow 
              receiveShadow
            >
              <extrudeGeometry args={[shape, { ...extrudeSettings, depth: thickness * 1.5 }]} />
              <meshStandardMaterial 
                color="#132644"
                roughness={0.6}
                metalness={0.7}
              />
            </mesh>
            
            {/* Volt Glowing Top Plate */}
            <mesh 
              position={[svgCenterOffset.x, svgCenterOffset.y, svgCenterOffset.z + thickness * 0.5]}
              castShadow
            >
              <extrudeGeometry args={[shape, { ...extrudeSettings, depth: thickness * 0.4 }]} />
              <meshStandardMaterial 
                color={color}
                roughness={0.1}
                metalness={0.5}
                emissive={color}
                emissiveIntensity={0.25}
              />
            </mesh>
          </group>
        ))}

        {/* Style Version 4: "Bio-Glass Fusion" (Hypoallergenic Medical Gel Refractive Glass Shape) */}
        {version === 4 && shapesData.map((shape, i) => (
          <mesh 
            key={`v4-${i}`} 
            position={[svgCenterOffset.x, svgCenterOffset.y, svgCenterOffset.z]}
            castShadow 
            receiveShadow
          >
            <extrudeGeometry args={[shape, extrudeSettings]} />
            <meshStandardMaterial 
              color={color}
              roughness={0.1}
              metalness={0.9}
              transparent={true}
              opacity={0.65}
              side={THREE.DoubleSide}
            />
          </mesh>
        ))}

      </group>
    </group>
  )
}
