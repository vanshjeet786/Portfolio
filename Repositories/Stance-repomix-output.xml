"use client"
import React from 'react'
import { Canvas } from '@react-three/fiber'
import { ScrollControls, Environment, Float, PerspectiveCamera } from '@react-three/drei'
import { Anatomy } from './Anatomy'
import { ValdTech } from './ValdTech'
import { SpineModel, JointModel, KneeModel, PelvicModel } from './gsap'
import { ClientOnly } from '../ClientOnlyCanvas'

function SafeCanvas({ children, ...props }: any) {
  return (
    <Canvas {...props} eventSource={typeof window !== 'undefined' ? document.getElementById('root') || document.body : undefined}>
      {children}
    </Canvas>
  )
}

export default function Scene({ concept = 1, part = 'body', isExploded = false }) {
  const isDark = concept === 2 || concept === 4;

  // We check if this is a GSAP page. If so, we bypass ScrollControls
  // so GSAP can take over the main document scroll.
  const isGsapPage = part === 'back' || part === 'sports' || part === 'knee' || part === 'womens';

  return (
    <div className="fixed inset-0 z-0 pointer-events-none">
      <ClientOnly>
      <SafeCanvas shadows dpr={[1, 2]}>
        <PerspectiveCamera makeDefault position={[0, 0, 5]} fov={50} />

        {/* Cinematic Lighting for Concept 2 */}
        {concept === 2 ? (
          <>
            <spotLight position={[10, 10, 10]} angle={0.15} penumbra={1} intensity={2} color="#ddfe71" castShadow />
            <spotLight position={[-10, 5, 5]} angle={0.2} penumbra={1} intensity={1} color="#addcec" />
            <pointLight position={[0, -5, 2]} intensity={5} color="#fe7833" />
          </>
        ) : (
          <>
            <ambientLight intensity={0.5} />
            <spotLight position={[10, 10, 10]} angle={0.15} penumbra={1} />
            <pointLight position={[-10, -10, -10]} />
          </>
        )}

        <Environment preset={isDark ? "night" : "city"} />

        {isGsapPage ? (
           <Float speed={1.5} rotationIntensity={0.5} floatIntensity={0.5}>
             <SpineModel isVisible={part === 'back'} isExploded={isExploded} isDark={isDark} />
             <JointModel isVisible={part === 'sports'} isDark={isDark} />
             <KneeModel isVisible={part === 'knee'} isDark={isDark} />
             <PelvicModel isVisible={part === 'womens'} isDark={isDark} />
           </Float>
        ) : (
          <ScrollControls pages={4} damping={0.1}>
            <Float speed={1.5} rotationIntensity={0.5} floatIntensity={0.5}>
              <Anatomy concept={concept} part={part} />
            </Float>
            <ValdTech active={concept === 2 || concept === 4} />
          </ScrollControls>
        )}

      </SafeCanvas>
      </ClientOnly>
    </div>
  )
}
