<file path="src/App.tsx">
import React from 'react';
import { usePathname, useSearchParams } from 'next/navigation';
import RootLayout from '../app/layout';
import Home from '../app/page';
import BackSpine from '../app/back-pain/page';
import KneePain from '../app/knee-pain/page';
import SportsInjury from '../app/sports-injury/page';
import WomensHealthPage from '../app/womens-health/page';
import BookingFlowPage from '../app/booking/flow/page';
import BookingIntakePage from '../app/booking/intake/page';
import BookingModalPage from '../app/booking/modal/page';
import LogoLabPage from '../app/logo-lab/page';
import AclTearLabPage from '../app/logo-lab/acl/page';

export default function App() {
  const pathname = usePathname();
  const searchParams = useSearchParams();

  // Next.js 15 pages expect searchParams as a Promise
  const searchParamsObj = Object.fromEntries(searchParams.entries());
  const searchParamsPromise = Promise.resolve(searchParamsObj);

  let pageElement = null;

  if (pathname === '/' || pathname === '') {
    pageElement = <Home />;
  } else if (pathname === '/back-pain' || pathname === '/back-spine') {
    pageElement = <BackSpine />;
  } else if (pathname === '/knee-pain') {
    pageElement = <KneePain />;
  } else if (pathname === '/sports-injury') {
    pageElement = <SportsInjury />;
  } else if (pathname === '/womens-health') {
    pageElement = <WomensHealthPage />;
  } else if (pathname === '/booking/flow') {
    pageElement = <BookingFlowPage />;
  } else if (pathname === '/booking/intake') {
    pageElement = <BookingIntakePage />;
  } else if (pathname === '/booking/modal') {
    pageElement = <BookingModalPage />;
  } else if (pathname === '/logo-lab' || pathname === '/logo-preview') {
    pageElement = <LogoLabPage />;
  } else if (pathname === '/logo-lab/acl' || pathname === '/logo-lab/acl-tear' || pathname === '/acl-tear') {
    pageElement = <AclTearLabPage />;
  } else {
    pageElement = <Home />;
  }

  return (
    <RootLayout>
      {pageElement}
    </RootLayout>
  );
}
