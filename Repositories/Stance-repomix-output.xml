function InteractiveKnee({ flexed }: { flexed: boolean }) {
  const tibiaRef = useRef<THREE.Group>(null!)
  const angleRef = useRef({ val: 0.08 })
  const lineRef = useRef<any>(null!)

  useFrame((state) => {
    // Flexion is 58 degrees (1.01 radians)
    const target = flexed ? 1.01 : 0.08
    angleRef.current.val = THREE.MathUtils.lerp(angleRef.current.val, target, 0.08)
    const currentAngle = angleRef.current.val

    // Update tibia rotation directly in canvas loop
    if (tibiaRef.current) {
      tibiaRef.current.rotation.z = currentAngle
    }

    // Adapt ACL Line coordinates dynamically
    if (lineRef.current) {
      const g = lineRef.current.geometry
      const pos = g.attributes.position
      pos.setXYZ(0, 0, 0.1, 0)
      pos.setXYZ(1, Math.sin(currentAngle) * -0.32, -0.32 * Math.cos(currentAngle), 0)
      pos.needsUpdate = true
    }
  })

  return (
    <group scale={[1.15, 1.15, 1.15]} position={[0, 0.1, 0]}>
      {/* Femur Upper Distal Bone (Static shaft representation) */}
      <mesh position={[0, 0.62, 0]}>
        <cylinderGeometry args={[0.16, 0.23, 1.1, 16]} />
        <meshStandardMaterial 
          color="#addcec" 
          roughness={0.15} 
          metalness={0.7}
          transparent
          opacity={0.9} 
        />
      </mesh>
      
      {/* Tibia Knee Joint Bottom Bone (Pivot Rotates around joint hinge) */}
      <group ref={tibiaRef} rotation={[0, 0, 0.08]}>
        <mesh position={[0, -0.62, 0]}>
          <cylinderGeometry args={[0.22, 0.15, 1.1, 16]} />
          <meshStandardMaterial 
            color="#addcec" 
            roughness={0.15} 
            metalness={0.7}
            transparent 
            opacity={0.9} 
          />
        </mesh>
      </group>

      {/* Synovial Joint Articular Capsule */}
      <mesh position={[0, 0, 0]}>
        <sphereGeometry args={[0.26, 32, 32]} />
        <meshStandardMaterial 
          color={flexed ? '#ddfe71' : '#ef4444'} 
          emissive={flexed ? '#223800' : '#470202'} 
          metalness={0.9} 
          roughness={0.1} 
        />
      </mesh>

      {/* Dynamic Anterior Cruciate Ligament (ACL) Vector Line */}
      <Line
        ref={lineRef}
        points={[ 
          new THREE.Vector3(0, 0.1, 0), 
          new THREE.Vector3(Math.sin(0.08) * -0.32, -0.32 * Math.cos(0.08), 0) 
        ]}
        color={flexed ? "#ddfe71" : "#ef4444"}
        lineWidth={4.0}
      />
    </group>
  )
}

