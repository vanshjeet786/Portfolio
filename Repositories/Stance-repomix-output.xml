import React, { useRef } from "react";
import { useFrame } from "@react-three/fiber";
import * as THREE from "three";
import { VISUAL_COLORS } from "./lib/animationConfig";

interface ACLModelProps {
  scrollProgress: number; // 0 to 4 representing current scroll phase
}

export function ACLModel({ scrollProgress }: ACLModelProps) {
  const amTopRef = useRef<THREE.Mesh>(null!);
  const amBottomRef = useRef<THREE.Mesh>(null!);
  const plTopRef = useRef<THREE.Mesh>(null!);
  const plBottomRef = useRef<THREE.Mesh>(null!);
  const aclGroupRef = useRef<THREE.Group>(null!);

  useFrame((state) => {
    // Determine exact values based on scrollProgress (0 to 4)
    let opacity = 0;
    let highlightFactor = 0;
    let flexFactor = 0;
    let tearFactor = 0;
    let recoveryFactor = 0;

    // 1. Introduction (0 to 1) -> Fade in ACL
    if (scrollProgress < 1.0) {
      opacity = THREE.MathUtils.lerp(0.0, 0.9, scrollProgress);
    } 
    // 2. Highlight (1 to 2) -> Glow / pulse highlight
    else if (scrollProgress < 2.0) {
      const t = scrollProgress - 1.0;
      opacity = 0.9;
      highlightFactor = THREE.MathUtils.lerp(0.0, 1.0, t);
    } 
    // 3. Movement (2 to 3) -> Controlled knee flexion
    else if (scrollProgress < 3.0) {
      const t = scrollProgress - 2.0;
      opacity = 0.9;
      flexFactor = THREE.MathUtils.lerp(0.0, 1.0, t);
    } 
    // 4. Tear (3 to 4) -> Fibers separate and turn muted red
    else {
      const t = scrollProgress - 3.0;
      opacity = 0.9;
      // In recovery, we still show the tear but soft-fade the warning redness and emphasize stability
      tearFactor = 1.0; 
      if (scrollProgress >= 4.0) {
        recoveryFactor = 1.0;
      } else {
        tearFactor = t;
      }
    }

    if (scrollProgress >= 4.0) {
      opacity = 0.9;
      tearFactor = 1.0;
      recoveryFactor = 1.0;
    }

    // Dynamic micro-pulse for the highlight phase
    const pulse = 1.0 + Math.sin(state.clock.elapsedTime * 6) * 0.08 * highlightFactor;
    
    // Dynamic micro-pulse for the tear phase warning indicator
    const tearPulse = 1.0 + Math.sin(state.clock.elapsedTime * 8) * 0.12 * (tearFactor * (1 - recoveryFactor));

    // Calculate tear separation gap
    const amGap = 0.14 * tearFactor;
    const plGap = 0.11 * tearFactor;

    // Apply mechanical stretching during flexion (Section 3)
    const flexStretch = 1.0 + flexFactor * 0.15;

    // Animate AM Bundle (Anteromedial)
    if (amTopRef.current && amBottomRef.current) {
      const amTopMat = amTopRef.current.material as THREE.MeshStandardMaterial;
      const amBotMat = amBottomRef.current.material as THREE.MeshStandardMaterial;

      // Position top segment of bundle
      amTopRef.current.position.set(
        -0.03,
        0.18 + amGap * 1.2,
        -0.03
      );
      amTopRef.current.scale.set(pulse, flexStretch, pulse);

      // Position bottom segment of bundle
      amBottomRef.current.position.set(
        -0.02,
        -0.12 - amGap * 1.2,
        0.04
      );
      amBottomRef.current.scale.set(pulse, flexStretch, pulse);

      // Color Morphing Logic
      let targetColor = new THREE.Color(VISUAL_COLORS.aclHealthy);
      
      if (highlightFactor > 0) {
        targetColor.lerp(new THREE.Color(VISUAL_COLORS.aclHighlighted), highlightFactor);
      } else if (tearFactor > 0) {
        // Red color for the torn edges
        const redColor = new THREE.Color(VISUAL_COLORS.aclTornRed);
        if (recoveryFactor > 0) {
          // Soften red in recovery phase
          const healedColor = new THREE.Color("#e6c0ab"); // Soft coral-beige healing look
          targetColor.lerp(healedColor, 1.0);
        } else {
          targetColor.lerp(redColor, tearFactor);
        }
      }

      // Update material color and properties
      amTopMat.color.copy(targetColor);
      amBotMat.color.copy(targetColor);

      amTopMat.opacity = opacity;
      amBotMat.opacity = opacity;

      // Glow pulse reflection setting
      amTopMat.emissive.copy(targetColor).multiplyScalar(highlightFactor * 0.25 * pulse + tearFactor * 0.15 * (1 - recoveryFactor) * tearPulse);
      amBotMat.emissive.copy(targetColor).multiplyScalar(highlightFactor * 0.25 * pulse + tearFactor * 0.15 * (1 - recoveryFactor) * tearPulse);
    }

    // Animate PL Bundle (Posterolateral)
    if (plTopRef.current && plBottomRef.current) {
      const plTopMat = plTopRef.current.material as THREE.MeshStandardMaterial;
      const plBotMat = plBottomRef.current.material as THREE.MeshStandardMaterial;

      // Position segments
      plTopRef.current.position.set(
        0.06,
        0.12 + plGap * 1.2,
        0.03
      );
      plTopRef.current.scale.set(pulse, flexStretch, pulse);

      plBottomRef.current.position.set(
        0.04,
        -0.15 - plGap * 1.2,
        -0.05
      );
      plBottomRef.current.scale.set(pulse, flexStretch, pulse);

      let targetColor = new THREE.Color(VISUAL_COLORS.aclHealthy);
      if (highlightFactor > 0) {
        targetColor.lerp(new THREE.Color(VISUAL_COLORS.aclHighlighted), highlightFactor);
      } else if (tearFactor > 0) {
        const redColor = new THREE.Color(VISUAL_COLORS.aclTornRed);
        if (recoveryFactor > 0) {
          const healedColor = new THREE.Color("#e6c0ab");
          targetColor.lerp(healedColor, 1.0);
        } else {
          targetColor.lerp(redColor, tearFactor);
        }
      }

      plTopMat.color.copy(targetColor);
      plBotMat.color.copy(targetColor);

      plTopMat.opacity = opacity;
      plBotMat.opacity = opacity;

      plTopMat.emissive.copy(targetColor).multiplyScalar(highlightFactor * 0.25 * pulse + tearFactor * 0.15 * (1 - recoveryFactor) * tearPulse);
      plBotMat.emissive.copy(targetColor).multiplyScalar(highlightFactor * 0.25 * pulse + tearFactor * 0.15 * (1 - recoveryFactor) * tearPulse);
    }
  });

  return (
    <group ref={aclGroupRef} position={[0, -0.15, 0]}>
      {/* 1. Anteromedial (AM) Bundle - Primary load bearer */}
      <group>
        {/* Top segment attached to Femur notch */}
        <mesh ref={amTopRef}>
          <cylinderGeometry args={[0.045, 0.04, 0.35, 12]} />
          <meshStandardMaterial
            roughness={0.4}
            metalness={0.1}
            transparent={true}
            depthWrite={true}
          />
        </mesh>
        {/* Bottom segment attached to Tibia plateau */}
        <mesh ref={amBottomRef}>
          <cylinderGeometry args={[0.04, 0.05, 0.35, 12]} />
          <meshStandardMaterial
            roughness={0.4}
            metalness={0.1}
            transparent={true}
            depthWrite={true}
          />
        </mesh>
      </group>

      {/* 2. Posterolateral (PL) Bundle - Rotational anchor */}
      <group>
        {/* Top segment */}
        <mesh ref={plTopRef}>
          <cylinderGeometry args={[0.035, 0.03, 0.32, 12]} />
          <meshStandardMaterial
            roughness={0.4}
            metalness={0.1}
            transparent={true}
            depthWrite={true}
          />
        </mesh>
        {/* Bottom segment */}
        <mesh ref={plBottomRef}>
          <cylinderGeometry args={[0.03, 0.04, 0.32, 12]} />
          <meshStandardMaterial
            roughness={0.4}
            metalness={0.1}
            transparent={true}
            depthWrite={true}
          />
        </mesh>
      </group>
    </group>
  );
}

export default ACLModel;
