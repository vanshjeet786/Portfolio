function InteractiveSpine({ decompressed }: { decompressed: boolean }) {
  const groupRef = useRef<THREE.Group>(null!)
  const discPosRef = useRef({ val: 0 })

  useFrame((state) => {
    const target = decompressed ? 1 : 0
    discPosRef.current.val = THREE.MathUtils.lerp(discPosRef.current.val, target, 0.08)

    // Slow absolute axial rotation to show vertebral facet depth
    if (groupRef.current) {
      groupRef.current.rotation.y = state.clock.getElapsedTime() * 0.35
      
      const children = groupRef.current.children
      for (let i = 0; i < 5; i++) {
        const mesh = children[i] as THREE.Mesh
        if (mesh && mesh.geometry && mesh.geometry.type === 'CylinderGeometry') {
          // Increase vertebrae gap structure upon decompression trigger
          const baseSpacing = (i - 2) * 0.36
          const decompSpacing = (i - 2) * 0.65
          mesh.position.y = THREE.MathUtils.lerp(baseSpacing, decompSpacing, discPosRef.current.val)
          
          // Micro dynamic postural sway representing breathing motion
          mesh.rotation.x = Math.sin(state.clock.getElapsedTime() + i * 0.5) * 0.03
        }
      }
    }
  })

  return (
    <group ref={groupRef} scale={[1.1, 1.1, 1.1]} position={[0, 0, 0]}>
      {/* 5 Lumbar Spinal Segment Vertebrae */}
      {Array.from({ length: 5 }).map((_, i) => (
        <mesh key={i} position={[0, (i - 2) * 0.36, 0]}>
          <cylinderGeometry args={[0.38, 0.42, 0.15, 16]} />
          <meshStandardMaterial 
            color={i === 2 ? (decompressed ? '#ddfe71' : '#ef4444') : '#addcec'} 
            emissive={i === 2 ? (decompressed ? '#2d3f00' : '#4a0101') : '#082136'}
            roughness={0.1}
            metalness={0.9}
            transparent
            opacity={0.9}
          />
        </mesh>
      ))}
      
      {/* Central Autonomous Nerval Pathway (Inner Spinal Cord Core) */}
      <mesh>
        <cylinderGeometry args={[0.06, 0.06, 3.0, 12]} />
        <meshBasicMaterial color="#ddfe71" transparent opacity={0.65} />
      </mesh>
    </group>
  )
}

