                    >
                      0{sec.id}
                    </button>
                  );
                })}
              </div>
            </div>

          </div>

        </div>

        {/* FLOATING TEXT SECTIONS SCROLLING OVER STICKY GL VIEWPORT (Aligned to Right) */}
        <div className="relative w-full max-w-7xl mx-auto flex justify-end z-20 pointer-events-none">
          <div className="w-full md:w-1/2 lg:w-5/12 pointer-events-auto">
            <ScrollSections 
              currentSectionIndex={currentSectionIndex} 
              scrollProgress={manualProgress !== null ? manualProgress : scrollProgressRef.current} 
            />
          </div>
        </div>

      </div>

      {/* FOOTER STATS RAIL */}
      <footer className="relative z-30 bg-[#0c1417]/95 text-zinc-400 border-t border-[#16272a] py-8 px-6 md:px-12 font-mono text-[10px] uppercase">
