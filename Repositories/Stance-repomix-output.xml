<file path="components/acl/CameraController.tsx">
import { useFrame } from "@react-three/fiber";
import * as THREE from "three";
import { CAMERA_STATES } from "./lib/animationConfig";

interface CameraControllerProps {
  scrollProgress: number; // 0.0 to 4.0
}

export function CameraController({ scrollProgress }: CameraControllerProps) {
  useFrame((state) => {
    // Setup target variables
    const targetPos = new THREE.Vector3();
    let targetFov = 45;

    if (scrollProgress < 1.0) {
      const t = scrollProgress;
      targetPos.set(
        THREE.MathUtils.lerp(CAMERA_STATES.introduction.position[0], CAMERA_STATES.highlight.position[0], t),
        THREE.MathUtils.lerp(CAMERA_STATES.introduction.position[1], CAMERA_STATES.highlight.position[1], t),
        THREE.MathUtils.lerp(CAMERA_STATES.introduction.position[2], CAMERA_STATES.highlight.position[2], t)
      );
      targetFov = THREE.MathUtils.lerp(CAMERA_STATES.introduction.fov, CAMERA_STATES.highlight.fov, t);
    } else if (scrollProgress < 2.0) {
      const t = scrollProgress - 1.0;
      targetPos.set(
        THREE.MathUtils.lerp(CAMERA_STATES.highlight.position[0], CAMERA_STATES.movement.position[0], t),
        THREE.MathUtils.lerp(CAMERA_STATES.highlight.position[1], CAMERA_STATES.movement.position[1], t),
        THREE.MathUtils.lerp(CAMERA_STATES.highlight.position[2], CAMERA_STATES.movement.position[2], t)
      );
      targetFov = THREE.MathUtils.lerp(CAMERA_STATES.highlight.fov, CAMERA_STATES.movement.fov, t);
    } else if (scrollProgress < 3.0) {
      const t = scrollProgress - 2.0;
      targetPos.set(
        THREE.MathUtils.lerp(CAMERA_STATES.movement.position[0], CAMERA_STATES.tear.position[0], t),
        THREE.MathUtils.lerp(CAMERA_STATES.movement.position[1], CAMERA_STATES.tear.position[1], t),
        THREE.MathUtils.lerp(CAMERA_STATES.movement.position[2], CAMERA_STATES.tear.position[2], t)
      );
      targetFov = THREE.MathUtils.lerp(CAMERA_STATES.movement.fov, CAMERA_STATES.tear.fov, t);
    } else {
      const t = Math.min(1.0, scrollProgress - 3.0);
      targetPos.set(
        THREE.MathUtils.lerp(CAMERA_STATES.tear.position[0], CAMERA_STATES.recovery.position[0], t),
        THREE.MathUtils.lerp(CAMERA_STATES.tear.position[1], CAMERA_STATES.recovery.position[1], t),
        THREE.MathUtils.lerp(CAMERA_STATES.tear.position[2], CAMERA_STATES.recovery.position[2], t)
      );
      targetFov = THREE.MathUtils.lerp(CAMERA_STATES.tear.fov, CAMERA_STATES.recovery.fov, t);
    }

    // Smoothly lerp camera position and fov towards targets
    const camera = state.camera as THREE.PerspectiveCamera;
    
    if (camera.isPerspectiveCamera) {
      camera.position.lerp(targetPos, 0.05);
      if (Math.abs(camera.fov - targetFov) > 0.01) {
        camera.fov = THREE.MathUtils.lerp(camera.fov, targetFov, 0.05);
        camera.updateProjectionMatrix();
      }
    } else {
      state.camera.position.lerp(targetPos, 0.05);
    }
  });

  return null;
}

export default CameraController;
</file>

<file path="components/acl/KneeModel.tsx">
import React, { useRef } from "react";
import { useFrame } from "@react-three/fiber";
import * as THREE from "three";
import { ACLModel } from "./ACLModel";
import { VISUAL_COLORS } from "./lib/animationConfig";

interface KneeModelProps {
  scrollProgress: number; // 0 to 4 representing current scroll phase
}

export function KneeModel({ scrollProgress }: KneeModelProps) {
  const kneeGroupRef = useRef<THREE.Group>(null!);
  const femurRef = useRef<THREE.Group>(null!);
  const tibiaGroupRef = useRef<THREE.Group>(null!);
  const femurShaftRef = useRef<THREE.Mesh>(null!);
  const condyleLRef = useRef<THREE.Mesh>(null!);
  const condyleRRef = useRef<THREE.Mesh>(null!);
  const tibiaShaftRef = useRef<THREE.Mesh>(null!);
  const tibiaPlateauRef = useRef<THREE.Mesh>(null!);
  const fibulaRef = useRef<THREE.Mesh>(null!);

  useFrame((state) => {
    // 1. Rotation and Orbit based on scroll
    // Section 1 (0 to 1): Introduction. Slight base rotation.
    // Section 2 (1 to 2): Rotates to side/oblique view.
    // Section 3 (2 to 3): Stays in side/oblique view for flexion.
    // Section 4 (3 to 4): Slight frontal realignment.
    // Section 5 (4+): Slow presentation spinning.

    let targetRotY = 0;
    let targetRotX = 0;
    let targetRotZ = 0;

    if (scrollProgress < 1.0) {
      // Rotate slowly from frontal to oblique
      targetRotY = THREE.MathUtils.lerp(0, -0.4, scrollProgress);
      targetRotX = THREE.MathUtils.lerp(0, 0.1, scrollProgress);
    } else if (scrollProgress < 2.0) {
      const t = scrollProgress - 1.0;
      targetRotY = THREE.MathUtils.lerp(-0.4, -1.1, t); // Turn to highlight lateral-oblique view
      targetRotX = THREE.MathUtils.lerp(0.1, 0.0, t);
    } else if (scrollProgress < 3.0) {
      // Stay side-facing for movement flexion
      targetRotY = -1.1;
      targetRotX = 0.0;
    } else if (scrollProgress < 4.0) {
      const t = scrollProgress - 3.0;
      // Face more front-oblique to show the tear gap clearly
      targetRotY = THREE.MathUtils.lerp(-1.1, -0.5, t);
      targetRotX = THREE.MathUtils.lerp(0.0, 0.15, t);
    } else {
      const t = scrollProgress - 4.0;
      // Slow showcase idle rotation
      targetRotY = -0.5 + t * 0.25 + Math.sin(state.clock.elapsedTime * 0.4) * 0.1;
      targetRotX = 0.15 + Math.cos(state.clock.elapsedTime * 0.3) * 0.05;
    }

    // Apply smooth interpolation on knee group rotation
    kneeGroupRef.current.rotation.y = THREE.MathUtils.lerp(kneeGroupRef.current.rotation.y, targetRotY, 0.08);
    kneeGroupRef.current.rotation.x = THREE.MathUtils.lerp(kneeGroupRef.current.rotation.x, targetRotX, 0.08);
    kneeGroupRef.current.rotation.z = THREE.MathUtils.lerp(kneeGroupRef.current.rotation.z, targetRotZ, 0.08);

    // Dynamic micro-floating so the model doesn't look completely frozen
    const floatY = Math.sin(state.clock.elapsedTime * 1.5) * 0.04;
    kneeGroupRef.current.position.y = -0.1 + floatY;

    // 2. Controlled Flexion (Bending) during Section 3 (scrollProgress 2.0 to 3.0)
    let flexionAngle = 0;
    let femurTranslateZ = 0;
    let femurTranslateY = 0;

    if (scrollProgress >= 2.0 && scrollProgress < 3.0) {
      const t = scrollProgress - 2.0;
      // Controlled joint flexion: femur tilts back up to ~25 degrees (0.43 rad)
      flexionAngle = -t * 0.45;
      // Femur rolls backwards on the tibia platform
      femurTranslateZ = -t * 0.12;
      femurTranslateY = t * 0.04;
    } else if (scrollProgress >= 3.0) {
      // In Section 4 and 5, knee returns to extended/standing state to examine tear clearly
      flexionAngle = 0;
      femurTranslateZ = 0;
      femurTranslateY = 0;
    }

    // Apply joint flexion parameters to Femur Group (which pivots about lower center [0, 0, 0])
    femurRef.current.rotation.x = THREE.MathUtils.lerp(femurRef.current.rotation.x, flexionAngle, 0.1);
    femurRef.current.position.z = THREE.MathUtils.lerp(femurRef.current.position.z, femurTranslateZ, 0.1);
    femurRef.current.position.y = THREE.MathUtils.lerp(femurRef.current.position.y, femurTranslateY, 0.1);

    // 3. Bone Desaturation Interpolation during Section 2 Highlight (scrollProgress 1.0 to 2.0)
    let desatFactor = 0;
    if (scrollProgress >= 1.0 && scrollProgress < 2.0) {
      desatFactor = scrollProgress - 1.0;
    } else if (scrollProgress >= 2.0 && scrollProgress < 3.0) {
      desatFactor = 1.0 - (scrollProgress - 2.0) * 0.8; // Gradually restore slight color
    } else if (scrollProgress >= 3.0) {
      desatFactor = 0.1;
    }

    const boneColor = new THREE.Color(VISUAL_COLORS.boneIvory);
    const desatColor = new THREE.Color(VISUAL_COLORS.boneIvoryDesaturated);
    const currentColor = boneColor.clone().lerp(desatColor, desatFactor * 0.8);

    // Apply bone coloring
    const updateMeshMaterial = (mesh: THREE.Mesh) => {
      if (mesh && mesh.material) {
        const mat = mesh.material as THREE.MeshStandardMaterial;
        mat.color.copy(currentColor);
        // Desaturated bones should catch a tiny bit less light
        mat.roughness = THREE.MathUtils.lerp(0.42, 0.55, desatFactor);
      }
    };

    updateMeshMaterial(femurShaftRef.current);
    updateMeshMaterial(condyleLRef.current);
    updateMeshMaterial(condyleRRef.current);
    updateMeshMaterial(tibiaShaftRef.current);
    updateMeshMaterial(tibiaPlateauRef.current);
    updateMeshMaterial(fibulaRef.current);
  });

  return (
    <group ref={kneeGroupRef} scale={[1.3, 1.3, 1.3]} position={[0, -0.1, 0]}>
      {/* 1. FEMUR GROUP (Upper Thigh Bone) - Pivots about [0,0,0] for flexion */}
      <group ref={femurRef}>
        <group position={[0, 0.15, 0]}>
          {/* Femur Main Shaft Cylinder */}
          <mesh ref={femurShaftRef} position={[0, 0.9, 0]} castShadow receiveShadow>
            <cylinderGeometry args={[0.22, 0.22, 1.3, 24, 1]} />
            <meshStandardMaterial
              roughness={0.42}
              metalness={0.05}
              color={VISUAL_COLORS.boneIvory}
            />
          </mesh>

          {/* Medial Condyle Condensation */}
          <mesh ref={condyleLRef} position={[-0.15, 0.2, -0.05]} castShadow receiveShadow>
            <sphereGeometry args={[0.19, 24, 24]} />
            <meshStandardMaterial
              roughness={0.42}
              metalness={0.05}
              color={VISUAL_COLORS.boneIvory}
            />
          </mesh>

          {/* Lateral Condyle Condensation */}
          <mesh ref={condyleRRef} position={[0.15, 0.2, -0.05]} castShadow receiveShadow>
            <sphereGeometry args={[0.19, 24, 24]} />
            <meshStandardMaterial
              roughness={0.42}
              metalness={0.05}
              color={VISUAL_COLORS.boneIvory}
            />
          </mesh>

          {/* Intercondylar Notch cut-out region (simulated by positioning condyles) */}
        </group>
      </group>

      {/* 2. TIBIA GROUP (Lower Shin Bone) - Static Base */}
      <group ref={tibiaGroupRef} position={[0, -0.15, 0]}>
        {/* Tibia Main Shaft Cylinder */}
        <mesh ref={tibiaShaftRef} position={[0, -0.85, 0.02]} castShadow receiveShadow>
          <cylinderGeometry args={[0.16, 0.13, 1.2, 24, 1]} />
          <meshStandardMaterial
            roughness={0.42}
            metalness={0.05}
            color={VISUAL_COLORS.boneIvory}
          />
        </mesh>

        {/* Tibia Plateau Platform Flare */}
        <mesh ref={tibiaPlateauRef} position={[0, -0.22, 0.02]} scale={[1.35, 0.35, 1.1]} castShadow receiveShadow>
          <cylinderGeometry args={[0.18, 0.18, 0.6, 24, 1]} />
          <meshStandardMaterial
            roughness={0.42}
            metalness={0.05}
            color={VISUAL_COLORS.boneIvory}
          />
        </mesh>

        {/* 3. FIBULA (Thin lateral side bone) - Anchored to tibia group lateral-posterior */}
        <mesh ref={fibulaRef} position={[0.26, -0.8, -0.1]} castShadow receiveShadow>
          <cylinderGeometry args={[0.045, 0.04, 1.25, 12, 1]} />
          <meshStandardMaterial
            roughness={0.42}
            metalness={0.05}
            color={VISUAL_COLORS.boneIvory}
          />
        </mesh>
      </group>

      {/* 4. THE CORE ANTERIOR CRUCIATE LIGAMENT (ACL) */}
      <ACLModel scrollProgress={scrollProgress} />

      {/* Decorative joint coordinate tracking circle (simulating modern diagnostic scan) */}
      {scrollProgress > 1.0 && scrollProgress < 3.0 && (
        <group position={[0, -0.15, 0]} rotation={[Math.PI / 2, 0, 0]}>
          <mesh>
            <ringGeometry args={[0.48, 0.5, 32]} />
            <meshBasicMaterial color={VISUAL_COLORS.lineLime} transparent opacity={0.15} side={THREE.DoubleSide} />
          </mesh>
        </group>
      )}
    </group>
  );
}

export default KneeModel;
</file>

