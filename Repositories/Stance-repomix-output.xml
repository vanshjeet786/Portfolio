function BiofeedbackRing({ isFast }: { isFast: boolean }) {
  const ringRef = useRef<THREE.Mesh>(null!)

  useFrame((state) => {
    // Healthy pacing features rhythmic compression, spasms operate erratically
    const rate = isFast ? 8.2 : 2.0
    const scaleFactor = 1 + Math.sin(state.clock.getElapsedTime() * rate) * 0.18
    if (ringRef.current) {
      ringRef.current.scale.set(scaleFactor, scaleFactor, 1)
      ringRef.current.rotation.z = state.clock.getElapsedTime() * 0.6
    }
  })

  return (
    <group scale={[1.25, 1.25, 1.25]} position={[0, 0, 0]}>
      {/* Outer Contraction Alignment Circle */}
      <mesh ref={ringRef}>
        <torusGeometry args={[0.74, 0.032, 8, 36]} />
