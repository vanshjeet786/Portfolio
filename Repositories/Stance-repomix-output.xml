// Low-overhead React-Three-Fiber component wrapper that handles rotation on the canvas frame
function RotatingLogoWrapper({ 
  version, 
  color, 
  scale, 
  thickness, 
  wireframe,
  autoRotate 
}: {
  version: number
  color: string
  scale: number
  thickness: number
  wireframe: boolean
  autoRotate: boolean
}) {
  const meshRef = useRef<THREE.Group>(null!)

  useFrame((state, delta) => {
    if (meshRef.current) {
      if (autoRotate) {
        // Uniform slow pivot rotation so users can review standard physical angles over time
        meshRef.current.rotation.y += delta * 0.5
      } else {
        // Slow return/drift when rotation is paused so the view doesn't look dead
        meshRef.current.rotation.y = THREE.MathUtils.lerp(meshRef.current.rotation.y, 0, 0.05)
      }
    }
  })

  return (
    <group ref={meshRef}>
      <Logo3D 
        version={version}
        color={color}
        scale={scale}
        thickness={thickness}
        wireframe={wireframe}
      />
    </group>
  )
}
