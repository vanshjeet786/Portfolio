function PowerPlateForce({ calibrating }: { calibrating: boolean }) {
  const leftRef = useRef<THREE.Mesh>(null!)
  const rightRef = useRef<THREE.Mesh>(null!)
  const leftHeight = useRef(0.85)
  const rightHeight = useRef(0.42)

  useFrame((state) => {
    const t = state.clock.getElapsedTime()
    if (calibrating) {
      // Return to symmetry alignment (balanced muscular firing)
      leftHeight.current = THREE.MathUtils.lerp(leftHeight.current, 0.92 + Math.sin(t * 8) * 0.03, 0.08)
      rightHeight.current = THREE.MathUtils.lerp(rightHeight.current, 0.92 + Math.cos(t * 8) * 0.03, 0.08)
    } else {
      // Subconscious guarding compensation (e.g. leaning heavily to one leg)
      leftHeight.current = THREE.MathUtils.lerp(leftHeight.current, 1.35 + Math.sin(t * 2.5) * 0.02, 0.08)
      rightHeight.current = THREE.MathUtils.lerp(rightHeight.current, 0.45 + Math.cos(t * 1.8) * 0.02, 0.08)
    }

    if (leftRef.current) {
      leftRef.current.scale.set(1, leftHeight.current, 1)
      leftRef.current.position.set(-0.56, -0.9 + leftHeight.current / 2, 0)
    }
    if (rightRef.current) {
      rightRef.current.scale.set(1, rightHeight.current, 1)
      rightRef.current.position.set(0.56, -0.9 + rightHeight.current / 2, 0)
    }
  })

  return (
    <group scale={[1.15, 1.15, 1.15]} position={[0, -0.1, 0]}>
      {/* Left Force Vector Column - Lime representing correct weight-bearing */}
      <mesh ref={leftRef}>
        <boxGeometry args={[0.38, 1, 0.38]} />
        <meshStandardMaterial 
          color="#ddfe71" 
          emissive="#243b00" 
          roughness={0.15}
          metalness={0.9}
        />
      </mesh>

      {/* Right Force Vector Column - Red representing injury protection deficit */}
      <mesh ref={rightRef}>
        <boxGeometry args={[0.38, 1, 0.38]} />
        <meshStandardMaterial 
          color={calibrating ? "#ddfe71" : "#ef4444"} 
          emissive={calibrating ? "#243b00" : "#4a0101"} 
          roughness={0.15}
          metalness={0.9}
        />
      </mesh>
      
      {/* Dual Synchronized High-Speed Force Plates */}
      <mesh position={[0, -0.95, 0]}>
        <boxGeometry args={[1.9, 0.12, 0.82]} />
        <meshStandardMaterial color="#334155" metalness={0.95} roughness={0.05} />
      </mesh>
    </group>
  )
}

