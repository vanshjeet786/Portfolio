export default function AclTearLabPage() {
  const containerRef = useRef<HTMLDivElement>(null!);
  const [useHighDPR, setUseHighDPR] = useState(true);
  const [manualProgress, setManualProgress] = useState<number | null>(null);

  // Hook connecting the scroll container with GSAP ScrollTrigger
  const { currentSectionIndex, scrollProgressRef } = useScrollTimeline(containerRef);

  // Track state for high-frequency canvas parameter reads
  const [activeProgress, setActiveProgress] = useState(0);

  // Keep a local high-frequency React state to drive HTML graphs 
  // with smooth interpolation (slightly throttled/updated via requestAnimationFrame)
  useEffect(() => {
    let active = true;
    const updateLoop = () => {
      if (!active) return;
      
      const currentVal = manualProgress !== null ? manualProgress : scrollProgressRef.current;
      setActiveProgress((prev) => {
        // Soft dampening/interpolation
        const diff = currentVal - prev;
        if (Math.abs(diff) < 0.005) return currentVal;
        return prev + diff * 0.15;
      });
      
      requestAnimationFrame(updateLoop);
    };
    
    updateLoop();
    return () => {
      active = false;
    };
  }, [manualProgress]);

  // Compute live biomedical diagnostic telemetry values based on activeProgress (0 to 4)
  const getTelemetryData = () => {
    let jointStability = 100;
    let anteriorShear = 18; // lbs of load
    let kneeFlexionAngle = 0; // degrees
    let emgActivity = 14; // microvolts
    let stateLabel = "NORMAL REST";
    let warningLevel: "nominal" | "highlight" | "danger" | "recovery" = "nominal";

    if (activeProgress < 1.0) {
      // Phase 1: Intro
      const t = activeProgress;
      jointStability = 100;
      anteriorShear = Math.round(18 + t * 4);
      kneeFlexionAngle = 0;
      emgActivity = Math.round(14 + t * 6);
      stateLabel = "STATIC BASELINE";
      warningLevel = "nominal";
    } else if (activeProgress < 2.0) {
      // Phase 2: Highlight
      const t = activeProgress - 1.0;
      jointStability = 100;
      anteriorShear = 22;
      kneeFlexionAngle = 0;
      emgActivity = Math.round(20 + t * 15);
      stateLabel = "CAPSULE MAPPING";
      warningLevel = "highlight";
    } else if (activeProgress < 3.0) {
      // Phase 3: Flexion Movement
      const t = activeProgress - 2.0;
      jointStability = 100;
      anteriorShear = Math.round(22 + t * 45); // Shear rises as knee flexes
      kneeFlexionAngle = Math.round(t * 25); // flexes up to 25 degrees
      emgActivity = Math.round(35 + t * 50); // muscle activation increases
      stateLabel = "ACTIVE FLEXION";
      warningLevel = "nominal";
    } else if (activeProgress < 4.0) {
      // Phase 4: Tear
      const t = activeProgress - 3.0;
      jointStability = Math.round(100 - t * 88); // stability drops to 12%
      anteriorShear = Math.round(67 - t * 50); // shear drops because joint loses tension integrity
      kneeFlexionAngle = Math.round(25 * (1 - t)); // returns to flat extension
      emgActivity = Math.round(85 - t * 50); // muscle guarding fires, then stabilizes
      stateLabel = "ACL TEAR DEFICIT";
      warningLevel = "danger";
    } else {
      // Phase 5: Recovery
      const t = Math.min(1.0, activeProgress - 4.0);
      jointStability = Math.round(12 + t * 58); // stability climbs back to 70% via rehab muscles
      anteriorShear = Math.round(17 + t * 8);
      kneeFlexionAngle = 0;
      emgActivity = Math.round(35 + t * 25); // stable baseline rehab recruitment
      stateLabel = "REHAB CALIBRATION";
      warningLevel = "recovery";
    }

    return {
      jointStability,
      anteriorShear,
      kneeFlexionAngle,
      emgActivity,
      stateLabel,
      warningLevel
    };
  };

  const telemetry = getTelemetryData();

  return (
    <div className="min-h-screen bg-[#cce3e3] text-[#122b2d] font-sans overflow-x-hidden selection:bg-[#122b2d] selection:text-white relative">
      
      {/* Background soft teal-gradient elements */}
      <div className="fixed inset-0 pointer-events-none z-0 bg-gradient-to-b from-[#e5f5f5] via-[#cce3e3] to-[#b3d4d4]" />

      {/* Grid Pattern Overlay simulating clinical graph blueprint */}
      <div className="fixed inset-0 pointer-events-none z-0 opacity-20">
        <div className="w-full h-full border border-teal-800/5 grid grid-cols-12 grid-rows-12">
          {Array.from({ length: 144 }).map((_, i) => (
            <div key={i} className="border-[0.5px] border-teal-800/10" />
          ))}
        </div>
      </div>

      {/* Main HUD Header Navigation */}
      <Navigation />

      {/* Main scrollytelling container */}
      <div ref={containerRef} className="relative z-10 w-full min-h-[500vh]">
        
        {/* Sticky 3D WebGL Canvas Viewport Pane */}
        <div className="sticky top-0 h-screen w-full flex flex-col justify-between overflow-hidden pointer-events-none">
          
          {/* TOP HEADER RAIL */}
          <div className="w-full pt-28 px-4 md:px-12 max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4 pointer-events-auto">
            {/* Left navigation */}
            <div className="flex flex-col gap-1.5">
              <div className="flex items-center gap-3">
                <Link 
                  href="/logo-lab" 
                  className="flex items-center gap-1.5 hover:text-teal-800 text-xs font-mono uppercase tracking-widest text-[#122b2d]/60 transition-colors"
                >
                  <ArrowLeft size={13} /> Return to Logo Lab
                </Link>
                <span className="text-zinc-400 font-mono text-xs">|</span>
                <span className="text-xs font-mono uppercase tracking-widest text-teal-800 font-bold">
                  Knee Joint Clinic
                </span>
              </div>
              <h1 className="text-xl md:text-3xl font-unbounded tracking-tighter uppercase font-black text-[#0f2425]">
                3D ACL <span className="text-teal-600">STORYTELLING</span>
              </h1>
            </div>

            {/* Premium Lab Toggles (Logo Lab vs ACL Lab switcher tabs) */}
            <div className="flex bg-[#122b2d]/10 p-1.5 border border-[#122b2d]/10 sharp-border self-start md:self-auto shadow-sm">
              <Link
                href="/logo-lab"
                className="px-4 py-2 font-mono text-[10px] uppercase font-bold text-[#122b2d]/70 hover:text-[#122b2d] transition-all"
              >
                3D Brand Logo Lab
              </Link>
              <div className="px-4 py-2 bg-[#122b2d] font-mono text-[10px] uppercase font-bold text-[#ddfe71] shadow-md flex items-center gap-1.5">
                <span className="w-1.5 h-1.5 rounded-full bg-[#ddfe71] animate-pulse" />
                3D Clinical ACL Lab
              </div>
            </div>
          </div>

          {/* MAIN THREEJS VISUALIZER AREA (Full Screen Centered Background behind text) */}
          <div className="absolute inset-0 z-0 flex items-center justify-start pointer-events-auto select-none">
            <div className="w-full lg:w-3/5 h-[65vh] lg:h-[80vh] relative mt-16 md:mt-24 lg:ml-8">
              <ClientOnly>
                <Canvas shadows camera={{ position: [0, 0, 4.2], fov: 45 }}>
                  {/* Studio lighting parameters */}
                  <SceneLighting />

                  {/* Cinematic smooth camera interpolation controller */}
                  <CameraController scrollProgress={activeProgress} />

                  {/* High fidelity interactive knee bones & ACL */}
                  <KneeModel scrollProgress={activeProgress} />
                </Canvas>
              </ClientOnly>

              {/* Interactive Rotation indicator on the canvas */}
              <div className="absolute bottom-6 left-6 font-mono text-[9px] uppercase tracking-wider text-[#122b2d]/50 flex items-center gap-2">
                <RotateCw size={11} className="animate-spin text-teal-600" style={{ animationDuration: "12s" }} />
                <span>Cinematic Orbit Synchronized to Scroll</span>
              </div>
            </div>
          </div>

          {/* REAL-TIME BIOMECHANICAL HUD PANEL (Floating Bottom Overlays) */}
          <div className="w-full pb-8 px-4 md:px-12 max-w-7xl mx-auto z-10 flex flex-col lg:flex-row lg:items-end justify-between gap-6 pointer-events-auto">
            
            {/* Telemetry diagnostics cards */}
