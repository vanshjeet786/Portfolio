<file path="components/acl/ScrollSections.tsx">
import React from "react";
import { SECTIONS, SectionConfig, VISUAL_COLORS } from "./lib/animationConfig";
import { BookOpen, Shield, HeartPulse, ShieldAlert, Sparkles } from "lucide-react";

interface ScrollSectionsProps {
  currentSectionIndex: number;
  scrollProgress: number;
}

export function ScrollSections({ currentSectionIndex, scrollProgress }: ScrollSectionsProps) {
  // Return icon based on step
  const getSectionIcon = (id: number) => {
    switch (id) {
      case 1:
        return <BookOpen size={16} className="text-teal-400" />;
      case 2:
        return <Sparkles size={16} className="text-teal-300" />;
      case 3:
        return <Shield size={16} className="text-emerald-400" />;
      case 4:
        return <ShieldAlert size={16} className="text-rose-400" />;
      case 5:
        return <HeartPulse size={16} className="text-teal-300 animate-pulse" />;
      default:
        return <BookOpen size={16} className="text-teal-400" />;
    }
  };

  return (
    <div className="w-full flex flex-col items-center">
      {SECTIONS.map((section, idx) => {
        const isActive = idx === currentSectionIndex;
        
        // Calculate a local progress/opacity for this section card to enable soft fades
        // each section covers roughly 1.0 span in scrollProgress (0 to 1, 1 to 2, etc.)
        const localDist = Math.abs(scrollProgress - idx);
        const cardOpacity = Math.max(0.15, 1.0 - localDist * 1.5);

        return (
          <section
            key={section.id}
            id={`acl-section-${section.slug}`}
            className="w-full min-h-screen flex items-center justify-end px-4 md:px-12 lg:px-20 py-24 select-none outline-none relative"
            aria-label={`Step ${section.id}: ${section.headline}`}
            style={{ opacity: cardOpacity, transition: "opacity 0.2s ease-out" }}
          >
            {/* Left border accent line linked to active status */}
            <div className="w-full max-w-lg bg-[#0e161b]/80 backdrop-blur-md border border-[#1e3436]/50 p-6 md:p-8 shadow-2xl relative flex flex-col justify-between overflow-hidden">
              {/* Highlight top bar */}
              <div 
                className={`absolute top-0 left-0 right-0 h-1 transition-all duration-500 ${
                  isActive 
                    ? section.id === 4 
                      ? "bg-rose-500" 
                      : section.id === 3
                        ? "bg-emerald-400"
                        : "bg-teal-400" 
                    : "bg-zinc-700/30"
                }`} 
              />

              {/* Header Label / Progress Indicators */}
              <div className="flex items-center justify-between font-mono text-[10px] uppercase tracking-wider text-teal-300/80 mb-4">
                <span className="flex items-center gap-1.5 font-bold">
                  {getSectionIcon(section.id)}
                  Phase 0{section.id}
                </span>
                <span className="font-semibold text-zinc-400">
                  {section.slug.toUpperCase()}
                </span>
              </div>

              {/* Main Headline */}
              <h2 className="text-xl md:text-2xl font-unbounded tracking-tight uppercase text-white mb-2 leading-snug">
                {section.headline}
              </h2>
              <p className="text-xs font-mono font-bold text-teal-400 uppercase tracking-widest mb-4">
                {section.subheadline}
              </p>

              {/* Main Explanatory Paragraph */}
              <p className="text-xs md:text-sm text-zinc-300 leading-relaxed font-sans mb-6">
                {section.description}
              </p>

              {/* Somatic Educational Target box */}
              <div className="bg-[#0b1014] border border-[#16272a] p-3.5 space-y-2 mb-4">
                <div className="text-[9px] font-mono font-extrabold uppercase text-teal-300/60 tracking-wider flex items-center gap-1.5">
                  <span className="w-1.5 h-1.5 rounded-full bg-teal-400" />
                  Educational Landmark
                </div>
                <p className="text-[11px] text-zinc-400 leading-normal font-sans">
                  {section.educationalGoal}
                </p>
              </div>

              {/* Orthopedic clinical notes */}
              <div className="flex justify-between items-baseline font-mono text-[9px] text-zinc-500 uppercase border-t border-[#1a2d30] pt-3">
                <span>Clinical Index:</span>
                <span className="text-teal-400/90 font-bold">{section.clinicalNote}</span>
              </div>
            </div>
          </section>
        );
      })}
    </div>
  );
}

export default ScrollSections;
</file>

