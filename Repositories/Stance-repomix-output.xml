              <span>Pelvic Region</span>
              <span className={hoveredPart.key === 'muscle_hammock' && scrollProgressRef.current > 0.5 ? 'text-lime animate-pulse font-bold' : ''}>
                {hoveredPart.key === 'muscle_hammock' && scrollProgressRef.current > 0.5 ? 'Neuromuscular Active' : 'Spasm State'}
              </span>
