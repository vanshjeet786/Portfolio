        points={[[-0.5, -0.5, 0], [-0.3, 0.2, 0], [0, 0.5, 0], [0.3, -0.2, 0], [0.5, -0.5, 0]]}
        color="#ddfe71"
        lineWidth={2}
      />
    </group>
  )
}
