<file path="components/three/gsap/JointModel.tsx">
"use client"
import React, { useRef, useState, useEffect } from 'react'
import { useFrame } from '@react-three/fiber'
import { Html } from '@react-three/drei'
import * as THREE from 'three'
import gsap from 'gsap'
import { ScrollTrigger } from 'gsap/ScrollTrigger'

gsap.registerPlugin(ScrollTrigger)

interface JointModelProps {
  isVisible?: boolean
  isDark?: boolean
}

export function JointModel({ isVisible = true, isDark = true }: JointModelProps) {
  const groupRef = useRef<THREE.Group>(null!)
  const topBoneRef = useRef<THREE.Mesh>(null!)
  const bottomBoneRef = useRef<THREE.Mesh>(null!)
  const jointCapsuleRef = useRef<THREE.Mesh>(null!)
  const jointMaterialRef = useRef<any>(null!)
  
  const scrollProgressRef = useRef(0)
  const [hoveredPart, setHoveredPart] = useState<{ name: string; desc: string; pos: [number, number, number]; key: string } | null>(null)

  // Drag and rotate tracking refs
  const isDragging = useRef(false)
  const previousPointerPosition = useRef({ x: 0, y: 0 })
  const targetRotation = useRef({ x: 0, y: 0 })
  const currentRotation = useRef({ x: 0, y: 0 })

  const handlePointerDown = (e: any) => {
    e.stopPropagation()
    if (e.target) {
      try {
        (e.target as HTMLElement).setPointerCapture(e.pointerId)
      } catch (err) {}
    }
    isDragging.current = true
    previousPointerPosition.current = { x: e.clientX, y: e.clientY }
  }

  const handlePointerMove = (e: any) => {
    if (!isDragging.current) return
    e.stopPropagation()
    const deltaX = e.clientX - previousPointerPosition.current.x
    const deltaY = e.clientY - previousPointerPosition.current.y
    previousPointerPosition.current = { x: e.clientX, y: e.clientY }

    // Update target rotation
    targetRotation.current.y += deltaX * 0.015
    targetRotation.current.x += deltaY * 0.015
  }

  const handlePointerUp = (e: any) => {
    e.stopPropagation()
    isDragging.current = false
    if (e.target) {
      try {
        (e.target as HTMLElement).releasePointerCapture(e.pointerId)
      } catch (err) {}
    }
  }

  useEffect(() => {
    if (!isVisible) return

    // Force a ScrollTrigger calculation update on mount
    setTimeout(() => {
      ScrollTrigger.refresh();
    }, 100);

    const ctx = gsap.context(() => {
      const mainEl = document.getElementById("concept-layout-main") || document.querySelector("main") || document.body;
      const progressTracker = { val: 0 };

      gsap.to(progressTracker, {
        val: 1,
        ease: "none",
        scrollTrigger: {
          trigger: mainEl,
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
          invalidateOnRefresh: true,
        },
        onUpdate: () => {
          const p = progressTracker.val;
          scrollProgressRef.current = p;
        }
      })
    })

    return () => {
      ctx.revert();
      ScrollTrigger.refresh();
    }
  }, [isVisible])

  useFrame((state) => {
    const p = scrollProgressRef.current;
    
    // Interpolating drag rotation smoothly
    currentRotation.current.x += (targetRotation.current.x - currentRotation.current.x) * 0.08
    currentRotation.current.y += (targetRotation.current.y - currentRotation.current.y) * 0.08

    if (groupRef.current) {
       // Absolute positioning prevents additive drift zoom issue
       groupRef.current.position.set(1.5, Math.sin(state.clock.elapsedTime) * 0.05, 0);

       // Rotation: scroll progress + drag offset values
       groupRef.current.rotation.y = p * Math.PI * 4 + currentRotation.current.y;
       groupRef.current.rotation.x = currentRotation.current.x;
       groupRef.current.rotation.z = p * Math.PI * 0.25;
    }

    const topBone = topBoneRef.current;
    const bottomBone = bottomBoneRef.current;

    if (topBone) topBone.position.y = 0.8 + (p * 1.5);
    if (bottomBone) bottomBone.position.y = -0.8 - (p * 1.5);
    
    const jointCapsule = jointCapsuleRef.current;
    if (jointCapsule) {
       const healedFactor = Math.max(0, (p - 0.5) * 2); // 0 to 1
       const baseScale = 1 + (p * 1.5);
       
       // High-frequency muscular feedback pulse when healed (volt lime color)
       const pulse = 1 + Math.sin(state.clock.elapsedTime * 8) * 0.06 * healedFactor;
       jointCapsule.scale.set(baseScale * pulse, baseScale * pulse, baseScale * pulse);

       if (jointCapsule.material) {
            const mat = (Array.isArray(jointCapsule.material) ? jointCapsule.material[0] : jointCapsule.material) as any;
            if (mat && mat.color) {
               // #fe7833 (Active Coral) -> #ddfe71 (Volt Lime)
               const r = THREE.MathUtils.lerp(0.996, 0.866, Math.min(p * 2, 1));
               const g = THREE.MathUtils.lerp(0.470, 0.996, Math.min(p * 2, 1));
               const b = THREE.MathUtils.lerp(0.200, 0.443, Math.min(p * 2, 1));
               mat.color.setRGB(r, g, b);
            }
       }
    }
  });

  if (!isVisible) return null

  return (
    <group 
      ref={groupRef} 
      scale={[1.2, 1.2, 1.2]} 
      position={[1.5, 0, 0]}
      onPointerDown={handlePointerDown}
      onPointerMove={handlePointerMove}
      onPointerUp={handlePointerUp}
    >
      {/* Top Bone */}
      <mesh 
        ref={topBoneRef} 
        position={[0, 0.8, 0]}
        onPointerOver={(e) => {
          e.stopPropagation();
          setHoveredPart({
            key: 'femur_epiphysis',
            name: "Distal Femur",
            desc: "The lower femur bone articulating with the lower joints to pivot limb movement.",
            pos: [0, 1.0, 0]
          });
          document.body.style.cursor = 'pointer';
        }}
        onPointerOut={() => {
          setHoveredPart(null);
          document.body.style.cursor = 'auto';
        }}
        scale={hoveredPart?.key === 'femur_epiphysis' ? [1.1, 1.0, 1.1] : [1, 1, 1]}
      >
        <cylinderGeometry args={[0.2, 0.15, 1.2, 16]} />
        <meshStandardMaterial
            color="#addcec"
            roughness={0.2}
            metalness={0.7}
            transparent={true}
            opacity={0.85}
            wireframe={true}
        />
      </mesh>

      {/* Bottom Bone */}
      <mesh 
        ref={bottomBoneRef} 
        position={[0, -0.8, 0]}
        onPointerOver={(e) => {
          e.stopPropagation();
          setHoveredPart({
            key: 'tibial_plateau',
            name: "Tibial Plateau",
            desc: "The shinbone base section bearing the rotational load during lateral dynamic cutting.",
            pos: [0, -1.0, 0]
          });
          document.body.style.cursor = 'pointer';
        }}
        onPointerOut={() => {
          setHoveredPart(null);
          document.body.style.cursor = 'auto';
        }}
        scale={hoveredPart?.key === 'tibial_plateau' ? [1.1, 1.0, 1.1] : [1, 1, 1]}
      >
        <cylinderGeometry args={[0.15, 0.2, 1.2, 16]} />
        <meshStandardMaterial
            color="#addcec"
            roughness={0.2}
            metalness={0.7}
            transparent={true}
            opacity={0.85}
            wireframe={true}
        />
      </mesh>

      {/* Joint Capsule (Injury Point) */}
      <mesh 
        ref={jointCapsuleRef} 
        position={[0, 0, 0]}
        onPointerOver={(e) => {
          e.stopPropagation();
          setHoveredPart({
            key: 'capsule',
            name: "Synovial Capsule",
            desc: "Fluid-filled protective envelope. Restored state indicates active alignment calibration and zero shear strain.",
            pos: [0, 0, 0.15]
          });
          document.body.style.cursor = 'pointer';
        }}
        onPointerOut={() => {
          setHoveredPart(null);
          document.body.style.cursor = 'auto';
        }}
      >
        <sphereGeometry args={[0.3, 32, 32]} />
        <meshStandardMaterial
            ref={jointMaterialRef}
            color="#fe7833"
            roughness={0.2}
            metalness={0.7}
            transparent={true}
            opacity={0.85}
            wireframe={true}
        />
      </mesh>

      {/* Tooltip HTML Overlay Render */}
      {hoveredPart && (
        <Html
          position={hoveredPart.pos}
          center
          distanceFactor={5}
          pointerEvents="none"
        >
          <div className={`whitespace-nowrap px-4 py-3 rounded-none border font-mono backdrop-blur-md transition-all duration-300 shadow-[0_10px_30px_rgba(0,0,0,0.5)] ${
            isDark
              ? 'bg-neutral-950/95 border-lime/35 text-white' 
              : 'bg-white/95 border-[#132644]/40 text-[#132644]'
          }`} style={{ minWidth: '220px', transform: 'translateY(-60px)' }}>
            <div className={`text-xs font-black font-unbounded uppercase tracking-tight ${isDark ? 'text-lime' : 'text-[#fe7833]'}`}>
              {hoveredPart.name}
            </div>
            <div className="text-[10px] mt-1.5 whitespace-normal leading-relaxed opacity-85 select-none font-sans">
              {hoveredPart.desc}
            </div>
            <div className={`text-[8.5px] mt-2 border-t pt-1.5 flex justify-between uppercase tracking-widest font-bold opacity-60 ${isDark ? 'border-lime/10' : 'border-[#132644]/10'}`}>
              <span>Joint Capsule</span>
              <span className={hoveredPart.key === 'capsule' && scrollProgressRef.current > 0.5 ? 'text-lime animate-pulse font-bold' : ''}>
                {hoveredPart.key === 'capsule' && scrollProgressRef.current > 0.5 ? 'Fully Synced' : 'High Shear Strain'}
              </span>
            </div>
          </div>
        </Html>
      )}
    </group>
  )
}
</file>

