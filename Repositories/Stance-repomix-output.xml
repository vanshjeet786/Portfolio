"use client"
import React, { Suspense } from 'react'
import { Canvas } from '@react-three/fiber'
import { PerspectiveCamera, Environment, Float, ScrollControls } from '@react-three/drei'
import { Anatomy } from './Anatomy'
import { ValdTech } from './ValdTech'
import { ClientOnly } from '../ClientOnlyCanvas'
import { SpineModel, JointModel, KneeModel, PelvicModel } from './gsap'

interface ConceptSceneProps {
  concept: string;
  part?: string;
  type?: 'background' | 'inline';
  isExploded?: boolean;
  severity?: number;
}

function SafeCanvas({ children, ...props }: any) {
  return (
    <Canvas {...props} eventSource={typeof window !== 'undefined' ? document.getElementById('root') || document.body : undefined}>
      {children}
    </Canvas>
  )
}

export function ConceptScene({ concept, part = 'body', type = 'background', isExploded = false, severity = 0.55 }: ConceptSceneProps) {
  const conceptMap: Record<string, number> = {
    'championship': 2,
    'blueprint': 3,
    'bio-scanner': 4,
    'kinetic-flow': 1,
    'neo-human': 5
  }

  const conceptId = conceptMap[concept] || 5;
  const isDark = concept === 'championship' || concept === 'bio-scanner' || concept === 'neo-human';
  const isGsapPage = part === 'back' || part === 'sports' || part === 'knee' || part === 'womens' || part === 'pelvis' || part === 'spine';

  return (
    <div className={`${type === 'background' ? 'fixed inset-0 z-0' : 'w-full h-full relative min-h-[400px]'} pointer-events-none`}>
      <ClientOnly>
      <SafeCanvas shadows dpr={[1, 2]}>
        <PerspectiveCamera makeDefault position={[0, 0, 5]} fov={50} />

        {concept === 'championship' && (
          <>
            <spotLight position={[10, 10, 10]} angle={0.15} penumbra={1} intensity={3} color="#cff065" />
            <pointLight position={[-10, -5, 2]} intensity={2} color="#ffb595" />
          </>
        )}

        {concept === 'bio-scanner' && (
          <>
            <rectAreaLight width={10} height={10} intensity={5} position={[0, 5, 0]} color="#ddfe71" />
            <gridHelper args={[20, 20, 0xddfe71, 0x222222]} position={[0, -2, 0]} />
          </>
        )}

        <ambientLight intensity={isDark ? 0.2 : 0.5} />
        <Environment preset={isDark ? "night" : (concept === 'kinetic-flow' ? "sunset" : "city")} />

        <Suspense fallback={null}>
          {isGsapPage ? (
             <Float speed={1.5} rotationIntensity={0.5} floatIntensity={0.5}>
               <SpineModel isVisible={part === 'back' || part === 'spine'} isExploded={isExploded} isDark={isDark} severity={severity} />
               <JointModel isVisible={part === 'sports'} isDark={isDark} />
               <KneeModel isVisible={part === 'knee'} isDark={isDark} />
               <PelvicModel isVisible={part === 'womens' || part === 'pelvis'} isDark={isDark} />
             </Float>
          ) : (
             <ScrollControls pages={3} damping={0.1}>
                <Float
                  speed={concept === 'kinetic-flow' ? 3 : 2}
                  rotationIntensity={concept === 'kinetic-flow' ? 2 : 0.5}
                  floatIntensity={concept === 'kinetic-flow' ? 2 : 0.5}
                >
                  <Anatomy concept={conceptId} part={part} />
                </Float>
                <ValdTech active={concept === 'championship' || concept === 'bio-scanner'} />
             </ScrollControls>
          )}
        </Suspense>
      </SafeCanvas>
      </ClientOnly>
    </div>
  )
}
