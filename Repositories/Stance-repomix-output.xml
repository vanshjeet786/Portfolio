import { useEffect, useState, useRef } from "react";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

export function useScrollTimeline(containerRef: React.RefObject<HTMLDivElement>) {
  const [currentSectionIndex, setCurrentSectionIndex] = useState(0);
  const scrollProgressRef = useRef(0); // 0.0 to 4.0 matching our sections

  useEffect(() => {
    const element = containerRef.current;
    if (!element) return;

    // Force recalculating triggers on mount
    setTimeout(() => {
      ScrollTrigger.refresh();
    }, 150);

    const ctx = gsap.context(() => {
      const tracker = { progress: 0 };

      // Bind the GSAP timeline with ScrollTrigger
      ScrollTrigger.create({
        trigger: element,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.5, // Subtle dampening for premium feel
        onUpdate: (self) => {
          // Map scroll progress (0 to 1) into a 0.0 to 4.0 range for the 5 chapters
          const mappedProgress = self.progress * 4;
          scrollProgressRef.current = mappedProgress;

          // Determine current step index
          const activeIndex = Math.min(
            4,
            Math.max(0, Math.floor(mappedProgress + 0.35)) // Offset by 0.35 to ease transition points
          );
          
          setCurrentSectionIndex((prev) => {
            if (prev !== activeIndex) {
              return activeIndex;
            }
            return prev;
          });
        }
      });
    });

    return () => {
      ctx.revert();
      ScrollTrigger.refresh();
    };
  }, [containerRef]);

  return {
    currentSectionIndex,
    scrollProgressRef,
  };
}

export default useScrollTimeline;
